+    @field_validator("draft_num_tokens_by_batch")
+    @classmethod
+    def validate_draft_num_tokens_by_batch(cls, rules):
+        # Reject ambiguous or reordered ceilings instead of silently changing the policy
+        if rules is not None and any(a[0] >= b[0] for a, b in zip(rules, rules[1:])):
+            raise ValueError("draft_num_tokens_by_batch limits must be strictly increasing")
+        return rules
