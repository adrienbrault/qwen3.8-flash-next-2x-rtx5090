From cf8cfe5409dbfd34fcd3cd828332f5b7605f737e Mon Sep 17 00:00:00 2001
From: creslinux <34645187+creslinux@users.noreply.github.com>
Date: Thu, 10 Sep 2026 00:14:15 -0700
Subject: [PATCH] Layer-split forward: keep the current CUDA device on the
 module's device

Nothing sets the process-wide CUDA current device during a layer-split
forward: prepare_for_device moves the tensor, and stock ext host wrappers
self-guard on the tensor's device, so stock code is correct only because
every entry point remembers to guard. An unguarded eager launch then runs on
cuda:0 against foreign tensors -- silently over P2P on peer pairs, an illegal
access on non-peer pairs that surfaces asynchronously at whatever kernel
checks errors next. Found via an out-of-tree kernel whose load-time fault was
misattributed to autotune for days.

Modules are device-contiguous, so a small _LSDeviceContext tracks the device
across the loop at one exchange per transition plus one restore, applied to
both forward_ls and prefill_ls.

Revised after review:
- Restore goes through torch.cuda._exchange_device on the first transition
  and torch.cuda._maybe_exchange_device in the finally block -- the pair
  torch.cuda.device itself uses -- so restoring never creates a context on a
  device the model does not use. torch.cuda.set_device(0) on exit would give
  a -gs 0,24,24 process a ~500 MB context on an idle cuda:0.
- Device indices are compared as ints throughout; the previous version
  compared a torch.device with an int.
- prefill_ls gets the same treatment as forward_ls.

Verified on 4x RTX 3090, uneven split [16,22,22,22]: coherent generation, no
errors, caller's current device restored after the forward; unit check that
the helper tracks cuda:1 -> cuda:3 -> cuda:2 -> restore to cuda:1 and ignores
cpu/None modules.
---
 exllamav3/model/model_ls.py | 76 ++++++++++++++++++++++++++++++-------
 1 file changed, 62 insertions(+), 14 deletions(-)

diff --git a/exllamav3/model/model_ls.py b/exllamav3/model/model_ls.py
index ee1415999..31f881b67 100644
--- a/exllamav3/model/model_ls.py
+++ b/exllamav3/model/model_ls.py
@@ -15,6 +15,44 @@
 from abc import ABC, abstractmethod
 
 
+
+class _LSDeviceContext:
+    """
+    Keeps the process-wide CUDA current device on the module's device across a layer-split module
+    loop. Nothing else sets it: prepare_for_device moves the tensor, and stock ext host wrappers
+    self-guard on the tensor's device, so stock code is correct only because every entry point
+    remembers to. An unguarded eager launch (extension code, a capture helper, a new kernel) then
+    runs on cuda:0 against foreign tensors -- silently over P2P on peer pairs, an illegal access
+    on non-peer pairs that surfaces at whatever kernel checks errors next.
+
+    Modules are device-contiguous, so this costs one exchange per device transition plus one
+    restore. It uses the _exchange_device / _maybe_exchange_device pair that torch.cuda.device
+    itself uses: the restore never creates a context on a device that had none, so a process whose
+    model skips cuda:0 (e.g. -gs 0,24,24) does not gain a ~500 MB context there on the way out,
+    which torch.cuda.set_device(0) would.
+    """
+    __slots__ = ("prev", "cur")
+
+    def __init__(self):
+        self.prev = -1
+        self.cur = -1
+
+    def enter(self, device):
+        if device is None or getattr(device, "type", None) != "cuda":
+            return
+        idx = device.index if device.index is not None else torch.cuda.current_device()
+        if idx == self.cur:
+            return
+        prev = torch.cuda._exchange_device(idx)
+        if self.cur == -1:
+            self.prev = prev
+        self.cur = idx
+
+    def restore(self):
+        if self.cur != -1:
+            torch.cuda._maybe_exchange_device(self.prev)
+            self.cur = -1
+
 class Model_LSMixin(ABC):
 
     def __init__(self):
@@ -279,14 +317,19 @@ def prefill_ls(
     ):
         for h in getattr(self.config, "moe_cpu_hosts", {}).values():
             h.begin_pass()
-        for module, instance, idx in self.fwd_modules:
-            params["layer_instance"] = instance
-            pf = (idx, instance) == self.last_kv_module_idx_instance
-            params["prefill"] = pf
-            x = module.prepare_for_device(x, params)
-            x = module.forward(x, params)
-            if pf:
-                break
+        ctx = _LSDeviceContext()
+        try:
+            for module, instance, idx in self.fwd_modules:
+                params["layer_instance"] = instance
+                pf = (idx, instance) == self.last_kv_module_idx_instance
+                params["prefill"] = pf
+                ctx.enter(module.device)
+                x = module.prepare_for_device(x, params)
+                x = module.forward(x, params)
+                if pf:
+                    break
+        finally:
+            ctx.restore()
         del params["prefill"]
         return None
 
@@ -298,11 +341,16 @@ def forward_ls(
     ):
         for h in getattr(self.config, "moe_cpu_hosts", {}).values():
             h.begin_pass()
-        for module, instance, idx in self.fwd_modules:
-            params["layer_instance"] = instance
-            if module.caps.get("logits_output") and (num := params.get("last_tokens_only")):
-                x = x[..., -num:, :].contiguous()
-            x = module.prepare_for_device(x, params)
-            x = module.forward(x, params)
+        ctx = _LSDeviceContext()
+        try:
+            for module, instance, idx in self.fwd_modules:
+                params["layer_instance"] = instance
+                if module.caps.get("logits_output") and (num := params.get("last_tokens_only")):
+                    x = x[..., -num:, :].contiguous()
+                ctx.enter(module.device)
+                x = module.prepare_for_device(x, params)
+                x = module.forward(x, params)
+        finally:
+            ctx.restore()
         return x
 
