+// main branch's GEMMs, so it must not share their tile locks (libtorch/lc_fork.h)
+static thread_local int lc_gemm_locks_offset = 0;
+
+void exl3_gemm_set_locks_offset(int offset)
+{
+    lc_gemm_locks_offset = offset;
+}
+
