+            void* v2_kernel = dense_v2_launch_gemm(kernelArgs, v2_key, size_m, size_k, size_n, K, cb, c_fp32,
+                                                   device, stream, &v2_tag);
+            if (v2_kernel)
+            {
+                add_graph_args(v2_kernel);
+                cuda_check(cudaPeekAtLastError());
+                return v2_tag;
+            }
+        }
+
@@ -761,0 +798,21 @@ int exl3_mgemm_gr
+        // densegemm r1: V2 twin for dense calls (no indices / weights / range filter, one token)
+        if (!half_k && !indices && !weights && min_index < 0 && num_tokens == 1 && (dense_v2_mode() != 0 || dense_v2_rows32()))
+        {
+            int v2_tag = 0;
+            // rebase165: served 16-row bucket for > 16 rows (see exl3_gemm_gr, upstream 3bbc7777)
+            uint64_t v2_key = autotune_key;
+            if (size_m > 16)
+            {
+                v2_key = mgemm_autotune_hash(16, size_k, size_n, K, c_fp32, device, cc, total_sms, cb, bszm_in, bszm_out, half_k);
+                if (had_src_list) v2_key ^= 0x9e3779b97f4a7c15ull;
+            }
+            void* v2_kernel = dense_v2_launch_mgemm(kernelArgs, v2_key, size_m, size_k, size_n, K, cb, c_fp32,
+                                                    device, stream, &v2_tag);
+            if (v2_kernel)
+            {
+                add_graph_args(v2_kernel);
