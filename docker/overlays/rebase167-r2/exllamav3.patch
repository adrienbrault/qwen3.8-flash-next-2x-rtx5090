+        if (!half_k && suh_ptr && A_had_ptr && svh_ptr && (dense_v2_mode() != 0 || dense_v2_rows32()))
+        {
+            int v2_tag = 0;
+            uint64_t v2_key = size_m > 16
+                ? gemm_autotune_hash(16, size_k, size_n, K, c_fp32, device, cc, num_sms, cb, half_k)
