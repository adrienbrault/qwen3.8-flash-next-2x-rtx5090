+        if (size_m <= 8)
+        {
+            if constexpr (TILEBLOCKS_K == 2)
+            {
+                store_small(1);
+                add_small(0);
+            }
+            if constexpr (TILEBLOCKS_K == 3)
+            {
+                store_small(1);
+                add_small(0);
+                store_small(2);
+                add_small(0);
+            }
+            if constexpr (TILEBLOCKS_K == 4)
+            {
+                store_small(3);
+                add_small(2);
+                store_small(1);
+                add_small(0);
+                store_small(2);
+                add_small(0);
+            }
+        }
+        else
+        {
+            if constexpr (TILEBLOCKS_K == 2)
+            {
+                store(1);
+                add(0);
+            }
+            if constexpr (TILEBLOCKS_K == 3)
+            {
+                store(1);
+                add(0);
+                store(2);
+                add(0);
+            }
+            if constexpr (TILEBLOCKS_K == 4)
+            {
+                store(3);
+                add(2);
+                store(1);
+                add(0);
+                store(2);
+                add(0);
+            }
+        }
+    };
+
+    // Final sums -> shared memory, fp32 (served write_sum_tile_sh)
+    auto write_sum_tile_sh = [&]() DGV2_AI
+    {
+        const int n0 = warp_id * FRAGS_N_PER_WARP;
+        #pragma unroll
+        for (int m = 0; m < TILEBLOCKS_M; ++m)
+        {
+            const int r0 = m * 16 + lane_id / 4;
+            const int r1 = r0 + 8;
+            const int c = (lane_id % 4) * 2;
+            if (r0 < size_m)
+            {
+                #pragma unroll
+                for (int n = 0; n < FRAGS_N_PER_WARP; ++n)
+                {
+                    float* c_ptr = ((float*) sh_c) + r0 * TILESIZE_N + (n0 + n) * 8 + c;
+                    *c_ptr++ = frag_c[m][n][0];
+                    *c_ptr++ = frag_c[m][n][1];
+                }
+            }
+            if (r1 < size_m)
+            {
+                #pragma unroll
+                for (int n = 0; n < FRAGS_N_PER_WARP; ++n)
+                {
+                    float* c_ptr = ((float*) sh_c) + r1 * TILESIZE_N + (n0 + n) * 8 + c;
+                    *c_ptr++ = frag_c[m][n][2];
+                    *c_ptr++ = frag_c[m][n][3];
+                }
+            }
+        }
+    };
+
+    // Final sums -> shared memory rounded to fp16 (what the served mgemm kernel writes into an
+    // fp16 C before its output transform reads it back), same rounding as its write_sum_gl
+    auto write_sum_tile_sh_h = [&]() DGV2_AI
+    {
+        const int n0 = warp_id * FRAGS_N_PER_WARP;
+        half* sh_h = (half*) sh_c;
+        #pragma unroll
+        for (int m = 0; m < TILEBLOCKS_M; ++m)
+        {
+            const int r0 = m * 16 + lane_id / 4;
+            const int r1 = r0 + 8;
+            const int c = (lane_id % 4) * 2;
+            if (r0 < size_m)
+            {
+                #pragma unroll
+                for (int n = 0; n < FRAGS_N_PER_WARP; ++n)
+                    *((half2*) (sh_h + r0 * TILESIZE_N + (n0 + n) * 8 + c)) =
+                        __floats2half2_rn(frag_c[m][n][0], frag_c[m][n][1]);
+            }
+            if (r1 < size_m)
+            {
+                #pragma unroll
+                for (int n = 0; n < FRAGS_N_PER_WARP; ++n)
+                    *((half2*) (sh_h + r1 * TILESIZE_N + (n0 + n) * 8 + c)) =
+                        __floats2half2_rn(frag_c[m][n][2], frag_c[m][n][3]);
+            }
+        }
+    };
+
+    // Output transform from shared memory to C (served output_had_sh_gl; EPI 1 with an fp16 C reads
+    // the fp16-rounded sums, as the served mgemm's had_hf pass over C does)
+    auto output_had_sh_gl = [&]() DGV2_AI
+    {
+        int sh_warp = warp_id;
+        constexpr int active_warps = EXL3_GEMM_BASE_THREADS / 32;
+        for (;; sh_warp += active_warps)
+        {
+            int col = sh_warp % (TILESIZE_N / 128);
+            int row = sh_warp / (TILESIZE_N / 128);
+            if (row >= size_m) break;
+
+            const half* post_scale_c = post_scale + slice2_n * gl_c_stride_n + col * 128;
+
+            if constexpr (c_fp32)
+            {
+                const float* had_in = sh_c + row * TILESIZE_N + col * 128;
+                float* had_out = gl_c_ptr_32 + row * size_n_stride + col * 128;
+                had_ff_r_128_inner<false, true>(had_in, had_out, post_scale_c, 0.088388347648f);
+            }
+            else if constexpr (EPI == 0)
+            {
+                const float* had_in = sh_c + row * TILESIZE_N + col * 128;
+                half* had_out = gl_c_ptr_16 + row * size_n_stride + col * 128;
+                had_fh_r_128_inner<false, true>(had_in, had_out, post_scale_c, 0.088388347648f);
+            }
+            else
+            {
+                const half* had_in = ((const half*) sh_c) + row * TILESIZE_N + col * 128;
+                half* had_out = gl_c_ptr_16 + row * size_n_stride + col * 128;
+                had_hf_r_128_inner<false, true>(had_in, had_out, post_scale_c, 0.088388347648f);
+            }
+        }
+    };
+
+    // Partial-sum slots (dv2_store_slot / dv2_fold): whole fragments as float4 at
+    // [(m * F + n) * 256 + t]; at 16-row tiles with size_m <= 8, only elements [0], [1] (rows 0-7)
+    // as float2 at [n * 256 + t]
+    const int slot_floats = exl3_dense_v2_slot_floats(TILESIZE_M, TILESIZE_N, size_m);
+    const bool compact = (TILEBLOCKS_M == 1) && (size_m <= 8);
+
+    // Final sums of the current column tile (in frag_c, sub_k == 0 threads) -> output transform -> C.
+    // The caller has separated the threadblock reduction's last reads of sh_c from these writes
+    auto epilogue = [&] () DGV2_AI
+    {
+        if constexpr (EPI == 1 && !c_fp32)
+        {
+            if (!sub_k) write_sum_tile_sh_h();
+        }
+        else
+        {
+            if (!sub_k) write_sum_tile_sh();
+        }
+        __syncthreads();
+        if (!sub_k) output_had_sh_gl();
+        __syncthreads();    // sh_c is reused by the next segment's threadblock reduction
+    };
+
+    // Head of a column that continues in later CTAs: always this CTA's last segment (the segment
+    // ends before the top k tile, so it ends the slice). Its fold runs after the main loop
+    bool deferred = false;
+
+    // Output reduction at the end of a segment (in the unrolled main loop: kept to the served size)
+    auto reduce = [&] () DGV2_AI
+    {
+        #if EXL3_GEMM_H_ACC
+            #pragma unroll
+            for (int m = 0; m < TILEBLOCKS_M; ++m)
+                #pragma unroll
+                for (int n = 0; n < FRAGS_N_PER_WARP; ++n)
+                {
+                    float2 f0 = __half22float2(frag_c_h[m][n][0]);
+                    float2 f1 = __half22float2(frag_c_h[m][n][1]);
+                    frag_c[m][n][0] += f0.x; frag_c[m][n][1] += f0.y;
+                    frag_c[m][n][2] += f1.x; frag_c[m][n][3] += f1.y;
+                }
+        #endif
+
+        threadblock_reduce();
+
+        // This segment covers k tiles slice2_k0 .. slice2_k of column tile slice2_n
+        const bool is_head = slice2_k0 == 0;
+        const bool is_top = slice2_k == tiles_k - 1;
+
+        if (!is_head)
+        {
+            // Publish and move on. Only a CTA's first segment can start mid-column, so the slot
+            // is this CTA's. barrier_release: __syncthreads, then fence.acq_rel.gpu + red.add
+            if (!sub_k) dv2_store_slot<TILEBLOCKS_M, FRAGS_N_PER_WARP>(frag_c, ws_slots + (size_t) blockIdx.x * slot_floats, compact, t);
+            barrier_release(&locks[slice_m * blocks_n + slice2_n], 1, false);
+            clear_frag_c();
+        }
+        else if (is_top)
+        {
+            // Whole column in this CTA. The served kernel reaches its epilogue through
+            // barrier_acquire, whose __syncthreads separates the threadblock reduction's last
+            // reads of sh_c from the epilogue's writes into it
+            __syncthreads();
+            epilogue();
+            clear_frag_c();
+        }
+        else
+        {
+            // Keep frag_c; slice2_n and the C pointers do not move (advance2 stays in this column)
+            deferred = true;
+        }
+    };
+
+    auto wait_stage = [&] () DGV2_AI
+    {
+        cp_async_wait<SH_STAGES - 2>();
+        __syncthreads();
+    };
+
+    auto matmul = [&] (int buf) DGV2_AI
+    {
+        if constexpr (TILEBLOCKS_M == 1)
+        {
+            #pragma unroll
+            for (int n = 0; n < FRAGS_N_PER_WARP; ++n)
+            {
+                #if EXL3_GEMM_H_ACC
+                    ptx_mma_m16n8k16(frag_a[buf], frag_b[buf][n], frag_c_h[0][n]);
+                #else
+                    ptx_mma_m16n8k16(frag_a[buf], frag_b[buf][n], frag_c[0][n]);
+                #endif
+            }
+        }
+        else
+        {
+            #pragma unroll
+            for (int m = 0; m < TILEBLOCKS_M; ++m)
+                #pragma unroll
+                for (int n = 0; n < FRAGS_N_PER_WARP; ++n)
+                {
+                    #if EXL3_GEMM_H_ACC
+                        ptx_mma_m16n8k16(frag_a[m], frag_b[buf][n], frag_c_h[m][n]);
+                    #else
+                        ptx_mma_m16n8k16(frag_a[m], frag_b[buf][n], frag_c[m][n]);
+                    #endif
+                }
+        }
+    };
+
+    #if DGV2_BPRO
+    // Prologue: B tiles of the first SH_STAGES - 1 stages (one commit group), then the caller's input
+    // stage, then the A tile of each stage (one commit group per stage), then the served wait_stage:
+    // wait_group<SH_STAGES - 2> completes the B group and A stage 0 and leaves the other A stages in
+    // flight. The pipeline state (slice0_*, sh0_*, pending groups) ends where the served prologue
+    // leaves it, one extra group ahead, which the main loop's wait_group<SH_STAGES - 2> absorbs
+    {
+        const half* s_gl_a_ptr = gl_a_ptr;
+        const uint16_t* s_gl_b_ptr = gl_b_ptr;
+        const int s_slice0_k = slice0_k;
+        const int s_slice0_n = slice0_n;
+        const int s_slice0_iters = slice0_iters;
+        half* s_sh0_a_ptr = sh0_a_ptr;
+        uint16_t* s_sh0_b_ptr = sh0_b_ptr;
+
+        if (!sub_k)
+        {
+            #pragma unroll
+            for (int i = 0; i < SH_STAGES - 1; ++i)
+            {
+                if (slice0_iters)
+                {
+                    load_b_stage();
+                    advance0();
+                }
+            }
+        }
+        cp_async_fence();
+
+        gl_a_ptr = s_gl_a_ptr;
+        gl_b_ptr = s_gl_b_ptr;
+        slice0_k = s_slice0_k;
+        slice0_n = s_slice0_n;
+        slice0_iters = s_slice0_iters;
+        sh0_a_ptr = s_sh0_a_ptr;
+        sh0_b_ptr = s_sh0_b_ptr;
+
+        pre_a();
+
+        #pragma unroll
+        for (int i = 0; i < SH_STAGES - 1; ++i)
+        {
+            if (!sub_k && slice0_iters)
+            {
+                load_a_stage();
+                advance0();
+            }
+            cp_async_fence();
+        }
+        wait_stage();
+    }
+    #else
+    // Served order: input stage (Hadamard + barrier), then the served pipeline prologue
+    pre_a();
+    #pragma unroll
+    for (int i = 0; i < SH_STAGES - 1; ++i)
+        async_load_gl();
+    wait_stage();
+    #endif
+
+    clear_frag_c();
+    if constexpr (FRAG_STAGES > 1)
+        load_frags(0);
+
+    #define FSTAGE_OLD_V2(_load, _mul) \
+        async_load_gl(); \
+        wait_stage(); \
+        load_frags(_load); \
+        matmul(_mul); \
+        if (slice2_k == tiles_k - 1 || slice2_iters == 1) { reduce(); slice2_k0 = slice2_k + 1; } \
+        advance2(); \
+        if (!slice2_iters) break; \
+
+    #define FSTAGE_V2(_load, _mul) \
+        async_load_gl(); \
+        wait_stage(); \
+        matmul(_mul); \
+        if (slice2_k == tiles_k - 1 || slice2_iters == 1) { reduce(); slice2_k0 = slice2_k + 1; } \
+        advance2(); \
+        if (!slice2_iters) break; \
+        load_frags(_load); \
+
+    if constexpr (FRAG_STAGES == 1)
+    {
+        while (true)
+        {
+            FSTAGE_OLD_V2(0, 0);
+        }
+    }
+
+    if constexpr (FRAG_STAGES == 2)
+    {
+        while (true)
+        {
+            FSTAGE_V2(1, 0);
+            FSTAGE_V2(0, 1);
+        }
+    }
+
+    if constexpr (FRAG_STAGES == 3)
+    {
+        while (true)
+        {
+            FSTAGE_V2(1, 0);
+            FSTAGE_V2(2, 1);
+            FSTAGE_V2(0, 2);
+        }
+    }
+
+    if constexpr (FRAG_STAGES == 4)
+    {
+        while (true)
+        {
+            FSTAGE_V2(1, 0);
+            FSTAGE_V2(2, 1);
+            FSTAGE_V2(3, 2);
+            FSTAGE_V2(0, 3);
+        }
+    }
+
+    if constexpr (FRAG_STAGES == 5)
+    {
+        while (true)
+        {
+            FSTAGE_V2(1, 0);
+            FSTAGE_V2(2, 1);
+            FSTAGE_V2(3, 2);
+            FSTAGE_V2(4, 3);
+            FSTAGE_V2(0, 4);
+        }
+    }
+
+    #undef FSTAGE_OLD_V2
+    #undef FSTAGE_V2
+
+    // Deferred head (see reduce): wait for every producer of this column, fold their partials in
+    // chain order into frag_c, reset the lock, transform and store. One call site, outside the
+    // unrolled loop, with frag_a / frag_b dead
+    if (deferred)
+    {
+        const int b_top = (((slice2_n + 1) * tiles_k) * num_slices - 1) / tiles_kn;   // owner of the top k tile
+        int nprod = 0;
+        for (int b = blockIdx.x + 1; b <= b_top; ++b)
+            nprod += dv2_tile_beg(tiles_kn, num_slices, b + 1) > dv2_tile_beg(tiles_kn, num_slices, b) ? 1 : 0;
+        int* lock = &locks[slice_m * blocks_n + slice2_n];
+        barrier_acquire(lock, nprod);   // thread 0 spins (ld.acquire.gpu), then __syncthreads
+        if (!sub_k)
+            dv2_fold<TILEBLOCKS_M, FRAGS_N_PER_WARP, c_fp32>
+                (frag_c, ws_slots, slot_floats, compact, b_top, blockIdx.x, tiles_kn, num_slices, t);
+        if (threadIdx.x == 0) *lock = 0;   // every producer of this column has arrived
+        epilogue();
+    }
+}
diff --git a/exllamav3/exllamav3_ext/quant/exl3_gemm_v2_kernel.cuh b/exllamav3/exllamav3_ext/quant/exl3_gemm_v2_kernel.cuh
new file mode 100644
index 0000000000000000000000000000000000000000..e41433a8bba279a8d48fb6a3b1e8a624deb3ad7d
--- /dev/null
+++ b/exllamav3/exllamav3_ext/quant/exl3_gemm_v2_kernel.cuh
@@ -0,0 +1,194 @@
+#pragma once
+
+// densegemm r1: twins of exl3_gemm_kernel / exl3_mgemm_kernel (exl3_gemm_kernel.cuh) built on
+// exl3_gemm_kernel_inner_v2 (see the header of exl3_gemm_inner_v2.cuh for what changes and why the
+// output is bitwise identical). Same arguments as the served kernels plus one trailing pointer
+// (the partial-sum workspace), so graph parameter indices are unchanged. Launched only for:
+//   exl3_gemm_v2_kernel:  size_m <= TILESIZE_M, suh / svh / A_had present (dense EXL3 linears)
+//   exl3_mgemm_v2_kernel: dense mode only (no indices, weights or range filter, num_tokens 1),
+//                         size_m <= TILESIZE_M
+// with the grid the served kernel would get (autotuned config), which fixes the k partition.
+//
+// Barriers vs the served kernels:
+//   gemm:  input Hadamard + grid.sync (unchanged); the trailing grid.sync after the last 16-row
+//          chunk (a leftover of a commented-out epilogue) is gone.
+//   mgemm: sliced mode keeps the input Hadamard + grid.sync but drops the group barrier that
+//          followed it; per-matrix mode keeps its per-matrix Hadamard + group barrier. The
+//          per-chunk group barrier and the separate output-Hadamard pass are gone (the finalizing
+//          CTA transforms its own tile); a group barrier separates consecutive matrices of one
+//          z-group only when there is a next matrix (lock and slot reuse).
+
+#include "exl3_kernel_map.cuh"
+#include "hadamard_inner.cuh"
+#include "exl3_gemm_inner_v2.cuh"
+#include "exl3_devctx.cuh"
+
+template<EXL3_GEMM_T_ARGS>
+__global__ __launch_bounds__(EXL3_GEMM_BASE_THREADS * TILESIZE_K / 16)
+void exl3_gemm_v2_kernel(EXL3_GEMM_ARGS, float* __restrict__ ws)
+{
+    static_assert(!half_k, "densegemm V2 twins: integer bitrates only (rebase-dev-r2)");
+    auto grid = cg::this_grid();
+
+    auto pre_a = [&] () DGV2_AI
+    {
+        int total_warps = size_m * size_k / 128;
+        int warps_grid = gridDim.x * blockDim.x / 32;
+        int this_warp = threadIdx.x / 32 + blockDim.x / 32 * blockIdx.x;
+
+        for(; this_warp < total_warps; this_warp += warps_grid)
+            had_hf_r_128_inner<true, false>
+            (
+                A + this_warp * 128,
+                A_had + this_warp * 128,
+                suh + (this_warp * 128) % size_k,
+                0.088388347648f  // 1/sqrt(128)
+            );
+
+        grid.sync();
+    };
+
+    exl3_gemm_kernel_inner_v2
+    <bits, half_k, c_fp32, cb, TILESIZE_M, TILESIZE_K, TILESIZE_N, SH_STAGES, FRAG_STAGES, 0>
+    (A_had, B, C, size_m, size_k, size_n, locks, svh, 0, ws, pre_a);
+}
+
+template<EXL3_GEMM_T_ARGS>
+__global__ __launch_bounds__(EXL3_GEMM_BASE_THREADS * TILESIZE_K / 16)
+void exl3_mgemm_v2_kernel(EXL3_MGEMM_ARGS, float* __restrict__ ws)
+{
+    static_assert(!half_k, "densegemm V2 twins: integer bitrates only (rebase-dev-r2)");
+    int bszm = MAX(bszm_in, bszm_out);
+    auto grid = cg::this_grid();
+
+    #if defined(__CUDA_ARCH__) && (__CUDA_ARCH__ > 890)
+        int* barrier_counters_sense = locks + BARRIER_LOCKS_OFFSET;
+    #endif
+
+    auto group_sync = [&] () DGV2_AI
+    {
+        #if defined(__CUDA_ARCH__) && (__CUDA_ARCH__ > 890)
+            group_barrier(blockIdx.z, gridDim.x, barrier_counters_sense);
+        #else
+            grid.sync();
+        #endif
+    };
+
+    const int slot_floats = exl3_dense_v2_slot_floats(TILESIZE_M, TILESIZE_N, size_m);
+    float* ws_z = ws + (size_t) blockIdx.z * gridDim.x * slot_floats;
+
+    for (int i = 0; i < bszm; i += gridDim.z)
+    {
+        const bool first_iter = i == 0;
+        int j = i + blockIdx.z;
+        int mat_index = -1;
+        const uint16_t* B = nullptr;
+        if (j >= bszm) j = -1;
+        else
+        {
+            mat_index = j;
+            B = B_list[mat_index];
+        }
+
+        // Input stage of this matrix (called once by every thread, from inside the inner loop's
+        // prologue when there is a matrix, directly otherwise)
+        auto pre_a = [&] () DGV2_AI
+        {
+            if (had_src_list)
+            {
+                if (first_iter)
+                {
+                    // Sliced mode: one input transform per source, every block cooperating (served code)
+                    int total_warps = size_m * size_k / 128;
+                    int warps_grid = gridDim.x * gridDim.z * blockDim.x / 32;
+                    int this_warp = threadIdx.x / 32 + blockDim.x / 32 * (blockIdx.x + gridDim.x * blockIdx.z);
+                    for (; this_warp < num_had_src * total_warps; this_warp += warps_grid)
+                    {
+                        int src = this_warp / total_warps;
+                        int w = this_warp - src * total_warps;
+                        had_hf_r_128_inner<true, false>
+                        (
+                            A + w * 128,
+                            A_had + src * size_m * size_k + w * 128,
+                            suh_list[src] + (w * 128) % size_k,
+                            0.088388347648f  // 1/sqrt(128)
+                        );
+                    }
+                    grid.sync();
+                }
+                else
+                {
+                    // Previous matrix of this z-group done everywhere (lock and slot reuse)
+                    group_sync();
+                }
+            }
+            else
+            {
+                if (B)
+                {
+                    int total_warps = size_m * size_k / 128;
+                    int warps_grid = gridDim.x * blockDim.x / 32;
+                    int this_warp = threadIdx.x / 32 + blockDim.x / 32 * blockIdx.x;
+
+                    const half* suh = suh_list[mat_index];
+                    const half* A_ = bszm_in == 1 ? A : A + j * size_m * size_k;
+                    half* A_had_ = A_had + j * size_m * size_k;
+
+                    for(; this_warp < total_warps; this_warp += warps_grid)
+                        had_hf_r_128_inner<true, false>
+                        (
+                            A_ + this_warp * 128,
+                            A_had_ + this_warp * 128,
+                            suh + (this_warp * 128) % size_k,
+                            0.088388347648f  // 1/sqrt(128)
+                        );
+                }
+                group_sync();
+            }
+        };
+
+        if (!B)
+        {
+            pre_a();
+            continue;
+        }
+
+        int n_j = size_n_list ? size_n_list[mat_index] : size_n;
+        int n_stride_j = n_stride_list ? n_stride_list[mat_index] : n_j;
+        const half* A_ = A_had + (had_src_list ? had_src_list[mat_index] : j) * size_m * size_k;
+        void* C_;
+        if (C_list) C_ = C_list[mat_index];
+        else if constexpr (c_fp32) C_ = (void*) (((float*) C) + j * size_m * size_n);
+        else                       C_ = (void*) (((half*) C) + j * size_m * size_n);
+
+        int lock_offs = blockIdx.z * size_n / 128;
+
+        exl3_gemm_kernel_inner_v2
+        <bits, half_k, c_fp32, cb, TILESIZE_M, TILESIZE_K, TILESIZE_N, SH_STAGES, FRAG_STAGES, 1>
+        (A_, B, C_, size_m, size_k, n_j, locks + lock_offs, svh_list[mat_index], n_stride_j, ws_z, pre_a);
+    }
+}
+
+// Shapes: the served ones (exl3_kernel_map.cuh) and the 32-row variants of shapes 2 and 3
+#define EXL3_GEMM_V2_SHAPE_2_M32     32,     32,    128,     4,     3
+#define EXL3_GEMM_V2_SHAPE_3_M32     32,     32,    256,     4,     3
+
+// Instance table per (kernel, c_fp32): index = shape_idx (1..4) for 16 rows, 5 / 6 = shapes 2 / 3 at 32 rows.
+// rebase-dev-r2: EXL3_GEMM_T_ARGS gained half_k after bits (upstream 07b8a2e); the twins are integer-K only
+#define EXL3_GEMM_V2_INSTANCES(_bits, _c_fp32, _cb) \
+    nullptr, \
+    (void*) exl3_gemm_v2_kernel<_bits, false, _c_fp32, _cb, EXL3_GEMM_SHAPE_1>, \
+    (void*) exl3_gemm_v2_kernel<_bits, false, _c_fp32, _cb, EXL3_GEMM_SHAPE_2>, \
+    (void*) exl3_gemm_v2_kernel<_bits, false, _c_fp32, _cb, EXL3_GEMM_SHAPE_3>, \
+    (void*) exl3_gemm_v2_kernel<_bits, false, _c_fp32, _cb, EXL3_GEMM_SHAPE_4>, \
+    (void*) exl3_gemm_v2_kernel<_bits, false, _c_fp32, _cb, EXL3_GEMM_V2_SHAPE_2_M32>, \
+    (void*) exl3_gemm_v2_kernel<_bits, false, _c_fp32, _cb, EXL3_GEMM_V2_SHAPE_3_M32>
+
+#define EXL3_MGEMM_V2_INSTANCES(_bits, _c_fp32, _cb) \
+    nullptr, \
+    (void*) exl3_mgemm_v2_kernel<_bits, false, _c_fp32, _cb, EXL3_GEMM_SHAPE_1>, \
+    (void*) exl3_mgemm_v2_kernel<_bits, false, _c_fp32, _cb, EXL3_GEMM_SHAPE_2>, \
+    (void*) exl3_mgemm_v2_kernel<_bits, false, _c_fp32, _cb, EXL3_GEMM_SHAPE_3>, \
+    (void*) exl3_mgemm_v2_kernel<_bits, false, _c_fp32, _cb, EXL3_GEMM_SHAPE_4>, \
+    (void*) exl3_mgemm_v2_kernel<_bits, false, _c_fp32, _cb, EXL3_GEMM_V2_SHAPE_2_M32>, \
+    (void*) exl3_mgemm_v2_kernel<_bits, false, _c_fp32, _cb, EXL3_GEMM_V2_SHAPE_3_M32>
diff --git a/exllamav3/exllamav3_ext/quant/exl3_gemv.cu b/exllamav3/exllamav3_ext/quant/exl3_gemv.cu
