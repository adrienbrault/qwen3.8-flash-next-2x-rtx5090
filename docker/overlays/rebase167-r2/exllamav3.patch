index 0000000000000000000000000000000000000000..9c25de03acaba72abf19d74b4f7e8166aa18368d
--- /dev/null
+++ b/exllamav3/exllamav3_ext/quant/exl3_dense_v2.cuh
@@ -0,0 +1,78 @@
+#pragma once
+
+// densegemm r1: host side of the dense EXL3 V2 kernels (exl3_gemm_v2_kernel.cuh,
+// exl3_gemv_v2_kernel.cuh). Opt-in, default off:
+//   EXL3_DENSE_V2     = 0 (unset) served kernels | 1 V2 gemm + mgemm + gemv | 2 gemm + mgemm | 3 gemv
+//   EXL3_DENSE_ROWS32 = 0 (unset) | 1 one-pass 17-32-row gemm / mgemm (shapes 2, 3), independent of
+//                       EXL3_DENSE_V2
+// Both are read once, at the first dense call (dense_v2_set_mode overrides them for tests). Every
+// launch uses the grid the served path would use for the same call, and every V2 kernel is bitwise
+// identical to the served kernel it replaces at that grid. Anything not covered (other K or
+// codebook, unexpected shape, workspace too small, first call of a shape) runs the served kernel.
+
+#include <cuda_runtime.h>
+#include <cstdint>
+#include <tuple>
+
+#define DENSE_V2_REVISION 2
+#define DENSE_V2_GEMV_MAX_HBLOCKS 16384      // gemv output-block arrival counters per device
+
+int dense_v2_mode();
+bool dense_v2_rows32();
+void dense_v2_set_mode(int mode, int rows32);          // -1 keeps the current value (tests)
+bool dense_v2_k6();                                     // tune268: EXL3_DENSE_V2_K6 (K = 6 gemm / mgemm twins), default off
+void dense_v2_set_k6(int k6);                           // -1 keeps the current value (tests)
+std::tuple<int, int> dense_v2_modes();                  // (EXL3_DENSE_V2, EXL3_DENSE_ROWS32)
+std::tuple<int64_t, int64_t> dense_v2_launch_counts();  // (V2 gemm/mgemm launches, V2 gemv launches), tests
+void dense_v2_reset_counts();
+
+inline bool dense_v2_gemm_on() { int m = dense_v2_mode(); return m == 1 || m == 2; }
+inline bool dense_v2_gemv_on() { int m = dense_v2_mode(); return m == 1 || m == 3; }
+
+// stack-r3 lcguard (latchain EXL3_LC_QSA_FORK x densegemm). latchain captures the QSA indexer chain of each
+// attention layer on a side stream that runs concurrently with the main branch's q/k/v projections; its one dense
+// call, exl3_gemm_gr(index_qk), passes locks = the device's lock base + LC_LOCKS_ALT_OFFSET (libtorch/lc_fork.h).
+// The V2 twins keep per-device scratch (g_ws in exl3_dense_v2.cu): partial-sum slots (gemm / mgemm twins) and
+// output-block arrival counters (gemv twin), one copy each, so a twin on the side branch would share them with a
+// concurrent main-branch twin. A side-branch call therefore gets its own scratch: the gemv twin counts in the upper
+// half of hctr (the main branch uses the lower half; both halves are bounded to DENSE_V2_GEMV_MAX_HBLOCKS / 2
+// output blocks), the gemm twin writes a separate side slot region; a call that does not fit takes the served
+// kernel. Same kernels, same grids, same arithmetic: only the scratch addresses differ, baked into the captured
+// node like every other argument. The branch is read from the call's own locks argument (index 6 of the 10
+// exl3_gemm_kernel arguments), so this compiles with or without latchain: without it, and on every main-branch
+// call, locks is the base pointer and nothing changes. exl3_mgemm_gr never runs on the side branch.
+#define DENSE_V2_LC_GUARD 1
+inline bool dense_v2_on_side_branch(void* const* kernel_args, const int* base_locks)
+{
+    const int* locks = *((const int* const*) kernel_args[6]);
+    return locks != base_locks;
+}
+std::tuple<int64_t, int64_t> dense_v2_lc_side_counts();   // (side-branch twin launches, side calls sent to served), tests
+
+// V2 twin of the autotuned exl3_gemm_kernel launch this call would get (cache hit only). Returns
+// the launched kernel (for graph parameter recording) and sets *out_tag, or nullptr (nothing launched)
+void* dense_v2_launch_gemm
+(
+    void** kernel_args,         // the 10 exl3_gemm_kernel arguments
+    uint64_t autotune_key,
+    int size_m, int size_k, int size_n, int K, int cb, bool c_fp32,
+    int device, cudaStream_t stream, int* out_tag
+);
+
+// Same for exl3_mgemm_kernel; the caller has checked dense mode (no indices / weights / range
+// filter, num_tokens 1)
+void* dense_v2_launch_mgemm
+(
+    void** kernel_args,         // the 22 exl3_mgemm_kernel arguments
+    uint64_t autotune_key,
+    int size_m, int size_k, int size_n, int K, int cb, bool c_fp32,
+    int device, cudaStream_t stream, int* out_tag
+);
+
+// V2 twin of an exl3_gemv_kernel launch already decided by exl3_gemv_try_launch
+void* dense_v2_launch_gemv
+(
+    void** kernel_args,         // the 10 exl3_gemm_kernel arguments
+    int size_m, int size_k, int size_n, int K, int cb, bool c_fp32, int mmode, int cfg,
+    int block_dim, int cols, int device, cudaStream_t stream
+);
