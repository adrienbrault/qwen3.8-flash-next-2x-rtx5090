index 0000000000000000000000000000000000000000..3115163c603206cf446bdf35c7d7bcd8a78eb126
--- /dev/null
+++ b/exllamav3/util/prefill_nosync.py
@@ -0,0 +1,86 @@
+"""Opt-in prefill metadata changes; no floating-point kernel or tier-plan changes.
+
+The name is the operator's feature flag, not a promise of zero waits: the exact
+reconstruct planner still consumes one count readback per MoE layer.
+"""
+import os
+
+import torch
+
+
+def enabled(params):
+    return (os.environ.get("EXL3_PREFILL_NOSYNC", "0") == "1" and
+            params.get("_prefill_nosync", False))
+
+
+def half_histogram_enabled(layer, rows, topk, hidden):
+    """tune268-r2: fixed histogram for the full, layer-local K2.5 prefill.
+
+    Read per call; unlike enabled(params), this does not require a pipeline
+    descriptor. Routing guarantees expert ids in [0, E], including the sentinel.
+    Keep the host tier planner and its explicit count readback unchanged.
+    """
+    return (
+        os.environ.get("EXL3_MOE_PREFILL_HALF_HIST", "0") == "1" and
+        rows >= 512 and topk == 10 and hidden == 2560 and
+        layer.num_experts == 512 and layer.num_local_experts == 512 and
+        layer.fused_mode_buffers is not None and layer.gated and
+        layer.intermediate_size_padded == 640 and
+        all(m.K == 2.5 and m.mul1 and not m.mcg for m in
+            (layer.multi_gate, layer.multi_up, layer.multi_down))
+    )
+
+
+def expert_histogram(flat_expert_local, num_experts):
+    """Fixed-size int64 histogram, including the expert-slice sentinel bin.
+
+    Routing supplies indices in [0, num_experts]. Unlike CUDA bincount, this
+    does not read min/max back to the CPU to validate/size its output. Integer
+    additions are exact; argsort and all floating-point work remain unchanged.
+    """
+    counts = torch.zeros((num_experts + 1,), dtype = torch.long,
+                         device = flat_expert_local.device)
+    counts.scatter_add_(0, flat_expert_local, torch.ones_like(flat_expert_local))
+    return counts
+
+
+def read_counts(counts):
+    """One explicit pinned readback + event wait for the unchanged CPU planner.
+
+    Fresh storage is owned until the event completes. Only then may tolist read
+    the CPU values. The wait is local to this issue thread; the pipeline's other
+    stage can progress. This is NOT elimination of the planner dependency.
+    """
+    host = torch.empty(counts.shape, dtype = counts.dtype, device = "cpu",
+                       pin_memory = True)
+    host.copy_(counts, non_blocking = True)
+    done = torch.cuda.Event()
+    done.record(torch.cuda.current_stream(counts.device))
+    done.synchronize()
+    return host.tolist()
+
+
+def upload_metadata(host, device):
+    """Own a fresh pinned copy; never asynchronously upload a mutable numpy view.
+
+    PyTorch's pinned allocator tracks the async transfer before recycling the
+    source allocation. There is no staging-buffer overwrite or global cache.
+    """
+    return host.pin_memory().to(device, non_blocking = True)
+
+
+def join_stages(devices, streams):
+    """One host event join covering both stage streams, before draft/commit.
+
+    Both issue threads must have finished submitting before calling this.
+    The consumer's join sits AFTER B_i and waits for A_(i+1); it cannot delay
+    B_i's kernels. No new stream or scratch arena is introduced.
+    """
+    ready = torch.cuda.Event()
+    done = torch.cuda.Event()
+    with torch.cuda.device(devices[0]):
+        ready.record(streams[0])
+    with torch.cuda.device(devices[1]):
+        streams[1].wait_event(ready)
+        done.record(streams[1])
+    done.synchronize()
diff --git a/tests/test_r2_defaults.py b/tests/test_r2_defaults.py
new file mode 100644
index 0000000000000000000000000000000000000000..2f4b4f1465cdc90108c386fe9ca8af4c202095af
--- /dev/null
+++ b/tests/test_r2_defaults.py
@@ -0,0 +1,59 @@
+"""Exercise the r2 defaults on a CPU without importing the CUDA extension."""
+
+import ast
+import os
+import unittest
+from pathlib import Path
+from types import SimpleNamespace
+
+
+ENGINE = Path(__file__).resolve().parents[1] / "exllamav3"
+
+
+def load_function(path, name, **namespace):
+    path = ENGINE / path
+    tree = ast.parse(path.read_text())
+    fn = next(node for node in tree.body if isinstance(node, ast.FunctionDef) and node.name == name)
+    exec(compile(ast.Module(body=[fn], type_ignores=[]), str(path), "exec"), namespace)
+    return namespace[name]
+
+
+class R2Defaults(unittest.TestCase):
+    def test_fp16_router_in_both_block_types(self):
+        def module(*args, **kwargs):
+            return SimpleNamespace(**kwargs)
+
+        half = object()
+        build = load_function(
+            "architecture/qwen4_exp.py", "build_qwen4_block", os=os,
+            torch=SimpleNamespace(half=half, float=object()), Qwen4ExpConfig=object,
+            **dict.fromkeys(("TransformerBlock", "GatedResidual", "GatedDeltaNet", "GatedRMSNorm",
+                             "Attention", "RMSNorm", "QSAIndexer", "BlockSparseMLP", "GatedMLP"), module),
+        )
+        config = SimpleNamespace(
+            hc_mult=4, hidden_size=2560, rms_norm_eps=1e-6,
+            linear_key_head_dim=128, linear_value_head_dim=128, linear_num_key_heads=16,
+            linear_num_value_heads=32, linear_conv_kernel_dim=4, output_gate_type="silu",
+            head_dim=128, num_q_heads=16, num_kv_heads=2, rope_settings=None,
+            indexer_n_heads=16, indexer_kv_heads=1, indexer_head_dim=64, indexer_budget=2048,
+            indexer_compress_ratio=4, moe_intermediate_size=512, num_experts=512,
+            num_experts_per_tok=10, shared_expert_intermediate_size=512,
+        )
+        for layer_type in ("linear_attention", "full_attention"):
+            with self.subTest(layer_type=layer_type):
+                self.assertIs(build(config, "layers.0", 0, layer_type).mlp.router_dtype, half)
+
+    def test_decode_tile_boundaries(self):
+        layout = load_function(
+            "modules/attention_fn/triton_paged.py", "decode_row_layout", os=os,
+            triton=SimpleNamespace(cdiv=lambda a, b: (a + b - 1) // b,
+                                   next_power_of_2=lambda n: 1 << (n - 1).bit_length()),
+        )
+        for q_len, group_size, blocks in ((1, 8, 1), (4, 4, 1), (17, 1, 2), (4, 8, 2), (5, 8, 3), (4, 16, 4)):
+            for hd_pad in (64, 128, 256):
+                with self.subTest(q_len=q_len, group_size=group_size, hd_pad=hd_pad):
+                    self.assertEqual(layout(q_len, group_size, hd_pad), (16, blocks))
+
+
+if __name__ == "__main__":
+    unittest.main()
