+
+namespace exl3_moe_coop_v2_ns {
+
+// EXL3_MOE_COOP_HALF_A_UNCAP=1. Body matches the served A HALF kernel; only
+// the name and launch bound differ. Keep the capped kernel's codegen intact.
+template <bool WIDE>
+__global__ __launch_bounds__(THREADS)
+void exl3_moe_coop_a_kernel_h_uncap(const MoeCoopParams p)
+{
+    for (int i = blockIdx.x * THREADS + threadIdx.x; i < p.ctr_b_len; i += gridDim.x * THREADS)
+        p.ctr_b[i] = 0;
+    const int runs = p.a_global ? p.runs[0] : p.bsz * p.topk;
+    const int count = runs * (p.I / tile_cols<WIDE>()) * p.ksplit_a * (p.gated ? 2 : 1);
+    for (int item = blockIdx.x; item < count; item += gridDim.x)
+    {
+        tile_a<2, 2, WIDE, true>(p, item);
+        __syncthreads();
+    }
+}
+
+} // namespace exl3_moe_coop_v2_ns
+
+MoeCoopKernel exl3_moe_coop_v2_a_h2_uncap(int Hi, bool wide)
+{
+    using namespace exl3_moe_coop_v2_ns;
