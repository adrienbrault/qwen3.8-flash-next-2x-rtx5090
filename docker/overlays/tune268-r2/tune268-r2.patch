+#include "exl3_moe_instances.cuh"
+#include "../exl3_moe_kernel.cuh"
+
+// EXL3_MOE_PREFILL_HALF_STATIC=1. Reuse the served outer kernel verbatim, but
+// specialize all of its GEMM calls. -5 is a private tag (negative half-bit units),
+// NOT a value passed as 'bits' to the dequantizer. No served instantiation uses it.
+// Every possible row tile is specialized before the first kernel instantiation.
+// This is the exact K=5 arm of moe_gemm_tile<0, 2, MT, 128>, without the other
+// ten bitrate arms sharing its register allocation and instruction footprint.
+#define H2_TILE(MT_) \
+template <> \
+__device__ __forceinline__ \
+void moe_gemm_tile<-5, 2, MT_, 128>( \
+    const half* __restrict__ in_addr, const uint16_t* __restrict__ trellis, \
+    half* __restrict__ out_addr, const int size_m, const int size_k, \
+    const int size_n, int* __restrict__ locks, const int K) \
+{ \
+    constexpr int FS = (MT_ >= 64) ? 2 : MOE_FRAG_STAGES; \
+    exl3_gemm_kernel_inner<2, true, false, 2, MT_, MOE_TILESIZE_K, 128, \
+        MOE_SH_STAGES, FS, false>(in_addr, trellis, out_addr, MIN(size_m, MT_), \
+                                 size_k, size_n, locks, nullptr); \
+}
+
+H2_TILE(16)
+H2_TILE(32)
+H2_TILE(64)
+#undef H2_TILE
+
+fp_exl3_moe_kernel exl3_moe_prefill_h2_static(int m_tile)
+{
+    if (m_tile <= 16) return exl3_moe_kernel<-5, 128, 2, 16>;
+    if (m_tile >= 64) return exl3_moe_kernel<-5, 128, 2, 64>;
+    return exl3_moe_kernel<-5, 128, 2, 32>;
+}
