+        # At most current and lookahead captures are unpublished. With two slabs,
+        # all additional owners are submitted worker tasks, which can be drained
+        # without reading live lookahead state or allocating any device workspace.
+        drain_worker()
+        slab = _pool(rs.cache, lay, alloc).try_acquire()
+    if slab is None:
+        return None
+    return Split(position - start, position,
+                 Capture(lay, rs.slot, slab, rs.cache._pm_pool, site_events=True))
