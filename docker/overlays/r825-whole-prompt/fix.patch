+            job.generator.model.loaded_tp or len(job.sequences) != 1 or job.embeddings or
+            not 0 < end - start <= 2048 or
+            not 0 <= start - rs.position <= 2048):
+        return None
+    position = end if split_at is None else split_at
+    if not start < position <= end or position % PAGE_SIZE:
+        return None
+    lay = stash_layout(rs.cache)
+    if lay is None:
+        return None
+    slab = _pool(rs.cache, lay, alloc).try_acquire()
