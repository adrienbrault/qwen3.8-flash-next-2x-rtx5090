+def try_pipeline_capture(job, start, end, split_at=None, alloc=None):
+    """R825 owning-thread reservation; live position can lag by ONE target chunk.
+
+    The planner validates fresh exclusive pages. A final inside-chunk capture uses
+    the served Split hooks and the served recurrence partition, with site events.
+    No device storage is allocated here. Failure must cut before issuing lookahead.
+    """
