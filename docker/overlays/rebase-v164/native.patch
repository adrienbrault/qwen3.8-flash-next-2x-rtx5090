+
+int64_t gr_mix_v2_int8_v3
+(
+    const at::Tensor& streams, const at::Tensor& fn_q, const at::Tensor& fn_s,
+    const at::Tensor& up_q, const at::Tensor& up_s, const at::Tensor& w,
+    double rms_eps, at::Tensor dots, at::Tensor state,
+    c10::optional<at::Tensor> post, at::Tensor mixed,
+    int64_t mode, int64_t dots_bmax, int64_t up_bmax,
+    int64_t dots_j, int64_t dots_pf, int64_t up_qn
+)
+{
+    const at::cuda::OptionalCUDAGuard device_guard(streams.device());
+    cudaStream_t stream = at::cuda::getCurrentCUDAStream().stream();
+    // Input contract: gr_mix_v2_int8_impl's checks, unchanged.
+    TORCH_CHECK_DTYPE(streams, kFloat);
+    TORCH_CHECK(fn_q.dtype() == at::kChar && up_q.dtype() == at::kChar,
+                "gr_mix_v2_int8_v3: int8 weights required");
+    TORCH_CHECK_DTYPE(fn_s, kFloat);
+    TORCH_CHECK_DTYPE(up_s, kFloat);
+    TORCH_CHECK_DTYPE(w, kHalf);
+    TORCH_CHECK_DTYPE(state, kFloat);
+    TORCH_CHECK_DTYPE(dots, kFloat);
+    TORCH_CHECK(streams.dim() == 3 && fn_q.dim() == 2 && state.dim() == 2,
+                "gr_mix_v2_int8_v3: input/workspace rank");
+    TORCH_CHECK(streams.is_contiguous() && fn_q.is_contiguous() && fn_s.is_contiguous() &&
+                up_q.is_contiguous() && up_s.is_contiguous() && w.is_contiguous() &&
+                state.is_contiguous() && dots.is_contiguous(),
+                "gr_mix_v2_int8_v3: contiguous inputs required");
+    const int R = streams.size(0), H = streams.size(1), D = streams.size(2), M = fn_q.size(0);
+    TORCH_CHECK(R >= 1 && R <= 32 && H == hcv3::H && D > 0 && D % 8 == 0,
+                "gr_mix_v2_int8_v3: dims");
+    TORCH_CHECK(up_q.dim() == 4 && up_q.size(0) == H && up_q.size(1) == D / 4 && up_q.size(3) == 4,
+                "gr_mix_v2_int8_v3: up_q must be the (H, D / 4, LR, 4) repacked layout");
+    const int LR = up_q.size(2);
+    TORCH_CHECK(LR > 0 && M == LR + (post ? H : 0),
+                "gr_mix_v2_int8_v3: fn rows must be LR (+ H with post)");
+    TORCH_CHECK(fn_q.size(1) == H * D && fn_s.numel() == M &&
+                up_s.numel() == H * D && w.numel() == H * D,
+                "gr_mix_v2_int8_v3: weight/scale shapes");
+    TORCH_CHECK(dots.dim() == 3 && dots.size(0) == R && dots.size(1) == M + 1 && dots.size(2) == H,
+                "gr_mix_v2_int8_v3: dots shape");
+    TORCH_CHECK(state.size(0) == R && state.size(1) == LR + H,
+                "gr_mix_v2_int8_v3: state shape");
+    TORCH_CHECK(mixed.is_contiguous() && mixed.dim() == 2 && mixed.size(0) == R && mixed.size(1) == D &&
+                (mixed.dtype() == at::kHalf || mixed.dtype() == at::kFloat),
+                "gr_mix_v2_int8_v3: mixed shape/dtype");
+    TORCH_CHECK(streams.is_cuda() && fn_q.device() == streams.device() &&
+                fn_s.device() == streams.device() && up_q.device() == streams.device() &&
+                up_s.device() == streams.device() && w.device() == streams.device() &&
+                state.device() == streams.device() && dots.device() == streams.device() &&
+                mixed.device() == streams.device(),
+                "gr_mix_v2_int8_v3: tensors must share a CUDA device");
+    float* post_p = nullptr;
+    if (post)
+    {
+        const auto& p = post.value();
+        TORCH_CHECK_DTYPE(p, kFloat);
+        TORCH_CHECK(p.is_contiguous() && p.dim() == 2 && p.size(0) == R && p.size(1) == H &&
+                    p.device() == streams.device(), "gr_mix_v2_int8_v3: post shape/device");
+        post_p = (float*) p.data_ptr();
+    }
+    // Served smem bound (8 rows, state-in-up); V3 at B = 8 needs LR * 12 floats + 1.1 KB.
+    TORCH_CHECK(8 * (LR + H) * sizeof(float) + 8 * 2 * H * 4 * sizeof(float) +
+                8 * H * sizeof(float) <= 48 * 1024,
+                "gr_mix_v2_int8_v3: rank exceeds shared-memory limit");
+
+    // V3 up reads dots rows as float4: needs a 16-byte aligned workspace (the served kernel reads
+    // scalars). The int8 up words and the up_s float4 are aligned as for the served kernels.
+    const bool dots_aligned = (reinterpret_cast<uintptr_t>(dots.data_ptr()) % 16) == 0;
+    const bool v3_dots = (mode & 1) != 0;
+    const bool v3_up = (mode & 2) != 0 && dots_aligned;
+
+    const float* streams_p = (const float*) streams.data_ptr();
+    const int8_t* fn_q_p = (const int8_t*) fn_q.data_ptr();
+    const float* fn_s_p = (const float*) fn_s.data_ptr();
+    float* dots_p = (float*) dots.data_ptr();
+    const int8_t* up_q_p = (const int8_t*) up_q.data_ptr();
+    const float* up_s_p = (const float*) up_s.data_ptr();
+    const half* w_p = (const half*) w.data_ptr();
+    float* state_p = (float*) state.data_ptr();
+    void* mixed_p = mixed.data_ptr();
+
+    int64_t ran = 0;
+    const bool pdl = (mode & 16) != 0;
+    // r2 (mode bits 4 / 8): the hcv4 kernels. Caps 1/2/4/8 as in r1; 0 (auto) is r1-only and runs the
+    // served tile here. The float-output up form and a misaligned dots workspace keep the r1 selection.
+    const bool v4_dots = (mode & 4) != 0 && D == hcv3::D_FIX;
+    const bool v4_up = (mode & 8) != 0 && dots_aligned && LR == hcv3::LR_FIX && mixed.dtype() == at::kHalf;
+    if (v4_dots || v4_up)
+    {
+        const int bd = tile_rows(R, dots_bmax == 0 ? 8 : dots_bmax);
+        if (v4_dots)
+        {
+            launch_dots_v4(bd, (int) dots_j, (int) dots_pf, pdl, streams_p, fn_q_p, fn_s_p, dots_p, R, M, stream);
+            ran |= 4;
+        }
+        else
+        {
+            bool d3 = false;
+            switch (bd)
+            {
+                case 1: d3 = launch_dots<1>(v3_dots, streams_p, fn_q_p, fn_s_p, dots_p, R, D, M, stream); break;
+                case 2: d3 = launch_dots<2>(v3_dots, streams_p, fn_q_p, fn_s_p, dots_p, R, D, M, stream); break;
+                case 4: d3 = launch_dots<4>(v3_dots, streams_p, fn_q_p, fn_s_p, dots_p, R, D, M, stream); break;
+                default: d3 = launch_dots<8>(v3_dots, streams_p, fn_q_p, fn_s_p, dots_p, R, D, M, stream); break;
+            }
+            if (d3) ran |= 1;
+        }
+        C10_CUDA_CHECK(cudaPeekAtLastError());
+        const int bu = tile_rows(R, up_bmax == 0 ? 8 : up_bmax);
+        bool up_pdl = false;
+        if (v4_up)
+        {
+            up_pdl = launch_up_v4(bu, (int) up_qn, pdl, streams_p, dots_p, state_p, post_p, up_q_p, up_s_p, w_p,
+                                  mixed_p, R, D, (float) rms_eps, stream);
+            ran |= up_pdl ? 8 : 2;                      // B = 8, Q = 2 ran r1's V3 up
+        }
+        else
+        {
+            const bool u3 = mixed.dtype() == at::kHalf
+                ? launch_up_b<true>(bu, v3_up, streams_p, dots_p, state_p, post_p, up_q_p, up_s_p, w_p, mixed_p,
+                                    R, D, LR, (float) rms_eps, stream)
+                : launch_up_b<false>(bu, v3_up, streams_p, dots_p, state_p, post_p, up_q_p, up_s_p, w_p, mixed_p,
+                                     R, D, LR, (float) rms_eps, stream);
+            if (u3) ran |= 2;
+        }
+        C10_CUDA_CHECK(cudaPeekAtLastError());
+        if (pdl && (v4_dots || up_pdl)) ran |= 16;  // at least one launch carried the PDL attribute
+        return ran;
+    }
+
+    const int dev = streams.get_device();
+    const int sms = at::cuda::getDeviceProperties(dev)->multiProcessorCount;
+    const bool dots_v3_kernel = v3_dots && D == hcv3::D_FIX;
+    const bool up_v3_kernel = v3_up && LR == hcv3::LR_FIX;
+    const int bd = dots_bmax == 0 ? dots_rows_auto(dev, sms, dots_v3_kernel, R, M) : tile_rows(R, dots_bmax);
+    bool d3 = false;
+    switch (bd)
+    {
+        case 1: d3 = launch_dots<1>(v3_dots, streams_p, fn_q_p, fn_s_p, dots_p, R, D, M, stream); break;
+        case 2: d3 = launch_dots<2>(v3_dots, streams_p, fn_q_p, fn_s_p, dots_p, R, D, M, stream); break;
+        case 4: d3 = launch_dots<4>(v3_dots, streams_p, fn_q_p, fn_s_p, dots_p, R, D, M, stream); break;
+        default: d3 = launch_dots<8>(v3_dots, streams_p, fn_q_p, fn_s_p, dots_p, R, D, M, stream); break;
+    }
+    C10_CUDA_CHECK(cudaPeekAtLastError());
+    if (d3) ran |= 1;
+
+    const int bu = up_bmax != 0 ? tile_rows(R, up_bmax)
+        : (mixed.dtype() == at::kHalf ? up_rows_auto<true>(dev, sms, up_v3_kernel, R, D, LR)
+                                      : up_rows_auto<false>(dev, sms, up_v3_kernel, R, D, LR));
+    const bool u3 = mixed.dtype() == at::kHalf
+        ? launch_up_b<true>(bu, v3_up, streams_p, dots_p, state_p, post_p, up_q_p, up_s_p, w_p, mixed_p,
+                            R, D, LR, (float) rms_eps, stream)
+        : launch_up_b<false>(bu, v3_up, streams_p, dots_p, state_p, post_p, up_q_p, up_s_p, w_p, mixed_p,
+                             R, D, LR, (float) rms_eps, stream);
+    C10_CUDA_CHECK(cudaPeekAtLastError());
+    if (u3) ran |= 2;
+    return ran;
+}
