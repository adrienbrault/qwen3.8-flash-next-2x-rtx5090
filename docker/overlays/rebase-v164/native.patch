+// V2 gemv_tile_v2 (a_global form) on the V3 stream: same k partition, fold points, reduction.
+template <int bits, int cb, bool WIDE>
+__device__ __forceinline__ void gemv_tile_v3
+(
+    const uint32_t* __restrict__ B32,
+    const half2* __restrict__ A2,
+    size_t a_stride2,
+    const int* __restrict__ rows,
+    int nrows,
+    void* __restrict__ C,
+    size_t c_stride,
+    bool c_f32,
+    int k_begin,
+    int k_end,
+    int ntiles,
+    int group,
+    float* __restrict__ sh_red,          // [WKK][ROWS][TCOLS]
+    uint32_t* __restrict__ sh_ring       // [WK][V3_PF][GWORDS]
+)
+{
+    static_assert(bits == 2 || bits == 3 || bits == 4, "V3 covers the register-dequant widths");
+    constexpr int TWORDS = 8 * bits;
+    constexpr int GWORDS = WNT * TWORDS;
+    constexpr int WN = tile_wn<WIDE>();
+    constexpr int WKK = tile_wk<WIDE>();
+    constexpr int TCOLS = tile_cols<WIDE>();
+    constexpr int red_rows = ROWS;
+
+    const int warp = threadIdx.x / 32;
+    const int lane = threadIdx.x % 32;
+    const int wn = warp % WN;
+    const int wk = warp / WN;
+
+    const int kslices = k_end - k_begin;
+    const int chunk = CEIL_DIVIDE(kslices, WKK);
+    const int ks0 = k_begin + wk * chunk;
+    const size_t slice_stride = (size_t) ntiles * TWORDS;
+    const int r0 = lane >> 2;
+    const bool r0_ok = r0 < nrows;
+    const size_t a_row0 = r0_ok ? (size_t) rows[r0] * a_stride2 : 0;
+
+    const uint32_t* bp = B32 + (group * WN + wn) * GWORDS;
+    v3_stream<bits, cb, 1>(bp, slice_stride, A2, a_row0, r0_ok, chunk, k_end,
+        ks0, 0, sh_ring + warp * V3_PF * GWORDS,
+        [&] (int, float2 (&acc0)[WNT][2])
+        {
+            if (r0_ok)
+            {
+                const int c0 = 2 * (lane & 3);
+                float* red = sh_red + (wk * red_rows + r0) * TCOLS + wn * COLS;
+                #pragma unroll
+                for (int t = 0; t < WNT; ++t)
+                    #pragma unroll
+                    for (int f = 0; f < 2; ++f)
+                    {
+                        const int col = t * 16 + f * 8 + c0;
+                        red[col + 0] = acc0[t][f].x;
+                        red[col + 1] = acc0[t][f].y;
+                    }
+            }
+        });
+    __syncthreads();
+
+    for (int o = threadIdx.x; o < TCOLS * nrows; o += THREADS)
+    {
+        const int r = o / TCOLS;
+        const int c = o % TCOLS;
+        float sum = 0.0f;
+        #pragma unroll
+        for (int j = 0; j < WKK; ++j)
+            sum += sh_red[(j * red_rows + r) * TCOLS + c];
+        const size_t idx = (size_t) rows[r] * c_stride + group * TCOLS + c;
+        if (c_f32) ((float*) C)[idx] = sum;
+        else       ((half*) C)[idx] = __float2half_rn(sum);
+    }
+    __syncthreads();
+}
+
+// Mode 2, narrow down stage: the 4 narrow groups of 128-column chunk `chunk128` in one item.
+// V2 per group g: 16 k-warps vk with `chunk` slices each, partial P[vk], output = ((0 + P0) + P1) ... + P15.
+// Here warp w owns group gg = w & 3 and k-warps vk = (w >> 2) + 4q, q = 0..3. After round q the block
+// holds P[4q .. 4q + 3] of all 128 columns in sh_red ([4][ROWS][128] floats = 16 KB) and every output
+// thread adds them to its running sum in vk order.
+template <int bits, int cb>
+__device__ __forceinline__ void gemv_chunk_narrow_v3
+(
+    const uint32_t* __restrict__ B32,
+    const half2* __restrict__ A2,
+    size_t a_stride2,
+    const int* __restrict__ rows,
+    int nrows,
+    float* __restrict__ C,
+    size_t c_stride,
+    int k_begin,
+    int k_end,
+    int ntiles,
+    int chunk128,
+    float* __restrict__ sh_red,
+    uint32_t* __restrict__ sh_ring
+)
+{
+    constexpr int TWORDS = 8 * bits;
+    constexpr int GWORDS = WNT * TWORDS;
+    constexpr int GPC = 128 / COLS;                   // narrow groups per 128-column chunk
+    constexpr int NQ = WK / GPC;                      // partials per warp
+    static_assert(GPC == 4 && NQ == 4 && tile_cols<false>() == COLS, "narrow geometry");
+    static_assert(GPC * ROWS * 128 * 4 <= V3_RED_BYTES, "round buffer");
+
+    const int warp = threadIdx.x / 32;
+    const int lane = threadIdx.x % 32;
+    const int gg = warp % GPC;
+    const int vk_lo = warp / GPC;
+    const int group = chunk128 * GPC + gg;
+
+    const int kslices = k_end - k_begin;
+    const int chunk = CEIL_DIVIDE(kslices, WK);      // V2 narrow: WKK = WK = 16 k-warps
+    const size_t slice_stride = (size_t) ntiles * TWORDS;
+    const int r0 = lane >> 2;
+    const bool r0_ok = r0 < nrows;
+    const size_t a_row0 = r0_ok ? (size_t) rows[r0] * a_stride2 : 0;
+
+    // Output threads: o = threadIdx.x + 512 j, o < 128 * nrows (<= 1024)
+    float s0 = 0.0f, s1 = 0.0f;
+    const int o0 = threadIdx.x, o1 = threadIdx.x + THREADS;
+    const bool h0 = o0 < 128 * nrows, h1 = o1 < 128 * nrows;
+
+    const uint32_t* bp = B32 + group * GWORDS;
+    v3_stream<bits, cb, NQ>(bp, slice_stride, A2, a_row0, r0_ok, chunk, k_end,
+        k_begin + vk_lo * chunk, (WK / GPC) * chunk, sh_ring + warp * V3_PF * GWORDS,
+        [&] (int q, float2 (&acc0)[WNT][2])
+        {
+            if (r0_ok)
+            {
+                const int c0 = 2 * (lane & 3);
+                float* red = sh_red + (vk_lo * ROWS + r0) * 128 + gg * COLS;
+                #pragma unroll
+                for (int t = 0; t < WNT; ++t)
+                    #pragma unroll
+                    for (int f = 0; f < 2; ++f)
+                    {
+                        const int col = t * 16 + f * 8 + c0;
+                        red[col + 0] = acc0[t][f].x;
+                        red[col + 1] = acc0[t][f].y;
+                    }
+            }
+            __syncthreads();
+            #pragma unroll
+            for (int j = 0; j < GPC; ++j)             // k-warps 4q + j, in order
+            {
+                if (h0) s0 += sh_red[(j * ROWS + o0 / 128) * 128 + o0 % 128];
+                if (h1) s1 += sh_red[(j * ROWS + o1 / 128) * 128 + o1 % 128];
+            }
+            __syncthreads();
+        });
+
+    if (h0) C[(size_t) rows[o0 / 128] * c_stride + chunk128 * 128 + o0 % 128] = s0;
+    if (h1) C[(size_t) rows[o1 / 128] * c_stride + chunk128 * 128 + o1 % 128] = s1;
+    __syncthreads();
+}
+
+// Kernel A body at bsz > 1 (a_global): V2 tile_a, GEMV on the V3 stream, epilogue verbatim.
+template <int bits, int cb, bool WIDE>
+__device__ __forceinline__
+void tile_a(const MoeCoopParams& p, int item)
+{
+    constexpr int TCOLS = tile_cols<WIDE>();
+    constexpr int GPC = tile_gpc<WIDE>();
+    extern __shared__ uint32_t smem_dyn[];
+    float* sh_red = (float*) smem_dyn;
+    uint32_t* sh_ring = smem_dyn + V3_RED_BYTES / 4;
+    __shared__ int sh_last[ROWS];
+    __shared__ int sh_res[4];
+    __shared__ int sh_rows[ROWS];
+
+    const int warp = threadIdx.x / 32;
+    const int lane = threadIdx.x % 32;
+    const int nproj = p.gated ? 2 : 1;
+    const int ng = p.I / TCOLS;
+
+    const bool is_gate = p.gated && (item % nproj) == 0;
+    const int rem = item / nproj;
+    const int ks = rem % p.ksplit_a;
+    const int rem2 = rem / p.ksplit_a;
+    const int run_idx = rem2 / ng;
+    const int group = rem2 % ng;
+    int nrows = 0;
+    if (!read_run(p, run_idx, sh_rows, nrows, sh_res)) return;
+    const int local = slot_info(p, sh_rows[0]).local;
+    const int kslices_all = p.Hi / 16;
+    const int k_begin = kslices_all * ks / p.ksplit_a;
+    const int k_end = kslices_all * (ks + 1) / p.ksplit_a;
+
+    {
+        const uint32_t* B32 = (const uint32_t*) (is_gate ? p.g_trellis : p.u_trellis)[local];
+        const half2* A2 = (const half2*) (is_gate ? p.had_g : p.had_u);
+        const size_t part = (size_t) ks * (p.bsz * p.topk) * p.I * (p.gu_f32 ? 4 : 2);
+        void* C = (void*) (((char*) (is_gate ? p.gu_g : p.gu_u)) + part);
+        gemv_tile_v3<bits, cb, WIDE>(B32, A2, (size_t) p.Hi / 2, sh_rows, nrows, C, p.I, p.gu_f32,
+                                     k_begin, k_end, p.I / 16, group, sh_red, sh_ring);
+    }
+
+    // Epilogue: V2's, with the acq_rel counter arrival in place of the two block-wide fences
+    __syncthreads();
+    const int chunk = group / GPC;
+    if (threadIdx.x < nrows)
+    {
+        const int s = sh_rows[threadIdx.x];
+        sh_last[threadIdx.x] = atom_add_acq_rel_gpu(p.ctr_a + (size_t) s * (p.I / 128) + chunk, 1)
+                              == GPC * nproj * p.ksplit_a - 1;
+    }
+    __syncthreads();
+    if (warp < nrows && sh_last[warp] && !(p.dbg & 1))
+    {
+        const int s = sh_rows[warp];
+        const int col = chunk * 128 + lane * 4;
+        const size_t off = (size_t) s * p.I + col;
+        const size_t pstride = (size_t) (p.bsz * p.topk) * p.I;
+
+        auto load_sum = [&] (const void* buf, float& v0, float& v1, float& v2, float& v3)
+        {
+            v0 = v1 = v2 = v3 = 0.0f;
+            for (int q = 0; q < p.ksplit_a; ++q)
+            {
+                float t0, t1, t2, t3;
+                if (p.gu_f32) load_f4_cg(((const float*) buf) + q * pstride + off, t0, t1, t2, t3);
+                else          load_h4_cg(((const half*) buf) + q * pstride + off, t0, t1, t2, t3);
+                v0 += t0; v1 += t1; v2 += t2; v3 += t3;
+            }
+        };
+        float u0, u1, u2, u3;
+        load_sum(p.gu_u, u0, u1, u2, u3);
+        had128(u0, u1, u2, u3, lane);
+        scale_h4(((const half*) p.u_svh[local]) + col, u0, u1, u2, u3);
+        if (p.u_bias) add_h4(((const half*) p.u_bias[local]) + col, u0, u1, u2, u3);
+
+        float g0 = u0, g1 = u1, g2 = u2, g3 = u3;
+        if (p.gated)
+        {
+            load_sum(p.gu_g, g0, g1, g2, g3);
+            had128(g0, g1, g2, g3, lane);
+            scale_h4(((const half*) p.g_svh[local]) + col, g0, g1, g2, g3);
+            if (p.g_bias) add_h4(((const half*) p.g_bias[local]) + col, g0, g1, g2, g3);
+        }
+
+        float a0 = act_gate(p.act, p.gated, g0, u0, p.act_limit);
+        float a1 = act_gate(p.act, p.gated, g1, u1, p.act_limit);
+        float a2 = act_gate(p.act, p.gated, g2, u2, p.act_limit);
+        float a3 = act_gate(p.act, p.gated, g3, u3, p.act_limit);
+
+        scale_h4(((const half*) p.d_suh[local]) + col, a0, a1, a2, a3);
+        had128(a0, a1, a2, a3, lane);
+        store_h4(p.act_out + off, a0, a1, a2, a3);
+    }
+    __syncthreads();
+}
+
+// Down-stage completion of one (run, 128-column chunk) once its partial rows are stored: V2's
+// counter and last-arrival epilogue (acq_rel arrival instead of the block-wide fences). `arrivals` =
+// narrow groups this item covered (V2: 1 per item).
+template <int GPC>
+__device__ __forceinline__
+void tile_b_finish(const MoeCoopParams& p, const int* sh_rows, int nrows, int chunk, int arrivals,
+                   int* sh_last, float* sh_part, float& sh_gate)
+{
+    const int warp = threadIdx.x / 32;
+    const int lane = threadIdx.x % 32;
+    __syncthreads();
+    if (threadIdx.x < nrows)
+    {
+        const int row = sh_rows[threadIdx.x] / p.topk;
+        const int n = token_active_slots(p, row);
+        sh_last[threadIdx.x] = atom_add_acq_rel_gpu(p.ctr_b + (size_t) row * (p.Ho / 128) + chunk, arrivals)
+                              == n * GPC * p.ksplit_b - arrivals;
+    }
+    __syncthreads();
+    for (int r = 0; r < nrows; ++r)
+    {
+        if (!sh_last[r] || (p.dbg & 2)) continue;
+        const int row = sh_rows[r] / p.topk;
+        const int col = chunk * 128 + lane * 4;
+
+        // Shared-expert gate: sigmoid(x_row . w), fp32 across the block
+        if (p.sh_gate_w)
+        {
+            const half* xr = p.x + (size_t) row * p.x_stride;
+            float dot = 0.0f;
+            for (int i = threadIdx.x * 2; i < p.H; i += THREADS * 2)
+            {
+                half2 xv = *((const half2*) (xr + i));
+                half2 wv = *((const half2*) (p.sh_gate_w + i));
+                dot += __low2float(xv) * __low2float(wv) + __high2float(xv) * __high2float(wv);
+            }
+            #pragma unroll
+            for (int o = 16; o > 0; o >>= 1)
+                dot += __shfl_xor_sync(0xffffffffu, dot, o);
+            if (lane == 0) sh_part[warp] = dot;
+            __syncthreads();
+            if (threadIdx.x == 0)
+            {
+                float tt = 0.0f;
+                for (int w = 0; w < WK; ++w) tt += sh_part[w];
+                sh_gate = 1.0f / (1.0f + __expf(-tt));
+            }
+            __syncthreads();
+        }
+
+        float o0 = 0.0f, o1 = 0.0f, o2 = 0.0f, o3 = 0.0f;
+        for (int k = warp; k < p.topk; k += WK)
+        {
+            const int sk = row * p.topk + k;
+            const SlotInfo sj = slot_info(p, sk);
+            if (!sj.active) continue;
+            float v0 = 0.0f, v1 = 0.0f, v2 = 0.0f, v3 = 0.0f;
+            for (int q = 0; q < p.ksplit_b; ++q)
+            {
+                float t0, t1, t2, t3;
+                load_f4_cg(p.d_out + ((size_t) q * (p.bsz * p.topk) + sk) * p.Ho + col, t0, t1, t2, t3);
+                v0 += t0; v1 += t1; v2 += t2; v3 += t3;
+            }
+            had128(v0, v1, v2, v3, lane);
+            scale_h4(((const half*) p.d_svh[sj.local]) + col, v0, v1, v2, v3);
+            if (p.d_bias) add_h4(((const half*) p.d_bias[sj.local]) + col, v0, v1, v2, v3);
+            o0 += sj.w * v0;
+            o1 += sj.w * v1;
+            o2 += sj.w * v2;
+            o3 += sj.w * v3;
+        }
+        float* part = sh_part + warp * 128 + lane * 4;
+        part[0] = o0; part[1] = o1; part[2] = o2; part[3] = o3;
+        __syncthreads();
+        if (warp == 0)
+        {
+            o0 = 0.0f; o1 = 0.0f; o2 = 0.0f; o3 = 0.0f;
+            #pragma unroll
+            for (int w = 0; w < WK; ++w)
+            {
+                const float* q = sh_part + w * 128 + lane * 4;
+                o0 += q[0]; o1 += q[1]; o2 += q[2]; o3 += q[3];
+            }
+
+            if (p.sh_out)
+            {
+                const float gv = p.sh_gate_w ? sh_gate : 1.0f;
+                const float* sh = p.sh_out + (size_t) row * p.H + col;
+                if (col + 0 < p.H) o0 += gv * sh[0];
+                if (col + 1 < p.H) o1 += gv * sh[1];
+                if (col + 2 < p.H) o2 += gv * sh[2];
+                if (col + 3 < p.H) o3 += gv * sh[3];
+            }
+
+            float* dst = p.out + (size_t) row * p.out_stride + col;
+            if (col + 3 < p.H_out)
+                *((float4*) dst) = make_float4(o0, o1, o2, o3);
+            else
+            {
+                if (col + 0 < p.H_out) dst[0] = o0;
+                if (col + 1 < p.H_out) dst[1] = o1;
+                if (col + 2 < p.H_out) dst[2] = o2;
+            }
+        }
+        __syncthreads();
+    }
+}
+
+// Kernel B body. MERGE (mode 2, narrow tile only): one item = (ksplit, run, 128-column chunk).
+template <int bits, int cb, bool WIDE, bool MERGE>
+__device__ __forceinline__
+void tile_b(const MoeCoopParams& p, int item)
+{
+    static_assert(!(MERGE && WIDE), "merge applies to the narrow tile");
+    constexpr int TCOLS = tile_cols<WIDE>();
+    constexpr int GPC = tile_gpc<WIDE>();
+    extern __shared__ uint32_t smem_dyn[];
+    float* sh_red = (float*) smem_dyn;
+    float* sh_part = (float*) smem_dyn;                   // epilogue partials, after the GEMV barriers
+    uint32_t* sh_ring = smem_dyn + V3_RED_BYTES / 4;
+    __shared__ int sh_last[ROWS];
+    __shared__ float sh_gate;
+    __shared__ int sh_res[4];
+    __shared__ int sh_rows[ROWS];
+
+    constexpr int ITEM_COLS = MERGE ? 128 : TCOLS;
+    const int ng = p.Ho / ITEM_COLS;
+    const int ks = item % p.ksplit_b;
+    const int rem = item / p.ksplit_b;
+    const int run_idx = rem / ng;
+    const int g = rem % ng;
+    int nrows = 0;
+    if (!read_run(p, run_idx, sh_rows, nrows, sh_res)) return;
+    const int local = slot_info(p, sh_rows[0]).local;
+    const int kslices_all = p.I / 16;
+    const int k_begin = kslices_all * ks / p.ksplit_b;
+    const int k_end = kslices_all * (ks + 1) / p.ksplit_b;
+
+    const uint32_t* B32 = (const uint32_t*) p.d_trellis[local];
+    float* C = p.d_out + (size_t) ks * (p.bsz * p.topk) * p.Ho;
+    if constexpr (MERGE)
+    {
+        gemv_chunk_narrow_v3<bits, cb>(B32, (const half2*) p.act_out, (size_t) p.I / 2, sh_rows, nrows, C, p.Ho,
+                                       k_begin, k_end, p.Ho / 16, g, sh_red, sh_ring);
+        tile_b_finish<GPC>(p, sh_rows, nrows, g, GPC, sh_last, sh_part, sh_gate);
+    }
+    else
+    {
+        gemv_tile_v3<bits, cb, WIDE>(B32, (const half2*) p.act_out, (size_t) p.I / 2, sh_rows, nrows, C, p.Ho, true,
+                                     k_begin, k_end, p.Ho / 16, g, sh_red, sh_ring);
+        tile_b_finish<GPC>(p, sh_rows, nrows, g / GPC, 1, sh_last, sh_part, sh_gate);
+    }
+}
+
+// a_global only (bsz > 1); the host never launches these at bsz 1.
+template <int bits, int cb, bool WIDE>
+__global__ __launch_bounds__(THREADS, 2)   // 2 CTAs/SM: <= 64 registers, as the served kernels
+void exl3_moe_coop_v3_a_kernel(const MoeCoopParams p)
+{
+    for (int i = blockIdx.x * THREADS + threadIdx.x; i < p.ctr_b_len; i += gridDim.x * THREADS)
+        p.ctr_b[i] = 0;
+    const int count = p.runs[0] * (p.I / tile_cols<WIDE>()) * p.ksplit_a * (p.gated ? 2 : 1);
+    for (int item = blockIdx.x; item < count; item += gridDim.x)
+    {
+        tile_a<bits, cb, WIDE>(p, item);
+        __syncthreads();
+    }
+}
+
+template <int bits, int cb, bool WIDE, bool MERGE>
+__global__ __launch_bounds__(THREADS, 2)   // 2 CTAs/SM: <= 64 registers, as the served kernels
+void exl3_moe_coop_v3_b_kernel(const MoeCoopParams p)
+{
+    for (int i = blockIdx.x * THREADS + threadIdx.x; i < p.ctr_a_len; i += gridDim.x * THREADS)
+        p.ctr_a[i] = 0;
+    const int count = p.runs[0] * (p.Ho / (MERGE ? 128 : tile_cols<WIDE>())) * p.ksplit_b;
+    for (int item = blockIdx.x; item < count; item += gridDim.x)
+    {
+        tile_b<bits, cb, WIDE, MERGE>(p, item);
+        __syncthreads();
+    }
+}
