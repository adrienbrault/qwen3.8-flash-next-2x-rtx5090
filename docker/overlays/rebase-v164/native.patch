+// moefast V3 (opt-in EXL3_MOE_COOP_V3, sm_120, bsz > 1 only; the served V2 kernels are untouched).
+//
+// Served SASS (R682 cells, compiled from slotfix-r1): in gemv_tile_v2 each k-slice issues its
+// activation fragment as a generic LD (A2 may point to shared memory at bsz 1) next to the weight
+// ring prefetch for slice i + PF. ptxas puts both on one dependency scoreboard and the slice's first
+// MMA waits for it to drain, i.e. for the prefetch just issued: every k-slice pays a DRAM round trip
+// and the 4-deep register ring has an effective depth of zero.
+//
+// V3 changes where operands come from and when loads are issued, nothing else:
+//   * weights: a per-warp cp.async ring in shared memory (global -> shared, no register destination),
+//     consumed after cp.async.wait_group(V3_PF - 2) and refilled right after, so V3_PF - 1 slices
+//     are in flight while a slice is consumed. Each lane reads from the ring exactly the words V2's shuffles hand it.
+//   * activations: global loads (the pointer is always global at bsz > 1), prefetched one slice ahead
+//     and issued after the current slice's MMAs, so the only wait on them covers one slice-old loads.
+//   * mode 2, narrow down stage: the four 32-column groups of a 128-column chunk run as one item.
+//     Warp w computes V2's partials (group 4c + (w & 3), k-warp (w >> 2) + 4q) for q = 0..3, and the
+//     block keeps V2's running sum over k-warps 0..15 in order, one round of four k-warps at a time.
+//     One run-table read, one fence/counter round per 128 columns instead of four, and the weight
+//     ring runs across the warp's four partials.
+//   * completion counters (A and B, all V3 kernels): V2 has every thread run __threadfence() (SASS:
+//     MEMBAR.SC.GPU + ERRBAR + CCTL.IVALL, per warp) before and after the counter atomic. R696 ncu puts
+//     17-18 % of the r4 down kernel's stall samples on that sequence. V3 uses the CUTLASS / cooperative
+//     groups pattern instead: __syncthreads(), then the counting threads do one atom.add.acq_rel.gpu
+//     (release: the block's partial stores, ordered before it by the barrier, are visible before the
+//     count; acquire: the last arriver sees every other block's partials), then __syncthreads(). Only
+//     memory ordering changes; the values stored, read and summed are V2's.
+//
+// Every MMA sees the same operands in the same order with the same fp16 accumulator chain and the
+// same fold points, and every cross-warp fp32 sum is V2's expression in V2's order: bitwise identical
+// to V2 mode 1 (test_moefast_parity.py).
+
+#include "exl3_moe_coop_v2_kernel.cuh"
+
+namespace exl3_moe_coop_v3_ns {
+using namespace exl3_moe_coop_ns;
+using exl3_moe_coop_v2_ns::SM120_RED_ROW_BYTES;
+using exl3_moe_coop_v2_ns::SM120_PART_BYTES;
+
+constexpr int V3_PF = 4;                      // cp.async ring slots per warp (V3_PF - 1 slices ahead)
+static_assert(FOLD == 4 && PF == 4, "V3 reproduces V2's fold points for PF == FOLD == 4");
+
+template <int bits>
+__host__ __device__ constexpr int ring_words() { return WNT * 8 * bits; }          // = V2 GWORDS
+template <int bits>
+__host__ __device__ constexpr int ring_bytes() { return WK * V3_PF * ring_words<bits>() * 4; }
+
+// Dynamic smem: [V2 reduction / epilogue buffer (16 KB)][weight ring]
+constexpr int V3_RED_BYTES = ROWS * SM120_RED_ROW_BYTES > SM120_PART_BYTES ? ROWS * SM120_RED_ROW_BYTES : SM120_PART_BYTES;
+template <int bits>
+constexpr int smem_v3() { return V3_RED_BYTES + ring_bytes<bits>(); }
+
+__device__ __forceinline__ uint32_t smem_addr(const void* p)
+{
+    return (uint32_t) __cvta_generic_to_shared(p);
+}
+
+__device__ __forceinline__ void cp_async4(uint32_t dst, const void* src)
+{
+    asm volatile("cp.async.ca.shared.global [%0], [%1], 4;\n" :: "r"(dst), "l"(src) : "memory");
+}
+
+__device__ __forceinline__ void cp_async_commit()
+{
+    asm volatile("cp.async.commit_group;\n" ::: "memory");
+}
+
+template <int N>
+__device__ __forceinline__ void cp_async_wait()
+{
+    asm volatile("cp.async.wait_group %0;\n" :: "n"(N) : "memory");
+}
+
+// Counter arrival with release + acquire semantics at gpu scope; callers bracket it with __syncthreads().
+__device__ __forceinline__ int atom_add_acq_rel_gpu(int* p, int v)
+{
+    int old;
+    asm volatile("atom.add.acq_rel.gpu.global.s32 %0, [%1], %2;\n" : "=r"(old) : "l"(p), "r"(v) : "memory");
+    return old;
+}
+
+__device__ __forceinline__ half2 ld_act(const half2* p)
+{
+    uint32_t v;
+    asm volatile("ld.global.nc.b32 %0, [%1];\n" : "=r"(v) : "l"(p));
+    return *reinterpret_cast<half2*>(&v);
+}
+
+// One warp's stream of k-slices over NQ consecutive partials ("units"). Unit q covers k-slices
+// [ks0 + q * ustride, + myn(q)); only the last non-empty unit may be short (myn is non-increasing in q).
+// Weights of the whole stream flow through one cp.async ring; `unit_done(q, acc0)` is called by every
+// lane once per unit (uniformly across the block, also for empty units) with that unit's V2 partial.
+// No division or 64-bit multiply in the loop: issue and consume walk the stream with counters.
+template <int bits, int cb, int NQ, typename DONE>
+__device__ __forceinline__ void v3_stream
+(
+    const uint32_t* __restrict__ bp,            // B32 + piece * GWORDS (k-slice 0 of this column piece)
+    size_t slice_stride,
+    const half2* __restrict__ A2,               // activation rows (global), a_stride2 words per slot
+    size_t a_row0,                              // rows[lane / 4] * a_stride2 (0 when !r0_ok)
+    bool r0_ok,
+    int chunk,                                  // slices per unit (V2 chunk)
+    int k_end,
+    int ks0,                                    // first k-slice of unit 0
+    int ustride,                                // k-slices between unit starts (NQ > 1)
+    uint32_t* __restrict__ ring,                // this warp's V3_PF * GWORDS words
+    DONE unit_done
+)
+{
+    constexpr int TWORDS = 8 * bits;
+    constexpr int GWORDS = WNT * TWORDS;
+    static_assert((V3_PF & (V3_PF - 1)) == 0, "ring slots are masked");
+    const int lane = threadIdx.x % 32;
+    const half2 hzero = __half2half2(__ushort_as_half(0));
+
+    int myn_q[NQ];
+    int total = 0;
+    #pragma unroll
+    for (int q = 0; q < NQ; ++q)
+    {
+        myn_q[q] = max(0, min(chunk, k_end - (ks0 + q * ustride)));
+        total += myn_q[q];
+    }
+
+    // Issue side: lane l copies word l of each slice (K2: 32 words, K4: 64 = 2 per lane, K3: 48 =
+    // lanes < 24, two words at stride 24 = V2's LSTRIDE), so each lane later reads the words V2's
+    // shuffles gave it. One commit group per slice, empty past the end of the stream.
+    const uint32_t ring_s = smem_addr(ring) + lane * 4;
+    const uint32_t* isrc = bp + (size_t) ks0 * slice_stride + lane;
+    [[maybe_unused]] const size_t ujump = (size_t) (ustride - chunk) * slice_stride;   // unit end -> next start
+    int ileft = total;
+    int islot = 0;
+    [[maybe_unused]] int ii = 0;
+    auto issue_next = [&] ()
+    {
+        if (ileft > 0)
+        {
+            const uint32_t dst = ring_s + (uint32_t) (islot * GWORDS * 4);
+            if constexpr (GWORDS == 32)
+                cp_async4(dst, isrc);
+            else if constexpr (GWORDS == 48)
+            {
+                if (lane < 24)
+                {
+                    cp_async4(dst, isrc);
+                    cp_async4(dst + 24 * 4, isrc + 24);
+                }
+            }
+            else
+            {
+                #pragma unroll
+                for (int l = 0; l < GWORDS / 32; ++l)
+                    cp_async4(dst + l * 32 * 4, isrc + l * 32);
+            }
+            --ileft;
+            isrc += slice_stride;
+            if constexpr (NQ > 1)
+            {
+                if (++ii == chunk)
+                {
+                    ii = 0;
+                    isrc += ujump;
+                }
+            }
+        }
+        islot = (islot + 1) & (V3_PF - 1);
+        cp_async_commit();
+    };
+
+    [[maybe_unused]] int x_src_a = 0, x_src_b = 0, x_s2 = 0;
+    if constexpr (bits == 2)
+    {
+        int i1 = lane >> 1;
+        x_src_b = i1;
+        x_src_a = (i1 + 15) & 15;
+    }
+    if constexpr (bits == 3)
+    {
+        int t_offset = lane << 3;
+        int b1 = (t_offset + 257) * 3;
+        int b2 = b1 + 21;
+        int i0 = (b1 - 16) / 32;
+        int i2 = (b2 - 1) / 32;
+        x_s2 = (i2 + 1) * 32 - b2;
+        x_src_a = i0 % 24;
+        x_src_b = i2 % 24;
+    }
+
+    #pragma unroll
+    for (int d = 0; d < V3_PF - 1; ++d) issue_next();
+
+    // Activation fragment of the next slice (V2: row lane / 4, k pairs 2 (lane % 4), +8 halves)
+    const half2* arow = A2 + a_row0 + (lane & 3);
