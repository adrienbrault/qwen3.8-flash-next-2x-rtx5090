+// Local integer-only sm120 kernels use the previously measured split/tile policy.
+static int moe_coop_legacy_pick_ksplit(int max_split)
+{
+    const char* env = std::getenv("EXL3_MOE_COOP_KSPLIT");
+    const int forced = env ? atoi(env) : 0;
+    return forced > 0 ? std::min(forced, max_split) : 1;
+}
+static bool moe_coop_legacy_pick_wide(int kslices, int slots, int device)
+{
+    const int mode = moe_coop_wide_mode();
+    if (mode >= 0) return mode != 0;
+    if (DevCtx::instance().get_cc(device) < CC_BLACKWELL) return true;
+    return kslices >= 256 || (kslices >= 128 && slots >= 32) || slots >= 128;
+}
+// rows32 r3 (EXL3_MOE_COOP_ROWS32, read per launch like V2 / V3; unset = 16, the served cap). With it on, a
+// 17-32-row call takes the same V2/V3 launch as a 13-16-row one: one rotation, one A and one B launch over
+// all slots, so each expert's weights are read once per run of <= ROWS slots instead of once per 16-row
+// span. Nothing in the kernels is 16-row specific: the run table has one thread per slot (MAX_SLOTS 512 >=
+// 32 x top-10), counters and slot scratch come from the caller and are checked in exl3_moe_coop_run. At
+// >= 13 rows x top-10 both stages pick the wide tile, the geometry every row of a served 16-row call gets,
+// and a row's arithmetic depends only on its own slots (MMA rows are independent; the down reduction sums a
+// row's slots in slot order), so each row is bitwise the row a 16-row call computes (test_rows32_parity.py)
+// rows32 r4 (stack-r3): moefast r3's mode 3 (EXL3_MOE_COOP_V3=3, r2 kernels) never runs above 16 rows: its
+// block-local run table holds R2_MAX_ROWS 16 rows / R2_MAX_SLOTS 192 slots, so moe_coop_r2_launch declines a
+// 17-32-row call and the launcher runs mode 2 (the V3 kernels). The served rows32 env pins that explicitly with
+// EXL3_MOE_COOP_V3_MAP=...,17-32:2; both routes launch the same kernels (test_rows32_parity.py dispatch)
+int exl3_moe_coop_rows_cap()
+{
+    const char* env = std::getenv("EXL3_MOE_COOP_ROWS32");
+    if (!env || !std::strcmp(env, "0")) return 16;
+    TORCH_CHECK(!std::strcmp(env, "1"), "EXL3_MOE_COOP_ROWS32 must be 0 or 1");
+    return 32;
+}
+
+// Read per launch so tests can compare OFF/ON in one process. A captured graph
+// keeps the mode selected at capture, as it keeps every other launch parameter.
+static int moe_coop_v2_mode()
+{
+    const char* env = std::getenv("EXL3_MOE_COOP_V2");
+    if (!env || !std::strcmp(env, "0")) return 0;
+    TORCH_CHECK(!std::strcmp(env, "1") || !std::strcmp(env, "2"), "EXL3_MOE_COOP_V2 must be 0, 1 or 2");
+    return env[0] - '0';
+}
+
+static MoeCoopKernel moe_coop_v2_kernel(int K, int cb, int Hi, bool wide, bool global, bool a)
+{
+    #define V2_CASE(k) case k: return a ? exl3_moe_coop_v2_a_k##k(cb, Hi, wide, global) : exl3_moe_coop_v2_b_k##k(cb, wide, global)
+    switch (K)
+    {
+        V2_CASE(1); V2_CASE(2); V2_CASE(3); V2_CASE(4);
+        V2_CASE(5); V2_CASE(6); V2_CASE(7); V2_CASE(8);
+        default: TORCH_CHECK(false, "exl3_moe_coop_v2: K out of range");
+    }
+    #undef V2_CASE
+}
+
+// moefast V3 (EXL3_MOE_COOP_V3, read per launch like V2): 1 = weight cp.async ring + one-slice activation
+// prefetch in both stages; 2 = 1 plus the narrow down stage merged per 128-column chunk (moefast r1);
+// 3 = r2 (exl3_moe_coop_r2_kernel.cuh: block-local run table, no rotation kernel, staged activations,
+// evict-first weight copies; falls back to 2 where its preconditions fail). Applies only on top of V2
+// (same geometry), at bsz > 1, for K = 2, 3, 4; everything else keeps the V2 kernels. Bitwise identical
+// to V2 by construction.
+// EXL3_MOE_COOP_V3_MAP (optional) picks the mode per launch shape: comma-separated "lo-hi:m" or "n:m"
+// on the token row count (bsz), first match wins, rows not listed use EXL3_MOE_COOP_V3; m = 0 keeps V2.
+// E.g. "2-4:0,5-16:3" = V2 at up to 4 rows, r2 above. Decided from the launch shape only.
+static int moe_coop_v3_mode(int bsz)
+{
+    const char* env = std::getenv("EXL3_MOE_COOP_V3");
+    int mode = 0;
+    if (env && std::strcmp(env, "0"))
+    {
+        TORCH_CHECK(env[0] >= '1' && env[0] <= '3' && env[1] == 0, "EXL3_MOE_COOP_V3 must be 0, 1, 2 or 3");
+        mode = env[0] - '0';
+    }
+    const char* map = std::getenv("EXL3_MOE_COOP_V3_MAP");
+    if (map && *map)
+    {
+        const char* q = map;
+        while (*q)
+        {
+            char* end = nullptr;
+            const long lo = std::strtol(q, &end, 10);
+            TORCH_CHECK(end != q, "EXL3_MOE_COOP_V3_MAP: expected lo-hi:mode entries, got ", map);
+            long hi = lo;
+            if (*end == '-')
+            {
+                q = end + 1;
+                hi = std::strtol(q, &end, 10);
+                TORCH_CHECK(end != q, "EXL3_MOE_COOP_V3_MAP: expected lo-hi:mode entries, got ", map);
+            }
+            TORCH_CHECK(end[0] == ':' && end[1] >= '0' && end[1] <= '3', "EXL3_MOE_COOP_V3_MAP: expected lo-hi:mode entries (mode 0-3), got ", map);
+            if (bsz >= lo && bsz <= hi) return end[1] - '0';
+            q = end + 2;
+            TORCH_CHECK(*q == ',' || *q == 0, "EXL3_MOE_COOP_V3_MAP: entries are comma separated, got ", map);
+            if (*q == ',') ++q;
+        }
+    }
+    return mode;
+}
+
+static MoeCoopKernel moe_coop_v3_kernel(int K, int cb, bool wide, bool a, bool merge)
+{
+    switch (K)
+    {
+        case 2: return a ? exl3_moe_coop_v3_a_k2(cb, wide) : exl3_moe_coop_v3_b_k2(cb, wide, merge);
+        case 3: return a ? exl3_moe_coop_v3_a_k3(cb, wide) : exl3_moe_coop_v3_b_k3(cb, wide, merge);
+        case 4: return a ? exl3_moe_coop_v3_a_k4(cb, wide) : exl3_moe_coop_v3_b_k4(cb, wide, merge);
+        default: TORCH_CHECK(false, "exl3_moe_coop_v3: K out of range");
+    }
+}
+
+static MoeCoopKernel moe_coop_r2_kernel(int K, int cb, bool wide, bool a)
+{
+    switch (K)
+    {
+        case 2: return a ? exl3_moe_coop_r2_a_k2(cb, wide) : exl3_moe_coop_r2_b_k2(cb, wide);
+        case 3: return a ? exl3_moe_coop_r2_a_k3(cb, wide) : exl3_moe_coop_r2_b_k3(cb, wide);
+        case 4: return a ? exl3_moe_coop_r2_a_k4(cb, wide) : exl3_moe_coop_r2_b_k4(cb, wide);
+        default: TORCH_CHECK(false, "exl3_moe_coop_r2: K out of range");
+    }
+}
+
+static int moe_coop_v2_grid(const MoeCoopKernel& k, int base, int slots, int device)
+{
+    using namespace exl3_moe_coop_v2_ns;
+    // Compiler register allocation is unknown until build. Query actual occupancy,
+    // including static + dynamic shared memory, once per device/kernel/smem tuple.
+    using Key = std::tuple<int, void*, int>;
+    static thread_local std::map<Key, int> capacity;
+    const Key key(device, k.kernel, k.smem);
+    auto it = capacity.find(key);
+    if (it == capacity.end())
+    {
+        int resident = 0, sms = 0;
+        cuda_check(cudaOccupancyMaxActiveBlocksPerMultiprocessor(&resident, k.kernel, MOE_COOP_THREADS, k.smem));
+        cuda_check(cudaDeviceGetAttribute(&sms, cudaDevAttrMultiProcessorCount, device));
+        TORCH_CHECK(resident > 0, "exl3_moe_coop_v2: kernel cannot reside");
+        it = capacity.emplace(key, sms * resident).first;
+    }
+    const int waves = slots < SM120_BUSY_SLOTS ? SM120_SMALL_WAVES : SM120_LARGE_WAVES;
+    return std::min(base, it->second * waves);
+}
+
+static void moe_coop_v2_launch
+(
+    MoeCoopParams p, int K_gu, int K_d, int cb, int device, cudaStream_t stream, int mode,
+    cudaEvent_t wait_before_b, int v3 = 0
+)
+{
+    using namespace exl3_moe_coop_v2_ns;
+    const int slots = p.bsz * p.topk;
+    const int nproj = p.gated ? 2 : 1;
+    p.a_global = p.bsz > 1;
+    // Mode 1 MUST use precisely the OFF geometry: geometry changes fp16 folds and
+    // fp32 partial sums. Mode 2 experiments with the supplied R421 high-slot rule.
+    const bool wide_a = moe_coop_legacy_pick_wide(p.Hi / 16, slots, device);
+    const bool wide_b = moe_coop_legacy_pick_wide(p.I / 16, slots, device) ||
+        (mode == 2 && moe_coop_wide_mode() < 0 && slots >= SM120_EXPERIMENTAL_WIDE_B_SLOTS);
+    const int max_split = std::max(1, p.slots_max / slots);
+    p.ksplit_a = p.ksplit_b = moe_coop_legacy_pick_ksplit(max_split);
+    const bool merge_b = v3 == 2 && !wide_b;
+    MoeCoopKernel ka = v3 ? moe_coop_v3_kernel(K_gu, cb, wide_a, true, false)
+                          : moe_coop_v2_kernel(K_gu, cb, p.Hi, wide_a, p.a_global, true);
+    MoeCoopKernel kb = v3 ? moe_coop_v3_kernel(K_d, cb, wide_b, false, merge_b)
+                          : moe_coop_v2_kernel(K_d, cb, p.Hi, wide_b, p.a_global, false);
+    moe_coop_smem_optin(ka.kernel, ka.smem);
+    moe_coop_smem_optin(kb.kernel, kb.smem);
+    const int grid_a = moe_coop_v2_grid(ka, slots * nproj * (p.I / (wide_a ? 128 : MOE_COOP_COLS)) * p.ksplit_a, slots, device);
+    const int grid_b = moe_coop_v2_grid(kb, slots * (p.Ho / (wide_b || merge_b ? 128 : MOE_COOP_COLS)) * p.ksplit_b, slots, device);
+    void* args[] = { (void*) &p };
+    if (p.a_global)
+    {
+        const int rot_items = slots * (p.Hi / 128) * nproj;
+        const int rot_grid = CEIL_DIVIDE(rot_items, MOE_COOP_THREADS / 32);
+        exl3_moe_coop_ns::exl3_moe_coop_rot_kernel<<<rot_grid, MOE_COOP_THREADS, 0, stream>>>(p);
+    }
+    cuda_check(cudaLaunchKernel(ka.kernel, dim3(grid_a), dim3(MOE_COOP_THREADS), args, ka.smem, stream));
+    if (wait_before_b) cuda_check(cudaStreamWaitEvent(stream, wait_before_b, 0));
+    cuda_check(cudaLaunchKernel(kb.kernel, dim3(grid_b), dim3(MOE_COOP_THREADS), args, kb.smem, stream));
+    cuda_check(cudaPeekAtLastError());
+}
+
+// Residency of a kernel at a dynamic smem size (blocks per SM), cached per device/kernel/smem
+static int moe_coop_resident(void* kernel, int smem, int device)
+{
+    using Key = std::tuple<int, void*, int>;
+    static thread_local std::map<Key, int> cache;
+    const Key key(device, kernel, smem);
+    auto it = cache.find(key);
+    if (it != cache.end()) return it->second;
+    int resident = 0;
+    if (cudaOccupancyMaxActiveBlocksPerMultiprocessor(&resident, kernel, MOE_COOP_THREADS, smem) != cudaSuccess)
+    {
+        (void) cudaGetLastError();
+        resident = 0;
+    }
+    cache.emplace(key, resident);
+    return resident;
+}
+
+// moefast r3 diagnostic (EXL3_MOE_COOP_V3_HEAD=<ns>, read per launch, mode 3 only): one 32-thread block on the
+// current stream right before r2's kernel A that exits after <ns> nanoseconds of %globaltimer (1 = no spin, just a
+// launch). It stands in for r1's rotation kernel, whose ~3.6 us before kernel A was the window in which the
+// side-stream shared expert's cooperative GEMM got SMs (R703b nsys). No data is touched; unset/0 = not launched.
+namespace exl3_moe_coop_r2_ns {
+__global__ void exl3_moe_coop_r2_head_kernel(unsigned int ns)
+{
+    if (ns <= 1) return;
+    unsigned long long t0, t;
+    asm volatile("mov.u64 %0, %%globaltimer;" : "=l"(t0));
+    do { asm volatile("mov.u64 %0, %%globaltimer;" : "=l"(t)); } while (t - t0 < ns);
+}
+}
+
+static unsigned int moe_coop_r3_head_ns()
+{
+    const char* env = std::getenv("EXL3_MOE_COOP_V3_HEAD");
+    if (!env || !*env) return 0;
+    char* end = nullptr;
+    const long v = std::strtol(env, &end, 10);
+    TORCH_CHECK(end != env && *end == 0 && v >= 0 && v <= 100000, "EXL3_MOE_COOP_V3_HEAD must be 0..100000 (ns)");
+    return (unsigned int) v;
+}
+
+// moefast r2 (mode 3). Returns false, launching nothing, when a precondition fails; the caller then runs
+// mode 2. Preconditions: ksplit 1, bsz * topk within the block-local run table, kernel A holding at least
+// one staged row and kernel B its ROWS staged rows at 2 CTAs/SM (the V2/V3 residency).
+static bool moe_coop_r2_launch
+(
+    MoeCoopParams p, int K_gu, int K_d, int cb, int device, cudaStream_t stream, int mode,
+    cudaEvent_t wait_before_b
+)
+{
+    using namespace exl3_moe_coop_v2_ns;
+    using namespace exl3_moe_coop_r2_ns;
+    const int slots = p.bsz * p.topk;
+    const int nproj = p.gated ? 2 : 1;
+    if (slots > R2_MAX_SLOTS || p.bsz > R2_MAX_ROWS || p.bsz < 2) return false;
+    // Kernel A copies x rows in 16-byte pieces
+    if ((reinterpret_cast<uintptr_t>(p.x) & 15) || (p.x_stride & 7)) return false;
+    const int max_split = std::max(1, p.slots_max / slots);
+    if (moe_coop_legacy_pick_ksplit(max_split) != 1) return false;
+    p.a_global = true;
+    p.ksplit_a = p.ksplit_b = 1;
+    const bool wide_a = moe_coop_legacy_pick_wide(p.Hi / 16, slots, device);
+    const bool wide_b = moe_coop_legacy_pick_wide(p.I / 16, slots, device) ||
+        (mode == 2 && moe_coop_wide_mode() < 0 && slots >= SM120_EXPERIMENTAL_WIDE_B_SLOTS);
+    MoeCoopKernel ka = moe_coop_r2_kernel(K_gu, cb, wide_a, true);
+    MoeCoopKernel kb = moe_coop_r2_kernel(K_d, cb, wide_b, false);
+
+    MoeCoopR2Args a2 = {};
+    const int ring_a = WK * V3_PF * (WNT * 8 * K_gu) * 4;
+    for (int rows = ROWS; rows >= 1; --rows)
+    {
+        const int region = std::max(rows * stage_row_bytes(p.Hi), (int) V3_RED_BYTES);
+        if (moe_coop_resident(ka.kernel, region + ring_a, device) >= 2)
+        {
+            a2.a_rows_fit = rows;
+            a2.a_region_bytes = region;
+            break;
+        }
+    }
+    if (!a2.a_rows_fit) return false;
+    ka.smem = a2.a_region_bytes + ring_a;
+    kb.smem = V3_RED_BYTES + WK * V3_PF * (WNT * 8 * K_d) * 4 + ROWS * stage_row_bytes(p.I);
+    if (moe_coop_resident(kb.kernel, kb.smem, device) < 2) return false;
+    {
+        const char* ef = std::getenv("EXL3_MOE_COOP_V3_L2EF");
+        a2.l2ef = (ef && !std::strcmp(ef, "0")) ? 0 : 1;
