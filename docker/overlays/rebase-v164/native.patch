+// Dynamic smem of kernel B: [reduction / epilogue 16 KB][weight ring][ROWS staged act_out rows]
+template <int bits>
+__host__ __device__ constexpr int smem_r2_b(int I) { return V3_RED_BYTES + ring_bytes<bits>() + ROWS * stage_row_bytes(I); }
+
+template <int bits, int cb, bool WIDE>
+__device__ __forceinline__
+void tile_b_r2(const MoeCoopParams& p, const MoeCoopR2Args& a, const R2Runs& sb, const R2SlotsB& xb, int item, int next,
+               R2ItemPtr* iptr, int buf, int* sh_rows, int* sh_last, float& sh_gate)
+{
+    constexpr bool MERGE = !WIDE;
+    extern __shared__ uint32_t smem_dyn[];
+    float* sh_red = (float*) smem_dyn;
+    float* sh_part = (float*) smem_dyn;
+    uint32_t* sh_ring = smem_dyn + V3_RED_BYTES / 4;
+    const uint32_t stage_s = smem_addr(smem_dyn) + V3_RED_BYTES + ring_bytes<bits>();
+
+    const int ng = p.Ho / 128;
+    const int run_idx = item / ng;
+    const int g = item % ng;
+    const int nrows = r2_run_rows(sb, run_idx, sh_rows);
+    const uint32_t* B32 = (const uint32_t*) iptr[buf].p[0];
+    if (next >= 0 && threadIdx.x == 0)
+    {
+        r2_b_item_ptr(p, sb, next, iptr[buf ^ 1], true);
+        cp_async_commit();
+    }
+
+    // act_out rows -> shared (16-byte cp.async.cg: L2, written by kernel A), one commit group per thread
+    const int row_b = stage_row_bytes(p.I);
+    const int cpr = p.I * 2 / 16;
+    for (int j = threadIdx.x; j < nrows * cpr; j += THREADS)
+    {
+        const int r = j / cpr;
+        const int c = j % cpr;
+        cp_async16_cg(stage_s + (uint32_t) (r * row_b + c * 16), p.act_out + (size_t) sh_rows[r] * p.I + c * 8);
+    }
+    cp_async_commit();
+    auto pre = [&] ()
+    {
+        // The staging group is older than the V3_PF - 1 ring groups issued just before
+        cp_async_wait<V3_PF - 1>();
+        __syncthreads();
+    };
