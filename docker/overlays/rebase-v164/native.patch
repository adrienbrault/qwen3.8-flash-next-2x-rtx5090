+// V2 gemv_tile_v2 on the r2 stream, ksplit 1 (k-slices 0 .. kslices). Staged rows are the item's rows
+// (row r at stage_s + r * stage_row). ALIAS: sh_red overlaps the staging, so partials wait for every warp.
+template <int bits, int cb, bool WIDE, bool ALIAS, typename PRE>
+__device__ __forceinline__ void gemv_tile_r2
+(
+    const uint32_t* __restrict__ B32,
+    uint32_t stage_s,
+    int stage_row,
+    const int* __restrict__ rows,
+    int nrows,
+    void* __restrict__ C,
+    size_t c_stride,
+    bool c_f32,
+    int kslices,
+    int ntiles,
+    int group,
+    float* __restrict__ sh_red,
+    uint32_t* __restrict__ sh_ring,
+    bool ef,
+    PRE pre
+)
+{
+    constexpr int TWORDS = 8 * bits;
+    constexpr int GWORDS = WNT * TWORDS;
+    constexpr int WN = tile_wn<WIDE>();
+    constexpr int WKK = tile_wk<WIDE>();
+    constexpr int TCOLS = tile_cols<WIDE>();
+    constexpr int red_rows = ROWS;
+
+    const int warp = threadIdx.x / 32;
+    const int lane = threadIdx.x % 32;
+    const int wn = warp % WN;
+    const int wk = warp / WN;
+
+    const int chunk = CEIL_DIVIDE(kslices, WKK);
+    const int ks0 = wk * chunk;
+    const size_t slice_stride = (size_t) ntiles * TWORDS;
+    const int r0 = lane >> 2;
+    const bool r0_ok = r0 < nrows;
+    const uint32_t act_s = stage_s + (uint32_t) (r0 * stage_row + (lane & 3) * 4);
+
+    const uint32_t* bp = B32 + (group * WN + wn) * GWORDS;
+    r2_stream<bits, cb, 1>(bp, slice_stride, act_s, r0_ok, chunk, kslices,
+        ks0, 0, sh_ring + warp * V3_PF * GWORDS, ef, pre,
+        [&] (int, float2 (&acc0)[WNT][2])
+        {
+            if constexpr (ALIAS) __syncthreads();       // every warp is past its last staged-row read
+            if (r0_ok)
+            {
+                const int c0 = 2 * (lane & 3);
+                float* red = sh_red + (wk * red_rows + r0) * TCOLS + wn * COLS;
+                #pragma unroll
+                for (int t = 0; t < WNT; ++t)
+                    #pragma unroll
+                    for (int f = 0; f < 2; ++f)
+                    {
+                        const int col = t * 16 + f * 8 + c0;
+                        red[col + 0] = acc0[t][f].x;
+                        red[col + 1] = acc0[t][f].y;
+                    }
+            }
+        });
+    __syncthreads();
+
+    for (int o = threadIdx.x; o < TCOLS * nrows; o += THREADS)
+    {
+        const int r = o / TCOLS;
+        const int c = o % TCOLS;
+        float sum = 0.0f;
+        #pragma unroll
+        for (int j = 0; j < WKK; ++j)
+            sum += sh_red[(j * red_rows + r) * TCOLS + c];
+        const size_t idx = (size_t) rows[r] * c_stride + group * TCOLS + c;
+        if (c_f32) ((float*) C)[idx] = sum;
+        else       ((half*) C)[idx] = __float2half_rn(sum);
+    }
+    __syncthreads();
+}
+
+// r1's gemv_chunk_narrow_v3 (mode 2 merge) on the r2 stream: same unit assignment and round sums.
+template <int bits, int cb, typename PRE>
+__device__ __forceinline__ void gemv_chunk_narrow_r2
+(
+    const uint32_t* __restrict__ B32,
+    uint32_t stage_s,
+    int stage_row,
+    const int* __restrict__ rows,
+    int nrows,
+    float* __restrict__ C,
+    size_t c_stride,
+    int kslices,
+    int ntiles,
+    int chunk128,
+    float* __restrict__ sh_red,
+    uint32_t* __restrict__ sh_ring,
+    bool ef,
+    PRE pre
+)
+{
+    constexpr int TWORDS = 8 * bits;
+    constexpr int GWORDS = WNT * TWORDS;
+    constexpr int GPC = 128 / COLS;
+    constexpr int NQ = WK / GPC;
+    static_assert(GPC == 4 && NQ == 4 && tile_cols<false>() == COLS, "narrow geometry");
+    static_assert(GPC * ROWS * 128 * 4 <= V3_RED_BYTES, "round buffer");
+
+    const int warp = threadIdx.x / 32;
+    const int lane = threadIdx.x % 32;
+    const int gg = warp % GPC;
+    const int vk_lo = warp / GPC;
+    const int group = chunk128 * GPC + gg;
+
+    const int chunk = CEIL_DIVIDE(kslices, WK);
+    const size_t slice_stride = (size_t) ntiles * TWORDS;
+    const int r0 = lane >> 2;
+    const bool r0_ok = r0 < nrows;
+    const uint32_t act_s = stage_s + (uint32_t) (r0 * stage_row + (lane & 3) * 4);
+
+    float s0 = 0.0f, s1 = 0.0f;
+    const int o0 = threadIdx.x, o1 = threadIdx.x + THREADS;
+    const bool h0 = o0 < 128 * nrows, h1 = o1 < 128 * nrows;
+
+    const uint32_t* bp = B32 + group * GWORDS;
+    r2_stream<bits, cb, NQ>(bp, slice_stride, act_s, r0_ok, chunk, kslices,
+        vk_lo * chunk, (WK / GPC) * chunk, sh_ring + warp * V3_PF * GWORDS, ef, pre,
+        [&] (int q, float2 (&acc0)[WNT][2])
+        {
+            if (r0_ok)
+            {
+                const int c0 = 2 * (lane & 3);
+                float* red = sh_red + (vk_lo * ROWS + r0) * 128 + gg * COLS;
+                #pragma unroll
+                for (int t = 0; t < WNT; ++t)
+                    #pragma unroll
+                    for (int f = 0; f < 2; ++f)
+                    {
+                        const int col = t * 16 + f * 8 + c0;
+                        red[col + 0] = acc0[t][f].x;
+                        red[col + 1] = acc0[t][f].y;
+                    }
+            }
+            __syncthreads();
+            #pragma unroll
+            for (int j = 0; j < GPC; ++j)
+            {
+                if (h0) s0 += sh_red[(j * ROWS + o0 / 128) * 128 + o0 % 128];
+                if (h1) s1 += sh_red[(j * ROWS + o1 / 128) * 128 + o1 % 128];
+            }
+            __syncthreads();
+        });
+
+    if (h0) C[(size_t) rows[o0 / 128] * c_stride + chunk128 * 128 + o0 % 128] = s0;
+    if (h1) C[(size_t) rows[o1 / 128] * c_stride + chunk128 * 128 + o1 % 128] = s1;
+    __syncthreads();
+}
+
+// x rows -> shared, zero-filled from H to Hi (V2's rotate_chunk padding), one 16-byte cp.async.cg each
+__device__ __forceinline__ void r2_stage_x(const MoeCoopParams& p, const int* rows, int nrows, uint32_t stage_s, int row_b)
+{
+    const int cpr = p.Hi * 2 / 16;
+    for (int j = threadIdx.x; j < nrows * cpr; j += THREADS)
+    {
+        const int r = j / cpr;
+        const int c = j % cpr;
+        const half* xr = p.x + (size_t) (rows[r] / p.topk) * p.x_stride;
+        const int valid = min(max(p.H - c * 8, 0), 8) * 2;
+        const uint32_t dst = stage_s + (uint32_t) (r * row_b + c * 16);
+        asm volatile("cp.async.cg.shared.global [%0], [%1], 16, %2;\n"
+                     :: "r"(dst), "l"(valid ? (const void*) (xr + c * 8) : (const void*) xr), "r"(valid) : "memory");
+    }
+}
+
+// V2's rotate_chunk on the staged rows, in place: warp w owns 128-chunks c = w, w + WK, ...; the chunk's
+// suh words are loaded once per warp (before the wait on the x copies) and applied to every row of the
+// run. Same float ops as rotate_chunk: x * suh, had128, half rn.
+__device__ __forceinline__ void r2_rotate_staged(const MoeCoopParams& p, int nrows, const half* suh, char* stage,
+                                                 int row_b, int warp, int lane)
+{
+    const int chunks = p.Hi / 128;
+    uint2 su0 = make_uint2(0, 0), su1 = make_uint2(0, 0);
+    if (warp < chunks)      su0 = *((const uint2*) (suh + warp * 128 + lane * 4));
+    if (warp + WK < chunks) su1 = *((const uint2*) (suh + (warp + WK) * 128 + lane * 4));
+    cp_async_wait<V3_PF - 1>();              // this thread's x copies (older than the V3_PF - 1 ring groups)
+    __syncthreads();                         // everyone's
+    for (int c = warp; c < chunks; c += WK)
+    {
+        uint2 su = c == warp ? su0 : c == warp + WK ? su1 : *((const uint2*) (suh + c * 128 + lane * 4));
+        float s0, s1, s2, s3;
+        unpack_h4(su, s0, s1, s2, s3);
+        for (int r = 0; r < nrows; ++r)
+        {
+            half* dst = (half*) (stage + (size_t) r * row_b) + c * 128 + lane * 4;
+            float v0, v1, v2, v3;
+            unpack_h4(*((const uint2*) dst), v0, v1, v2, v3);
+            v0 *= s0; v1 *= s1; v2 *= s2; v3 *= s3;
+            had128(v0, v1, v2, v3, lane);
+            __syncwarp();                    // every lane has read the chunk before any lane overwrites it
+            store_h4(dst, v0, v1, v2, v3);
+        }
+    }
+    __syncthreads();
+}
+
+// Item pointers, double-buffered: [0] weights (trellis), [1] kernel A's input sign vector (suh)
+struct R2ItemPtr
+{
+    const void* p[2];
+};
+
+// ---------------------------------------------------------------------------------------------
+// Kernel A (gate/up + activation epilogue). Items as V2 at ksplit 1: item = (run * ng + group) * nproj + proj
+
+template <int bits, int cb, bool WIDE>
+__device__ __forceinline__ void r2_a_item_ptrs(const MoeCoopParams& p, const R2Runs& sb, int item, R2ItemPtr& dst, bool async)
+{
+    constexpr int TCOLS = tile_cols<WIDE>();
+    const int nproj = p.gated ? 2 : 1;
+    const int ng = p.I / TCOLS;
+    const bool is_gate = p.gated && (item % nproj) == 0;
+    const int run_idx = (item / nproj) / ng;
+    const int local = sb.local[sb.order[sb.start[run_idx]]];
+    const int64_t* table = threadIdx.x == 0 ? (is_gate ? p.g_trellis : p.u_trellis)
+                                            : (is_gate ? p.g_suh : p.u_suh);
+    if (async) cp_async8(smem_addr(&dst.p[threadIdx.x]), table + local);
+    else       dst.p[threadIdx.x] = (const void*) table[local];
+}
+
+template <int bits, int cb, bool WIDE>
+__device__ __forceinline__
+void tile_a_r2(const MoeCoopParams& p, const MoeCoopR2Args& a, const R2Runs& sb, int item, int next,
+               R2ItemPtr* iptr, int buf, int* sh_rows, int* sh_last)
+{
+    constexpr int TCOLS = tile_cols<WIDE>();
+    constexpr int GPC = tile_gpc<WIDE>();
+    extern __shared__ uint32_t smem_dyn[];
+    float* sh_red = (float*) smem_dyn;                                 // aliases the staged rows
+    const uint32_t stage_s = smem_addr(smem_dyn);
+    half* stage_h = (half*) smem_dyn;
+    uint32_t* sh_ring = smem_dyn + a.a_region_bytes / 4;
+
+    const int warp = threadIdx.x / 32;
+    const int lane = threadIdx.x % 32;
+    const int nproj = p.gated ? 2 : 1;
+    const int ng = p.I / TCOLS;
+    const bool is_gate = p.gated && (item % nproj) == 0;
+    const int rem = item / nproj;
+    const int run_idx = rem / ng;
+    const int group = rem % ng;
+    const int nrows = r2_run_rows(sb, run_idx, sh_rows);
+    const int local = sb.local[sh_rows[0]];
+
+    const uint32_t* B32 = (const uint32_t*) iptr[buf].p[0];
+    const half* suh = (const half*) iptr[buf].p[1];
+    // Next item's pointers: the oldest cp.async group of threads 0, 1 (complete long before it is used)
+    if (next >= 0 && threadIdx.x < 2)
+    {
+        r2_a_item_ptrs<bits, cb, WIDE>(p, sb, next, iptr[buf ^ 1], true);
+        cp_async_commit();
+    }
+
+    const int row_b = stage_row_bytes(p.Hi);
+    void* C = is_gate ? p.gu_g : p.gu_u;
+    for (int off = 0; off < nrows; off += a.a_rows_fit)
+    {
+        const int np = min(a.a_rows_fit, nrows - off);
+        r2_stage_x(p, sh_rows + off, np, stage_s, row_b);
+        cp_async_commit();
+        gemv_tile_r2<bits, cb, WIDE, true>(B32, stage_s, row_b, sh_rows + off, np, C, p.I, p.gu_f32,
+            p.Hi / 16, p.I / 16, group, sh_red, sh_ring, a.l2ef != 0,
+            [&] ()
+            {
+                // V2's rotation kernel for this item's rows and projection, in shared memory
+                r2_rotate_staged(p, np, suh, (char*) stage_h, row_b, warp, lane);
+            });
+    }
+
+    // Epilogue: r1's (V2's with the acq_rel counter arrival)
+    const int chunk = group / GPC;
+    if (threadIdx.x < nrows)
+    {
+        const int s = sh_rows[threadIdx.x];
+        sh_last[threadIdx.x] = atom_add_acq_rel_gpu(p.ctr_a + (size_t) s * (p.I / 128) + chunk, 1)
+                              == GPC * nproj * p.ksplit_a - 1;
+    }
+    __syncthreads();
+    if (warp < nrows && sh_last[warp] && !(p.dbg & 1))
+    {
+        const int s = sh_rows[warp];
+        const int col = chunk * 128 + lane * 4;
+        const size_t off = (size_t) s * p.I + col;
+        const size_t pstride = (size_t) (p.bsz * p.topk) * p.I;
+
+        // V2's load_sum verbatim (the host runs r2 at ksplit 1 only; the loop form keeps 0 + x as V2)
+        auto load_sum = [&] (const void* buf_, float& v0, float& v1, float& v2, float& v3)
+        {
+            v0 = v1 = v2 = v3 = 0.0f;
+            for (int q = 0; q < p.ksplit_a; ++q)
+            {
+                float t0, t1, t2, t3;
+                if (p.gu_f32) load_f4_cg(((const float*) buf_) + q * pstride + off, t0, t1, t2, t3);
+                else          load_h4_cg(((const half*) buf_) + q * pstride + off, t0, t1, t2, t3);
+                v0 += t0; v1 += t1; v2 += t2; v3 += t3;
+            }
+        };
+        float u0, u1, u2, u3;
+        load_sum(p.gu_u, u0, u1, u2, u3);
+        had128(u0, u1, u2, u3, lane);
+        scale_h4(((const half*) p.u_svh[local]) + col, u0, u1, u2, u3);
+        if (p.u_bias) add_h4(((const half*) p.u_bias[local]) + col, u0, u1, u2, u3);
+
+        float g0 = u0, g1 = u1, g2 = u2, g3 = u3;
+        if (p.gated)
+        {
+            load_sum(p.gu_g, g0, g1, g2, g3);
+            had128(g0, g1, g2, g3, lane);
+            scale_h4(((const half*) p.g_svh[local]) + col, g0, g1, g2, g3);
+            if (p.g_bias) add_h4(((const half*) p.g_bias[local]) + col, g0, g1, g2, g3);
+        }
+
+        float a0 = act_gate(p.act, p.gated, g0, u0, p.act_limit);
+        float a1 = act_gate(p.act, p.gated, g1, u1, p.act_limit);
+        float a2 = act_gate(p.act, p.gated, g2, u2, p.act_limit);
+        float a3 = act_gate(p.act, p.gated, g3, u3, p.act_limit);
+
+        scale_h4(((const half*) p.d_suh[local]) + col, a0, a1, a2, a3);
+        had128(a0, a1, a2, a3, lane);
+        store_h4(p.act_out + off, a0, a1, a2, a3);
+    }
+    __syncthreads();
+}
+
+template <int bits, int cb, bool WIDE>
+__global__ __launch_bounds__(THREADS, 2)
+void exl3_moe_coop_r2_a_kernel(const MoeCoopParams p, const MoeCoopR2Args a)
+{
+    __shared__ R2Runs sb;
+    __shared__ R2ItemPtr iptr[2];
+    __shared__ int sh_rows[ROWS];
+    __shared__ int sh_last[ROWS];
+
+    for (int i = blockIdx.x * THREADS + threadIdx.x; i < p.ctr_b_len; i += gridDim.x * THREADS)
+        p.ctr_b[i] = 0;
+    r2_build(p, sb, nullptr);
+    const int count = sb.n_runs * (p.I / tile_cols<WIDE>()) * (p.gated ? 2 : 1);
+    if ((int) blockIdx.x >= count) return;
+    if (threadIdx.x < 2) r2_a_item_ptrs<bits, cb, WIDE>(p, sb, blockIdx.x, iptr[0], false);
+    __syncthreads();
+    int buf = 0;
+    for (int item = blockIdx.x; item < count; item += gridDim.x, buf ^= 1)
+    {
+        const int next = item + (int) gridDim.x < count ? item + (int) gridDim.x : -1;
+        tile_a_r2<bits, cb, WIDE>(p, a, sb, item, next, iptr, buf, sh_rows, sh_last);
+        __syncthreads();
+    }
+}
+
+// ---------------------------------------------------------------------------------------------
+// Kernel B (down + weighted token reduction). MERGE (narrow tile): item = run * (Ho / 128) + chunk128;
+// WIDE: item = run * (Ho / 128) + group (one 128-column group = one chunk)
+
+template <int GPC>
+__device__ __forceinline__
+void tile_b_finish_r2(const MoeCoopParams& p, const R2Runs& sb, const R2SlotsB& xb, const int* sh_rows, int nrows,
+                      int chunk, int arrivals, int* sh_last, float* sh_part, float& sh_gate)
+{
+    const int warp = threadIdx.x / 32;
+    const int lane = threadIdx.x % 32;
+    __syncthreads();
+    if (threadIdx.x < nrows)
+    {
+        const int row = sh_rows[threadIdx.x] / p.topk;
+        const int n = xb.nact[row];
+        sh_last[threadIdx.x] = atom_add_acq_rel_gpu(p.ctr_b + (size_t) row * (p.Ho / 128) + chunk, arrivals)
+                              == n * GPC * p.ksplit_b - arrivals;
+    }
+    __syncthreads();
+    for (int r = 0; r < nrows; ++r)
+    {
+        if (!sh_last[r] || (p.dbg & 2)) continue;
+        const int row = sh_rows[r] / p.topk;
+        const int col = chunk * 128 + lane * 4;
+
+        if (p.sh_gate_w)
+        {
+            const half* xr = p.x + (size_t) row * p.x_stride;
+            float dot = 0.0f;
+            for (int i = threadIdx.x * 2; i < p.H; i += THREADS * 2)
+            {
+                half2 xv = *((const half2*) (xr + i));
+                half2 wv = *((const half2*) (p.sh_gate_w + i));
+                dot += __low2float(xv) * __low2float(wv) + __high2float(xv) * __high2float(wv);
+            }
+            #pragma unroll
+            for (int o = 16; o > 0; o >>= 1)
+                dot += __shfl_xor_sync(0xffffffffu, dot, o);
+            if (lane == 0) sh_part[warp] = dot;
+            __syncthreads();
+            if (threadIdx.x == 0)
+            {
+                float tt = 0.0f;
+                for (int w = 0; w < WK; ++w) tt += sh_part[w];
+                sh_gate = 1.0f / (1.0f + __expf(-tt));
+            }
+            __syncthreads();
+        }
+
+        float o0 = 0.0f, o1 = 0.0f, o2 = 0.0f, o3 = 0.0f;
+        for (int k = warp; k < p.topk; k += WK)
+        {
+            const int sk = row * p.topk + k;
+            const int loc = sb.local[sk];
+            if (loc < 0) continue;
+            const float w = xb.w[sk];
+            float v0 = 0.0f, v1 = 0.0f, v2 = 0.0f, v3 = 0.0f;
+            for (int q = 0; q < p.ksplit_b; ++q)
+            {
+                float t0, t1, t2, t3;
+                load_f4_cg(p.d_out + ((size_t) q * (p.bsz * p.topk) + sk) * p.Ho + col, t0, t1, t2, t3);
+                v0 += t0; v1 += t1; v2 += t2; v3 += t3;
+            }
+            had128(v0, v1, v2, v3, lane);
+            scale_h4(xb.svh[sk] + col, v0, v1, v2, v3);
+            if (p.d_bias) add_h4(((const half*) p.d_bias[loc]) + col, v0, v1, v2, v3);
+            o0 += w * v0;
+            o1 += w * v1;
+            o2 += w * v2;
+            o3 += w * v3;
+        }
+        float* part = sh_part + warp * 128 + lane * 4;
+        part[0] = o0; part[1] = o1; part[2] = o2; part[3] = o3;
+        __syncthreads();
+        if (warp == 0)
+        {
+            o0 = 0.0f; o1 = 0.0f; o2 = 0.0f; o3 = 0.0f;
+            #pragma unroll
+            for (int w = 0; w < WK; ++w)
+            {
+                const float* q = sh_part + w * 128 + lane * 4;
+                o0 += q[0]; o1 += q[1]; o2 += q[2]; o3 += q[3];
+            }
+
+            if (p.sh_out)
+            {
+                const float gv = p.sh_gate_w ? sh_gate : 1.0f;
+                const float* sh = p.sh_out + (size_t) row * p.H + col;
+                if (col + 0 < p.H) o0 += gv * sh[0];
+                if (col + 1 < p.H) o1 += gv * sh[1];
+                if (col + 2 < p.H) o2 += gv * sh[2];
+                if (col + 3 < p.H) o3 += gv * sh[3];
+            }
+
+            float* dst = p.out + (size_t) row * p.out_stride + col;
+            if (col + 3 < p.H_out)
+                *((float4*) dst) = make_float4(o0, o1, o2, o3);
+            else
+            {
+                if (col + 0 < p.H_out) dst[0] = o0;
+                if (col + 1 < p.H_out) dst[1] = o1;
+                if (col + 2 < p.H_out) dst[2] = o2;
+            }
+        }
+        __syncthreads();
+    }
+}
+
+__device__ __forceinline__ void r2_b_item_ptr(const MoeCoopParams& p, const R2Runs& sb, int item, R2ItemPtr& dst, bool async)
+{
+    const int run_idx = item / (p.Ho / 128);
+    const int local = sb.local[sb.order[sb.start[run_idx]]];
