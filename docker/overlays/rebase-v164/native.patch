+"""RTX 5090 decode mixer carried from the validated daily; default off."""
+import torch
+from ..ext import exllamav3_ext as ext
+from ..util.tensor import g_tensor_cache
+
+class LegacyGR:
+    def __init__(self, owner):
+        h,d=owner.hc_mult,owner.hidden_size
+        # The daily folds the half norm weight into projection weights, rounds
+        # to half, then quantizes per projection row and per up-output channel.
+        fn=(owner.proj_h[:owner.proj_m].float()*owner.w_h.float()).half().float()
+        self.fn_s=(fn.abs().amax(dim=1).clamp_min(1e-8)/127.0).contiguous()
+        self.fn_q=torch.round(fn/self.fn_s[:,None]).clamp_(-128,127).to(torch.int8).contiguous()
+        up=owner.upx_h.float()
+        scale=(up.abs().amax(dim=2).clamp_min(1e-8)/127.0).contiguous()
+        self.up_q=torch.round(up/scale[:,:,None,:]).clamp_(-128,127).to(torch.int8).contiguous()
+        self.up_s=scale.reshape(h,d).contiguous()
+        self.w=owner.w_h
+        self.rank=owner.rank
+        self.eps=owner.rms_eps
+        self.combine=owner.use_combine
+
+    def mix(self,s3,cached):
+        r,h,d=s3.shape
+        def ws(numel,dtype,tag):
+            if cached:return g_tensor_cache.get_bucketed(s3.device,numel,dtype,tag)
+            return torch.empty((numel,),dtype=dtype,device=s3.device)
+        dots=ws(r*(self.fn_q.shape[0]+1)*h,torch.float,'legacy_gr_dots').view(r,-1,h)
+        state=ws(r*(self.rank+h),torch.float,'legacy_gr_state').view(r,self.rank+h)
+        post=ws(r*h,torch.float,'legacy_gr_post').view(r,h) if self.combine else None
+        mixed=ws(r*d,torch.half,'legacy_gr_mixed').view(r,d)
+        ext.gr_mix_v2_int8_v3(s3,self.fn_q,self.fn_s,self.up_q,self.up_s,self.w,self.eps,
+            dots,state,post,mixed,15,1 if r==1 else (4 if r>=32 else 2),
+            1 if r<8 else (8 if r>=32 else 4),8 if r>=32 else 4,
+            0 if r>=32 else 1,2 if 8<=r<32 else 4)
