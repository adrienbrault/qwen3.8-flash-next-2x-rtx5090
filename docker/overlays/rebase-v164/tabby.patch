@@ -0,0 +1,121 @@
+"""flan tokenize-offloop r2: encode the prompt once per request; move only LONG encodes off the asyncio event loop.
+
+exllamav3's AsyncGenerator runs Generator.iterate() (the decode step of every running stream) as a task on the same
+event loop that runs the request handlers. The served streamed path encoded each prompt twice on that loop: once in
+the pre-stream context-length check (router -> common.model.check_context_length -> validate_context_length) and
+again in generate_gen. For a 30k-token prompt that is two ~25 ms sections in which no stream decodes (flan R805,
+REVIEW-R804-R805 sec. 1). r1 removed both (R806: class (i) stall 53.5 -> 3.5 ms), but every executor hop costs the
+arriving request ~30-40 ms of TTFT while other streams decode: the loop picks the worker's result up only between two
+synchronous iterate() calls, and the worker needs the GIL that iterate() mostly holds (REVIEW-R806 sec. 5: class (iii)
+~85-token prompts +41.6 ms TTFT). r2 hops only when the inline encode would cost more than the hop saves the others.
+
+Knobs, all read per call:
+  TABBY_ENCODE_ONCE=0      (e1 off) generate_gen encodes the prompt again after the check (the served path). ON
+                           (default): the check keeps the ids it encoded on the request (BaseSamplerRequest._prompt_ids,
+                           keyed by (prompt, add_bos); text-only prompts) and generate_gen reuses them, at any length.
+  EXL3_TOKENIZE_OFFLOOP=0  (e2 off) run_tokenize always calls fn inline on the loop (the served path). ON (default): fn
+                           runs on a dedicated one-thread executor when the text is long (below), inline otherwise;
+                           exllamav3's Tokenizer (same overlay) encodes through encode_batch, which releases the GIL,
+                           so the loop keeps iterating while the worker encodes.
+  EXL3_TOKENIZE_OFFLOOP_MIN_CHARS (default 12000) the hop threshold: fn goes to the worker when the prompt text has MORE
+                           than this many characters. 12,000 chars ~ 4,200 tokens on this model's rendered prompts (2.87
+                           chars/token measured, R806 TOKCHECK: 60,301 chars = 20,992 tokens) ~ 3.8 ms of inline encode
+                           at the ~0.9 us/token measured in the served container: below it the inline encode stalls the
+                           other streams less than one decode step (~17 ms), while a hop would cost the request 1-2 steps.
+                           0 = hop at every length (r1's behaviour). Anything but plain ASCII digits (a sign, '_',
+                           whitespace, a decimal point) = the default. The threshold counts characters, not tokens:
+                           CJK runs ~1 char/token (12,000 chars ~ 12k tokens ~ 11 ms inline) and byte-fallback-heavy
+                           text can run several tokens per char; both are rare on this traffic.
+  Busy worker: a short text also goes to the worker while an earlier hop is still queued or running there. Inline it
+  would wait on the exllamav3 encode lock that the worker holds, i.e. block the loop for the rest of the long encode;
+  queued behind it on the worker it costs only its own request's TTFT.
+
+One worker thread: calls run one at a time, in submission order, off the default executor that other blocking helpers
+share. The context is copied as asyncio.to_thread does. Results and exceptions are those of fn; a cancelled await
+leaves the running call to finish in the worker and drops its result.
+"""
+
+import asyncio
+import contextvars
+import functools
+import os
+import threading
+from concurrent.futures import ThreadPoolExecutor
+
+REVISION = "tokenize-offloop-r2"
+DEFAULT_MIN_CHARS = 12000
+
+_executor = None
+_pending_lock = threading.Lock()
+_pending = 0           # hops submitted to the worker and not finished there (run, raised or cancelled before running)
+hops = 0               # executor submissions since import (tests and diagnostics; loop thread only)
+
+
+def offloop_enabled() -> bool:
+    return os.environ.get("EXL3_TOKENIZE_OFFLOOP", "1") != "0"
+
+
+def offload_min_chars() -> int:
+    # plain ASCII digits only: '', '-5', '1.5', 'abc', '1_000', ' 12000 ' all mean the default
+    v = os.environ.get("EXL3_TOKENIZE_OFFLOOP_MIN_CHARS", "")
+    if not (v.isascii() and v.isdigit()):
+        return DEFAULT_MIN_CHARS
+    return int(v)
+
+
+def prompt_chars(prompts) -> int:
+    """Characters of a prompt (str) or of every prompt of a list prompt (/v1/completions)."""
+    if isinstance(prompts, str):
+        return len(prompts)
+    try:
+        return sum(len(p) for p in prompts if isinstance(p, str))
+    except TypeError:
+        return 0
+
+
+def should_offload(nchars: int) -> bool:
+    if not offloop_enabled():
+        return False
+    return nchars > offload_min_chars() or _pending > 0
+
+
+def _done(_f):
+    # runs in the worker when the call ends, or in the cancelling thread when a queued call is cancelled
+    global _pending
+    with _pending_lock:
+        _pending -= 1
+
+
+def _get_executor() -> ThreadPoolExecutor:
+    # Created on first use from the loop thread (no race: one event loop thread calls this)
+    global _executor
+    if _executor is None:
+        _executor = ThreadPoolExecutor(max_workers=1, thread_name_prefix="tokenize")
+    return _executor
+
+
+async def run_tokenize(nchars, fn, /, *args, **kwargs):
+    """fn(*args, **kwargs) for a prompt of nchars characters: on the tokenize worker when should_offload(nchars), else
+    inline on the loop thread (no hop: the result is ready without waiting for an iterate() to end)."""
+    global _pending, hops
+    if not should_offload(nchars):
+        return fn(*args, **kwargs)
+    ctx = contextvars.copy_context()
+    with _pending_lock:
+        _pending += 1
+    hops += 1
+    # what loop.run_in_executor does (submit + wrap_future: a cancelled await cancels a still-queued call), plus the
+    # completion callback that keeps _pending exact
+    try:
+        cf = _get_executor().submit(functools.partial(ctx.run, fn, *args, **kwargs))
+    except BaseException:
+        _done(None)
+        raise
+    cf.add_done_callback(_done)
+    return await asyncio.wrap_future(cf)
+
+
+def encode_once_enabled() -> bool:
+    # TABBY_ENCODE_ONCE=0: generate_gen encodes the prompt again after the context-length check
+    # (the served path); read per call
+    return os.environ.get("TABBY_ENCODE_ONCE", "1") != "0"
