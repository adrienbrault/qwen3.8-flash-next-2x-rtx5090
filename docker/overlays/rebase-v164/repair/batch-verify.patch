@@ -0,0 +1,10 @@
+"""Eligibility for stateless per-job MTP verification; no torch dependency."""
+def mode_for(job,window):
+    mode=getattr(job.sampler,'batch_verify_mode',None)
+    if mode not in ('greedy','sampled') or getattr(job.sampler,'reqs_past_ids',True):return None
+    if job.new_tokens<1 or job.forced_ids is not None or job.filters or job.checkpoint is not None:return None
+    if job.return_probs or job.return_top_tokens>0 or len(job.sequences)!=1:return None
+    # The EOS mask can change after crossing min_new_tokens. Keep those windows
+    # serial rather than sampling later rows with the opener's mask.
+    if job.new_tokens<job.min_new_tokens<=job.new_tokens+window-1:return None
+    return mode
