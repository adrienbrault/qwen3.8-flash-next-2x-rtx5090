+// No stream/event resources, dispatch changes or shared-coop changes when OFF.
+void BC_BlockSparseMLP::init_shared_overlap()
+{
+#if !defined(USE_ROCM)
+    const char* env = std::getenv("EXL3_SHARED_EXPERT_OVERLAP");
+    if (!env || std::strcmp(env, "1") || !shared_experts || !out_d_sh || !yh.is_cuda()) return;
+    shared_overlap_device = yh.device().index();
+    c10::cuda::CUDAGuard guard(yh.device());
+    try
+    {
+        // Reuse one process-lifetime Torch stream per device, including its
+        // allocator/cuBLAS workspaces, rather than warming a pool stream per layer.
+        static std::mutex mutex;
+        static std::unordered_map<int, cudaStream_t> streams;
+        {
+            std::lock_guard<std::mutex> lock(mutex);
+            auto it = streams.find(shared_overlap_device);
+            if (it == streams.end())
+                it = streams.emplace(shared_overlap_device,
+                    c10::cuda::getStreamFromPool(false, shared_overlap_device).stream()).first;
+            shared_stream = it->second;
+        }
+        C10_CUDA_CHECK(cudaEventCreateWithFlags(&shared_input_ready, cudaEventDisableTiming));
+        C10_CUDA_CHECK(cudaEventCreateWithFlags(&shared_done, cudaEventDisableTiming));
+        shared_early = true;
+    }
+    catch (...)
+    {
+        if (shared_done) cudaEventDestroy(shared_done);
+        if (shared_input_ready) cudaEventDestroy(shared_input_ready);
+
+        shared_done = shared_input_ready = nullptr;
+        shared_stream = nullptr;
+        throw;
+    }
+#endif
+}
+
+void BC_BlockSparseMLP::start_shared(const at::Tensor& y)
+{
+    TORCH_CHECK(shared_early && !shared_started, "start_shared: unavailable or unconsumed early launch");
+    TORCH_CHECK(y.is_cuda() && y.device().index() == shared_overlap_device &&
+                y.scalar_type() == at::kHalf && y.dim() == 2 && y.stride(1) == 1 &&
+                y.size(1) == coop_p.Hi && y.size(0) >= 1 && y.size(0) <= MAX_BSZN &&
+                y.size(0) <= out_bszn.size(0) && y.size(0) <= out_d_sh->size(1),
+                "start_shared: unsupported input or shared scratch capacity");
+    c10::cuda::CUDAGuard guard(y.device());
+    shared_input = y;
+    shared_started = true;
+    auto side = c10::cuda::getStreamFromExternal(shared_stream, shared_overlap_device);
+    // Retain input until B queues its producer-stream wait before scratch reuse.
+    // No additional input allocator stream record is needed for this native path.
+    C10_CUDA_CHECK(cudaEventRecord(shared_input_ready, at::cuda::getCurrentCUDAStream().stream()));
+    C10_CUDA_CHECK(cudaStreamWaitEvent(shared_stream, shared_input_ready, 0));
+    {
+        c10::cuda::CUDAStreamGuard stream_guard(side);
+        auto x_dense = y.unsqueeze(0);
+        auto dst = out_d_sh->slice(1, 0, y.size(0));
+        shared_experts->run_bszN(x_dense, dst);
+    }
+    C10_CUDA_CHECK(cudaEventRecord(shared_done, shared_stream));
+    ++shared_launches;
+}
+
+void BC_BlockSparseMLP::drain_shared()
+{
+    if (!shared_stream) return;
+    c10::cuda::CUDAGuard guard(shared_overlap_device);
+    // Side work can have been issued before an exception prevented shared_done recording.
+    C10_CUDA_CHECK(cudaStreamSynchronize(shared_stream));
+    C10_CUDA_CHECK(cudaStreamSynchronize(at::cuda::getCurrentCUDAStream().stream()));
+    shared_started = false;
+    shared_input = at::Tensor();
+}
+
+BC_BlockSparseMLP::~BC_BlockSparseMLP() noexcept
+{
+    if (!shared_stream) return;
+    // Raw device restoration is deliberately nonthrowing during error unwinding.
+    int previous = -1;
+    if (cudaGetDevice(&previous) != cudaSuccess) return;
+    if (previous != shared_overlap_device && cudaSetDevice(shared_overlap_device) != cudaSuccess) return;
+    cudaStreamSynchronize(shared_stream);
+    if (shared_done) cudaEventDestroy(shared_done);
+    if (shared_input_ready) cudaEventDestroy(shared_input_ready);
+    // The Torch pool owns shared_stream; allocator references may outlive this BC.
+    if (previous != shared_overlap_device) cudaSetDevice(previous);
+}
