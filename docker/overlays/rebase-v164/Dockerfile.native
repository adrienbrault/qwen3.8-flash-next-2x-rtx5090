ARG BASE=tabbyapi:r828-prompt-lookup-r3
FROM ${BASE}
COPY out/engine /opt/flashnext-native-src
WORKDIR /opt/flashnext-native-src
RUN TORCH_CUDA_ARCH_LIST=12.0 MAX_JOBS=4 python3 setup.py build_ext --inplace
RUN python3 -m pip uninstall -y exllamav3 && rm -rf /opt/venv/lib/python3.12/site-packages/exllamav3 && \
    EXLLAMA_NOCOMPILE=1 python3 -m pip install --no-build-isolation --no-deps . && \
    cp exllamav3_ext*.so /opt/venv/lib/python3.12/site-packages/ && \
    cd / && python3 -c 'import torch; import exllamav3_ext as e; assert e.flashnext_decode_capacity == 32; assert hasattr(e,"gr_mix_v2_int8_v3"); print("source-built native capacity and mixer bindings PASS")'
COPY out/tabby /app
COPY manifest.json /opt/flashnext-v164/manifest.json
COPY cpu-check.py /opt/flashnext-v164/cpu-check.py
COPY repair/test_batch_verify.py /opt/flashnext-v164/test-batch-verify.py
COPY repair/test_pipeline.py /opt/flashnext-v164/test-pipeline.py
COPY repair/test_tiled_cache.py /opt/flashnext-v164/test-tiled-cache.py
COPY repair/test_prefix.py /opt/flashnext-v164/test-prefix.py
COPY repair/test_decode_chunks.py /opt/flashnext-v164/test-decode-chunks.py
ENV EXL3_CACHE_TRACE=0
WORKDIR /app
RUN python3 /opt/flashnext-v164/test-batch-verify.py && python3 /opt/flashnext-v164/test-pipeline.py && python3 /opt/flashnext-v164/test-tiled-cache.py && python3 /opt/flashnext-v164/cpu-check.py && python3 /opt/flashnext-v164/test-prefix.py && python3 /opt/flashnext-v164/test-decode-chunks.py && \
    python3 -c 'from exllamav3.modules.mlp import MAX_BSZN as a; from exllamav3.modules.block_sparse_mlp import MAX_BSZN as b; assert a == b == 32; print("Python/native row capacities PASS")'
LABEL local.flashnext.engine="da68d57de61781e5b74ad68698ac4caf36408d7a" local.flashnext.native="source-build-5090-recovery"
