+"""Opt-in whole-tile vocabulary prefix for draft proposals only."""
+import os
+import torch
+from .quant.exl3 import LinearEXL3
+from ..ext import exllamav3_ext as ext
+
+def tensor_version(t):
+    try:
+        return t._version
+    except RuntimeError:  # Model loaders may produce inference tensors without version counters.
+        return None
+
+class DraftHeadPrefix:
+    def __init__(self, cap):
+        self.cap = cap
+        self.key = None
+        self.cache = None
+        self.checked = set()
+
+    def clear(self):
+        self.key = None
+        self.cache = None
+        self.checked.clear()
+
+    def prepare(self, lm, vocab_size, params=None):
+        params = params or {}
+        inner = getattr(lm, "inner", None)
+        if (type(inner) is not LinearEXL3 or self.cap <= 0 or
+            type(vocab_size) is not int or vocab_size <= 0 or
+            getattr(inner, "bias", None) is not None or
+            getattr(lm, "lora_a_tensors", None) or
+            getattr(lm, "pre_scale", 1.0) != 1.0 or
+            getattr(lm, "post_scale", 1.0) != 1.0 or
+            getattr(lm, "softcap", 0.0) != 0.0 or
