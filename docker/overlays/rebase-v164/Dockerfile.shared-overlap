ARG BASE=tabbyapi:flashnext-v164-device-draft
FROM ${BASE}
COPY repair/shared-overlap.patch /tmp/shared-overlap.patch
WORKDIR /opt/flashnext-native-src
RUN git apply --unsafe-paths /tmp/shared-overlap.patch && \
    TORCH_CUDA_ARCH_LIST=12.0 MAX_JOBS=4 python3 setup.py build_ext --inplace && \
    cp exllamav3_ext*.so /opt/venv/lib/python3.12/site-packages/ && \
    cp exllamav3/modules/block_sparse_mlp.py /opt/venv/lib/python3.12/site-packages/exllamav3/modules/
COPY manifest.json /opt/flashnext-v164/manifest.json
COPY repair/test_shared_overlap.py /opt/flashnext-v164/test-shared-overlap.py
WORKDIR /app
RUN python3 /opt/flashnext-v164/test-shared-overlap.py /opt/flashnext-native-src/exllamav3 && \
    python3 /opt/flashnext-v164/test-device-draft.py && python3 /opt/flashnext-v164/test-batch-verify.py && \
    python3 /opt/flashnext-v164/test-pipeline.py && python3 /opt/flashnext-v164/cpu-check.py && \
    python3 /opt/flashnext-v164/test-prefix.py && python3 /opt/flashnext-v164/test-decode-chunks.py
