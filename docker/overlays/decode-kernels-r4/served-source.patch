+(
+    const float* __restrict__ streams, const int8_t* __restrict__ fn_q,
+    const float* __restrict__ fn_s, float* __restrict__ dots,
+    const int R, const int D, const int M
+)
+{
+    constexpr int H = GR_V2_H, J = GR_V2_J, V = GR_THREADS_A / GR_V2_WARP;
+    const int tid = threadIdx.x, lane = tid % 32, warp = tid / 32;
+    const int h = blockIdx.z, r0 = blockIdx.y * B;
+    const int j0 = blockIdx.x * J;
+    __shared__ float red[B][J][V];
+    if (blockIdx.x == (M + J - 1) / J)
+    {
+        float a[B] = {};
+        for (int c = tid; c < D / 4; c += GR_THREADS_A)
+        {
+            #pragma unroll
+            for (int b = 0; b < B; ++b)
+                if (r0 + b < R)
+                {
+                    float4 s = ((const float4*) streams)[((size_t) (r0 + b) * H + h) * (D / 4) + c];
+                    a[b] = fmaf(s.x, s.x, fmaf(s.y, s.y,
+                           fmaf(s.z, s.z, fmaf(s.w, s.w, a[b]))));
+                }
+        }
+        #pragma unroll
+        for (int b = 0; b < B; ++b)
+        {
+            for (int offset = 16; offset > 0; offset >>= 1)
+                a[b] += __shfl_down_sync(0xffffffffu, a[b], offset);
+            if (lane == 0) red[b][0][warp] = a[b];
+        }
+        __syncthreads();
+        if (tid < B && r0 + tid < R)
+        {
+            float sum = 0.0f;
+            #pragma unroll
+            for (int v = 0; v < V; ++v) sum += red[tid][0][v];
+            dots[((size_t) (r0 + tid) * (M + 1) + M) * H + h] = sum;
+        }
+        return;
+    }
+    float a[B][J] = {};
+    for (int c = tid; c < D / 8; c += GR_THREADS_A)
+    {
+        int2 packed[J];
+        #pragma unroll
+        for (int j = 0; j < J; ++j)
+            if (j0 + j < M)
+                packed[j] = ((const int2*) (fn_q + ((size_t) (j0 + j) * H + h) * D))[c];
+        #pragma unroll
+        for (int b = 0; b < B; ++b)
+            if (r0 + b < R)
+            {
+                const float4* s4 = (const float4*) (streams + ((size_t) (r0 + b) * H + h) * D);
+                float4 s0 = s4[2 * c], s1 = s4[2 * c + 1];
+                #pragma unroll
+                for (int j = 0; j < J; ++j)
+                    if (j0 + j < M)
+                    {
+                        const int8_t* q = (const int8_t*) &packed[j];
+                        a[b][j] = fmaf(s0.x, (float) q[0], a[b][j]);
+                        a[b][j] = fmaf(s0.y, (float) q[1], a[b][j]);
+                        a[b][j] = fmaf(s0.z, (float) q[2], a[b][j]);
+                        a[b][j] = fmaf(s0.w, (float) q[3], a[b][j]);
+                        a[b][j] = fmaf(s1.x, (float) q[4], a[b][j]);
+                        a[b][j] = fmaf(s1.y, (float) q[5], a[b][j]);
+                        a[b][j] = fmaf(s1.z, (float) q[6], a[b][j]);
+                        a[b][j] = fmaf(s1.w, (float) q[7], a[b][j]);
+                    }
+            }
+    }
+    #pragma unroll
+    for (int b = 0; b < B; ++b)
+        #pragma unroll
+        for (int j = 0; j < J; ++j)
+        {
+            for (int offset = 16; offset > 0; offset >>= 1)
+                a[b][j] += __shfl_down_sync(0xffffffffu, a[b][j], offset);
+            if (lane == 0) red[b][j][warp] = a[b][j];
+        }
+    __syncthreads();
+    if (tid < B * J)
+    {
+        const int b = tid / J, j = tid % J;
+        if (r0 + b < R && j0 + j < M)
+        {
+            float sum = 0.0f;
+            #pragma unroll
+            for (int v = 0; v < V; ++v) sum += red[b][j][v];
+            dots[((size_t) (r0 + b) * (M + 1) + j0 + j) * H + h] =
+                sum * fn_s[j0 + j];
+        }
+    }
+}
