+            gates[b][cq][h][0] = g[b].x * scale.x;
+            gates[b][cq][h][1] = g[b].y * scale.y;
+            gates[b][cq][h][2] = g[b].z * scale.z;
+            gates[b][cq][h][3] = g[b].w * scale.w;
+        }
+    }
+    __syncthreads();
+    if (threadIdx.x < B * Q * 4)
+    {
+        const int b = threadIdx.x / (Q * 4), q = (threadIdx.x / 4) % Q, k = threadIdx.x % 4;
+        const int d = (blockIdx.x * Q + q) * 4 + k;
+        if (r0 + b < R && d < D)
