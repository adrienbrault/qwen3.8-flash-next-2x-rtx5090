+    { \
+        using namespace exl3_moe_coop_v3_ns; \
+        const int smem = smem_v3<K, true>(); \
+        if (wide) return { (void*) exl3_moe_coop_v3_b_kernel_h<K, true, false>, smem }; \
+        if (merge) return { (void*) exl3_moe_coop_v3_b_kernel_h<K, false, true>, smem }; \
+        return { (void*) exl3_moe_coop_v3_b_kernel_h<K, false, false>, smem }; \
+    } \
+    MoeCoopKernel exl3_moe_coop_r2_a_h##K(bool wide) \
+    { \
+        using namespace exl3_moe_coop_r2_ns; \
+        if (wide) return { (void*) exl3_moe_coop_r2_a_kernel_h<K, true>, 0 }; \
+        return { (void*) exl3_moe_coop_r2_a_kernel_h<K, false>, 0 }; \
+    } \
+    MoeCoopKernel exl3_moe_coop_r2_b_h##K(bool wide) \
+    { \
+        using namespace exl3_moe_coop_r2_ns; \
+        if (wide) return { (void*) exl3_moe_coop_r2_b_kernel_h<K, true>, 0 }; \
+        return { (void*) exl3_moe_coop_r2_b_kernel_h<K, false>, 0 }; \
+    }
