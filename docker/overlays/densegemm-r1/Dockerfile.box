# densegemm r1: dense EXL3 K4 decode GEMMs (GDN in_proj / out_proj, attention qkv / o_proj, index_qk, shared expert)
# with a gathered stream-K fixup, weight prologue ahead of the input stage, fused output transform, and (gemv) a
# cp.async weight ring. Opt-in EXL3_DENSE_V2=1|2|3 and EXL3_DENSE_ROWS32=1 (read at the first dense call);
# unset = the served kernels, whose SASS the install checks unchanged against BASE's .so.
#
#   docker build -f Dockerfile.box --build-arg BASE=tabbyapi:stack-r2 \
#     --build-arg PATCH_SHA=$(sha256sum densegemm-r1.patch | cut -c1-64) -t tabbyapi:densegemm-r1 .
#
# BASE = the daily image (tabbyapi:stack-r2 = slotfix-r1 + hcfast-r1 + moefast-r1 since 2026-09-24 08:46 UTC); the
# patch is made against those sources and composes with pdl-l2-r1 in either order (make-patch.sh).
# Build context = this directory. No heredocs in RUN (legacy builder). The CPU model test runs during the build; the
# GPU parity test and the P0 bench are copied to /opt/densegemm-r1/ with the d0 harness they import; the install's
# SASS lists stay in /opt/densegemm-r1/install/.
ARG BASE=tabbyapi:stack-r2
FROM ${BASE}
ARG BASE
ARG MAX_JOBS=2
ARG PATCH_SHA=unknown
COPY densegemm-r1.patch rebuild-native.py install-densegemm.sh sass_hashes.py test_densegemm_cpu.py test_densegemm_parity.py bench_densegemm_p0.py /opt/densegemm-r1/
COPY d0/d0_microbench.py /opt/densegemm-r1/d0/
RUN MAX_JOBS=${MAX_JOBS} bash /opt/densegemm-r1/install-densegemm.sh && \
    python3 /opt/densegemm-r1/test_densegemm_cpu.py && \
    PYTHONPYCACHEPREFIX=/tmp/pyc python3 -m py_compile /opt/densegemm-r1/test_densegemm_parity.py /opt/densegemm-r1/bench_densegemm_p0.py && \
    python3 -c 'import torch, exllamav3_ext as e; assert e.dense_v2_revision == 1 and tuple(e.dense_v2_modes()) == (0, 0); print("densegemm r1 landed (default off: EXL3_DENSE_V2 / EXL3_DENSE_ROWS32 unset)")'
LABEL local.densegemm.base="${BASE}" local.densegemm.patch_sha256="${PATCH_SHA}"
