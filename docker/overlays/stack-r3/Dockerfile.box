# stack-r3: the next batched decode stack for the Flash-Next daily, built on the served stack-r2
# (tabbyapi:stack-r2 = slotfix-r1 + hcfast-r1 + moefast-r1, DAILY_IMG since R701) with ONE patch series and ONE rebuild:
#   core  01 hcfast r1 -> r2 (EXL3_HC_MIX_V3=2 + tables), 02 latchain-r1b (EXL3_LC_GDN_RR / _QSA_FORK / QT options)
#   mf3   03 moefast-r3 (EXL3_MOE_COOP_V3=3, EXL3_SHARED_EXPERT_EARLY / _PRIO)                  INCLUDE contains mf3
#   dg1   04 densegemm-r1 (EXL3_DENSE_V2=3 gemv twin; its gemm twins spill, mode 3 only)       INCLUDE contains dg1
#   dg2   05 densegemm-r2 (EXL3_DENSE_V2=1|2|3, R714's DGV2_NVCC_DEFS)                          INCLUDE contains dg2
#   auto  06 dense-lcguard (latchain side-branch dense calls get their own V2 scratch)          with dg1 or dg2
# All flags default off: unset EXL3_* = the served stack-r2 kernels (the install checks the served SASS unchanged).
#
#   docker build -f Dockerfile.box --build-arg BASE=tabbyapi:stack-r2 --build-arg INCLUDE="mf3 dg2" \
#     --build-arg DGV2_NVCC_DEFS= --build-arg SERIES_SHA=$(sha256sum series/SERIES | cut -c1-64) \
#     --build-arg MAX_JOBS=4 -t tabbyapi:stack-r3 .
#   (the served image, R716b: INCLUDE "mf3 dg2" with empty DGV2_NVCC_DEFS, R714's bisect choice "plain r2")
#
# Build context = this directory (docker/overlays/stack-r3). No heredocs (legacy builder). CPU only: no --gpus needed.
ARG BASE=tabbyapi:stack-r2
FROM ${BASE}
ARG BASE
ARG INCLUDE=""
ARG DGV2_NVCC_DEFS=""
ARG SERIES_SHA=unset
ARG MAX_JOBS=4
COPY install-stack.sh /opt/stack-r3/
COPY series/ /opt/stack-r3/series/
COPY tools/ /opt/stack-r3/tools/
COPY tests/ /opt/stack-r3/tests/
RUN INCLUDE="${INCLUDE}" DGV2_NVCC_DEFS="${DGV2_NVCC_DEFS}" MAX_JOBS=${MAX_JOBS} STACK_INSTALL_OUT=/opt/stack-r3/install \
      bash /opt/stack-r3/install-stack.sh && \
    python3 -m py_compile /opt/stack-r3/tests/latchain/test_latchain_parity.py /opt/stack-r3/tests/latchain/lc_model_parity.py \
      /opt/stack-r3/tests/hcfast/test_hcfast_parity.py /opt/stack-r3/tests/moefast/test_moefast_parity.py \
      /opt/stack-r3/tests/densegemm-r1/test_densegemm_parity.py /opt/stack-r3/tests/densegemm-r2/test_densegemm_parity.py && \
    python3 /opt/stack-r3/tools/landing.py --include "${INCLUDE}"
LABEL local.stack.round="r3" local.stack.base="${BASE}" local.stack.include="${INCLUDE}" \
      local.stack.dgv2_defs="${DGV2_NVCC_DEFS}" local.stack.series_sha256="${SERIES_SHA}"
