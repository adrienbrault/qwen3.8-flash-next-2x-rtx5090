+        for (int m = 0; m < TILEBLOCKS_M; ++m)
+        {
+            const int r0 = m * 16 + lane_id / 4;
+            const int r1 = r0 + 8;
+            const int c = (lane_id % 4) * 2;
+            if (r0 < size_m)
+            {
+                #pragma unroll
+                for (int n = 0; n < FRAGS_N_PER_WARP; ++n)
+                {
+                    float* c_ptr = ((float*) sh_c) + r0 * TILESIZE_N + (n0 + n) * 8 + c;
+                    *c_ptr++ = frag_c[m][n][0];
+                    *c_ptr++ = frag_c[m][n][1];
+                }
+            }
+            if (r1 < size_m)
+            {
+                #pragma unroll
+                for (int n = 0; n < FRAGS_N_PER_WARP; ++n)
+                {
+                    float* c_ptr = ((float*) sh_c) + r1 * TILESIZE_N + (n0 + n) * 8 + c;
+                    *c_ptr++ = frag_c[m][n][2];
+                    *c_ptr++ = frag_c[m][n][3];
+                }
+            }
+        }
+    };
+
+    // Final sums -> shared memory rounded to fp16 (what the served mgemm kernel writes into an
