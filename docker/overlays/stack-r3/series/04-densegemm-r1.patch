+                A_had + this_warp * 128,
+                suh + (this_warp * 128) % size_k,
+                0.088388347648f  // 1/sqrt(128)
+            );
+
+        grid.sync();
+    };
+
+    exl3_gemm_kernel_inner_v2
+    <bits, c_fp32, cb, TILESIZE_M, TILESIZE_K, TILESIZE_N, SH_STAGES, FRAG_STAGES, 0>
+    (A_had, B, C, size_m, size_k, size_n, locks, svh, 0, ws, pre_a);
