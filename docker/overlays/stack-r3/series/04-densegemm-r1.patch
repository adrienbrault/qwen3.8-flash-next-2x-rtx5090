diff -ruN -x __pycache__ -x *.orig -x *.rej a/exllamav3_ext/quant/exl3_gemv_v2_kernel.cuh b/exllamav3_ext/quant/exl3_gemv_v2_kernel.cuh
--- a/exllamav3_ext/quant/exl3_gemv_v2_kernel.cuh	1970-01-01 01:00:00
+++ b/exllamav3_ext/quant/exl3_gemv_v2_kernel.cuh	2026-09-24 14:04:09
@@ -0,0 +1,280 @@
+#pragma once
+
+// densegemm r1 (EXL3_DENSE_V2 = 1 or 3, default off): twin of the served small-m GEMV
+// (exl3_gemv_kernel, exl3_gemv_kernel.cuh) for 4 bpw, mul1 codebook, shuffle extraction. Served at
+// 3-8 rows (the c1d3 shape): GDN out_proj, attention o_proj, index_qk_proj, shared-expert down.
+//
+// Every value that reaches an MMA, every MMA, the fp16 accumulator fold cadence, the cross-warp
+// reduction order and the output transform are the served ones. What changes is how operands
+// arrive and how the output stage is synchronized:
+//
+//   1. Weights through a warp-private cp.async ring in shared memory (RING slices deep) instead of
+//      the served register prefetch ring (ld.global.cs into pf[PF][LOADS]). The served ring's
+//      loads are issued in the same instruction group as the activation loads of the current
+//      slice; when they share a scoreboard (the pattern moefast r1 found in the MoE twin of this
+//      loop, FINDINGS R700b / moefast-r1 ANALYSIS.md), each MMA waits for a DRAM load issued in
+//      the same iteration and the ring gives no latency cover. cp.async completion is tracked by
+//      wait_group instead, so the MMA only waits on the activation fragment. Each lane reads the
+//      two words the served shuffle would have given it (tp[lane], tp[(lane + 31) & 31]), exactly
+//      like the served SMEM_STAGE variant.
+//   2. The activation fragment of slice i + 1 is loaded during slice i.
+//   3. The first group's weight ring is filled BEFORE the input Hadamard + grid.sync.
+//   4. Output transform: instead of grid.sync + a grid-wide pass over C, the block that completes
+//      the last group of a 128-column Hadamard block (per-block arrival counter, threadfence
+//      pattern) transforms that block in place. Same function, same inputs, same place.
+
+#include <cooperative_groups.h>
+#include "../ptx.cuh"
+#include "exl3_dq.cuh"
+#include "exl3_kernel_map.cuh"
+#include "hadamard_inner.cuh"
+#include "exl3_gemv_kernel.cuh"
+
+// Arrival counters for the output stage (hctr): one int per 128 output columns, zero at rest, owned
+// by exl3_dense_v2.cu (DENSE_V2_GEMV_MAX_HBLOCKS)
+
+template <int bits, bool c_fp32, int cb, int MMODE, int CFG>
+__global__ __launch_bounds__(CFG == 0 ? 512 : 256)
+void exl3_gemv_v2_kernel(EXL3_GEMM_ARGS, int* __restrict__ hctr)
+{
+    static_assert(bits == 4, "exl3_gemv_v2_kernel: 4 bpw only");
+    constexpr int WK   = CFG == 0 ? 16 : 8;     // k-split (warps per block)
+    constexpr int WNT  = CFG == 0 ? 2 : 4;      // adjacent n-tiles per warp
+    constexpr int PF   = CFG == 0 ? 4 : 2;      // served prefetch depth: defines the loop shape
+    constexpr int FOLD = CFG == 0 ? 4 : 2;      // fp16->fp32 fold cadence (divides PF)
+    constexpr int THREADS = WK * 32;
+    constexpr int ROWS = MMODE == 0 ? 1 : EXL3_GEMV_MAX_M;
+    constexpr int COLS = WNT * 16;
+    constexpr int TWORDS = 8 * bits;            // uint32 per 16x16 tile
+    constexpr int SW = WNT * TWORDS;            // uint32 per warp per k-slice (contiguous in B)
+    constexpr int RING = 6;                     // cp.async ring depth, slices
+    constexpr int CHUNKS = SW / 4;              // 16-byte copies per slice
+    constexpr int GPB = 128 / COLS;             // groups per 128-column output block
+    static_assert(CHUNKS <= 32 && 128 % COLS == 0, "exl3_gemv_v2_kernel: shape");
+
+    auto grid = cooperative_groups::this_grid();
+
+    const int warp = threadIdx.x / 32;
+    const int lane = threadIdx.x % 32;
+
+    const int ntiles = size_n / 16;
+    const int kslices = size_k / 16;
+    const int num_groups = size_n / COLS;
+
+    const int chunk = CEIL_DIVIDE(kslices, WK);
+    const int ks0 = warp * chunk;
+    const int myn = max(0, min(chunk, kslices - ks0));
+
+    const uint32_t* B32 = (const uint32_t*) B;
+    const size_t slice_stride = (size_t) ntiles * TWORDS;   // uint32 per k-slice row
+
+    __shared__ float sh_red[WK][ROWS][COLS];
+    __shared__ __align__(16) uint32_t sh_ring[WK][RING][SW];
+    __shared__ int sh_last;
+
+    // Slice i of this warp's k range for output group g -> ring slot i % RING. One commit group per
+    // call on every lane, copies or not, so wait_group counts stay uniform
+    auto issue = [&] (int g, int i)
+    {
+        if (i < myn)
+        {
+            const uint32_t* src = B32 + (size_t) (ks0 + i) * slice_stride + (size_t) g * SW;
+            uint32_t* dst = &sh_ring[warp][i % RING][0];
+            if (lane < CHUNKS) cp_async_stream(dst + lane * 4, src + lane * 4);   // evict-first, like the served __ldcs
+        }
+        cp_async_fence();
+    };
+
+    // 3. First group's ring fill before the input stage
+    if (blockIdx.x < num_groups)
+    {
+        #pragma unroll
+        for (int d = 0; d < RING - 1; ++d)
+            issue(blockIdx.x, d);
+    }
+
+    // Input scales and Hadamard transform (served code)
+    {
+        int total_warps = size_m * size_k / 128;
+        int warps_grid = gridDim.x * blockDim.x / 32;
+        int this_warp = threadIdx.x / 32 + blockDim.x / 32 * blockIdx.x;
+
+        for(; this_warp < total_warps; this_warp += warps_grid)
+            had_hf_r_128_inner<true, false>
+            (
+                A + this_warp * 128,
+                A_had + this_warp * 128,
+                suh + (this_warp * 128) % size_k,
+                0.088388347648f  // 1/sqrt(128)
+            );
+
+        grid.sync();
+        A = A_had;
+    }
+
+    const half2* A2 = (const half2*) A;
+    const half2 hzero = __half2half2(__ushort_as_half(0));
+
+    const int r0 = lane >> 2;
+    const size_t a_row0 = (size_t) r0 * (size_k / 2);
+    const bool r0_ok = MMODE == 0 ? lane < 4 : r0 < size_m;
+
+    for (int group = blockIdx.x; group < num_groups; group += gridDim.x)
+    {
+        if (group != blockIdx.x)
+        {
+            #pragma unroll
+            for (int d = 0; d < RING - 1; ++d)
+                issue(group, d);
+        }
+
+        // 2. Activation fragment of slice 0; slice i + 1's is loaded while slice i computes
+        half2 an0 = hzero, an1 = hzero;
+        if (myn > 0)
+        {
+            const size_t a_col = (size_t) ks0 * 8 + (lane & 3);
+            an0 = r0_ok ? A2[a_row0 + a_col] : hzero;
+            an1 = r0_ok ? A2[a_row0 + a_col + 4] : hzero;
+        }
+
+        FragC_h ch[WNT][2] = {};
+        float2 acc0[WNT][2] = {};
+
+        for (int ib = 0; ib < myn; ib += PF)
+        {
+        #pragma unroll
+        for (int d = 0; d < PF; ++d)
+        {
+            const int i = ib + d;
+            if (i >= myn) break;
+
+            // Keep the ring RING - 1 slices ahead, then wait for slice i
+            issue(group, i + RING - 1);
+            cp_async_wait<RING - 1>();
+            __syncwarp();
+
+            FragB a01, a23;
+            a01[0] = an0;
+            a23[0] = an1;
+            a01[1] = hzero;
+            a23[1] = hzero;
+            if (i + 1 < myn)
+            {
+                const size_t a_col = (size_t) (ks0 + i + 1) * 8 + (lane & 3);
+                an0 = r0_ok ? A2[a_row0 + a_col] : hzero;
+                an1 = r0_ok ? A2[a_row0 + a_col + 4] : hzero;
+            }
+
+            const uint32_t* tp_slice = &sh_ring[warp][i % RING][0];
+
+            #pragma unroll
+            for (int t = 0; t < WNT; ++t)
+            {
+                FragB f0, f1;
+                const uint32_t* tp = tp_slice + t * TWORDS;
+                exl3_gemv_ns::dq8_regs_4bits<cb>(tp[(lane + 31) & 31], tp[lane], f0, f1);
+                exl3_gemv_ns::mma_ab_h(a01, a23, f0, ch[t][0]);
+                exl3_gemv_ns::mma_ab_h(a01, a23, f1, ch[t][1]);
+            }
+
+            // Every lane is done with this slot before any lane refills it (next iteration)
+            __syncwarp();
+
+            if ((d + 1) % FOLD == 0 || i + 1 == myn)
+            {
+                #pragma unroll
+                for (int t = 0; t < WNT; ++t)
+                    #pragma unroll
+                    for (int f = 0; f < 2; ++f)
+                    {
+                        acc0[t][f].x += __low2float(ch[t][f][0]);
+                        acc0[t][f].y += __high2float(ch[t][f][0]);
+                        ch[t][f][0] = hzero;
+                    }
+            }
+        }
+        }
+
+        // Cross-warp reduction over the k splits (served code)
+        {
+            const int c0 = 2 * (lane & 3);
+            const bool store0 = MMODE == 0 ? lane < 4 : r0 < ROWS;
+            const int sr0 = MMODE == 0 ? 0 : r0;
+            if (store0)
+            {
+                #pragma unroll
+                for (int t = 0; t < WNT; ++t)
+                    #pragma unroll
+                    for (int f = 0; f < 2; ++f)
+                    {
+                        const int col = t * 16 + f * 8 + c0;
+                        sh_red[warp][sr0][col + 0] = acc0[t][f].x;
+                        sh_red[warp][sr0][col + 1] = acc0[t][f].y;
+                    }
+            }
+        }
+        __syncthreads();
+
+        const int rows_out = MMODE == 0 ? 1 : min(size_m, ROWS);
+        for (int idx = threadIdx.x; idx < COLS * rows_out; idx += THREADS)
+        {
+            const int r = idx / COLS;
+            const int c = idx % COLS;
+            float sum = 0.0f;
+            #pragma unroll
+            for (int j = 0; j < WK; ++j)
+                sum += sh_red[j][r][c];
+            const int col = group * COLS + c;
+            if constexpr (c_fp32) ((float*) C)[(size_t) r * size_n + col] = sum;
+            else                  ((half*)  C)[(size_t) r * size_n + col] = __float2half_rn(sum);
+        }
+        __syncthreads();
+
+        // 4. Output transform of a 128-column block by the block that completes it
