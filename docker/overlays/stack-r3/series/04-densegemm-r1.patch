+    int size_m, int size_k, int size_n, int K, int cb, bool c_fp32,
+    int device, cudaStream_t stream, int* out_tag
+);
+
+// V2 twin of an exl3_gemv_kernel launch already decided by exl3_gemv_try_launch
+void* dense_v2_launch_gemv
+(
+    void** kernel_args,         // the 10 exl3_gemm_kernel arguments
