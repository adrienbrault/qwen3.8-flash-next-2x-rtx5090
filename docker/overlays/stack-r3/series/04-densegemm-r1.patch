+                        frag_c[0][n][1] += *sh_red++;
+                    }
+                }
+            }
+            else
+            {
+                if (sub_k == i)
+                {
+                    float* sh_red = sh_c + (FRAGS_N_PER_WARP * 4 * TILEBLOCKS_M) * t;
+                    #pragma unroll
+                    for (int m = 0; m < TILEBLOCKS_M; ++m)
+                    {
+                        bool row_ok = (m * 16 + lane_id / 4) < size_m;
+                        #pragma unroll
+                        for (int n = 0; n < FRAGS_N_PER_WARP; ++n)
