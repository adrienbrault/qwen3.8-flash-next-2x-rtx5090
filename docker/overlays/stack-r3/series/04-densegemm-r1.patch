+{
+    int bszm = MAX(bszm_in, bszm_out);
+    auto grid = cg::this_grid();
+
+    #if defined(__CUDA_ARCH__) && (__CUDA_ARCH__ > 890)
+        int* barrier_counters_sense = locks + BARRIER_LOCKS_OFFSET;
+    #endif
+
+    auto group_sync = [&] ()
+    {
+        #if defined(__CUDA_ARCH__) && (__CUDA_ARCH__ > 890)
+            group_barrier(blockIdx.z, gridDim.x, barrier_counters_sense);
+        #else
+            grid.sync();
+        #endif
+    };
+
+    const int slot_floats = exl3_dense_v2_slot_floats(TILESIZE_M, TILESIZE_N, size_m);
+    float* ws_z = ws + (size_t) blockIdx.z * gridDim.x * slot_floats;
+
+    for (int i = 0; i < bszm; i += gridDim.z)
+    {
+        const bool first_iter = i == 0;
+        int j = i + blockIdx.z;
+        int mat_index = -1;
+        const uint16_t* B = nullptr;
+        if (j >= bszm) j = -1;
+        else
+        {
+            mat_index = j;
+            B = B_list[mat_index];
+        }
