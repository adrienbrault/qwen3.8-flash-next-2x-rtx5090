+        {
+            FSTAGE_V2(1, 0);
+            FSTAGE_V2(2, 1);
+            FSTAGE_V2(3, 2);
+            FSTAGE_V2(0, 3);
+        }
+    }
+
+    if constexpr (FRAG_STAGES == 5)
+    {
+        while (true)
+        {
+            FSTAGE_V2(1, 0);
+            FSTAGE_V2(2, 1);
+            FSTAGE_V2(3, 2);
+            FSTAGE_V2(4, 3);
+            FSTAGE_V2(0, 4);
+        }
+    }
+
+    #undef FSTAGE_OLD_V2
+    #undef FSTAGE_V2
+}
