+            }
+            if (r1 < size_m)
+            {
+                #pragma unroll
+                for (int n = 0; n < FRAGS_N_PER_WARP; ++n)
+                    *((half2*) (sh_h + r1 * TILESIZE_N + (n0 + n) * 8 + c)) =
