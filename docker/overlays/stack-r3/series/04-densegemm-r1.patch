diff -ruN -x __pycache__ -x *.orig -x *.rej a/exllamav3_ext/quant/exl3_gemm_inner_v2.cuh b/exllamav3_ext/quant/exl3_gemm_inner_v2.cuh
--- a/exllamav3_ext/quant/exl3_gemm_inner_v2.cuh	1970-01-01 01:00:00
+++ b/exllamav3_ext/quant/exl3_gemm_inner_v2.cuh	2026-09-24 14:03:18
@@ -0,0 +1,1018 @@
+#pragma once
+
+// densegemm r1 (EXL3_DENSE_V2 / EXL3_DENSE_ROWS32, default off): the dense stream-K inner loop of
+// exl3_gemm_kernel_inner (exl3_gemm_inner.cuh) with three changes that leave every floating-point
+// operation, its operands and its order unchanged:
+//
+//   1. Weight prologue first. The first SH_STAGES - 1 weight (B) tiles are issued with cp.async
+//      BEFORE the caller's input stage (Hadamard of A + grid / group barrier, passed in as pre_a),
+//      the A tiles after it. B does not depend on A, so the first DRAM round trip overlaps the
+//      input stage instead of following it.
+//
+//   2. Gathered stream-K fixup. The served kernel sums the k-segments of an output column tile as a
+//      chain: the segment holding the top k writes its partial into C, then each lower segment in
+//      turn waits on the column lock, reads the running sum, adds its own partial and writes it
+//      back (rounded to fp16 when C is fp16), down to the segment holding k = 0. With nseg segments
+//      that is nseg - 1 serialized lock handoffs at the end of every call (5 for the served GDN
+//      out_proj at 16 rows). Here every segment except the k = 0 one ("head") publishes its fp32
+//      partial into its CTA's slot in a workspace and bumps the column lock once, without waiting;
+//      the head waits for the count, then folds the partials in the SAME order with the SAME
+//      intermediate rounding: S = P_top; S = P_i + rnd(S) for each lower segment; own P + rnd(S),
+//      where rnd() is the fp16 round trip the served kernel applies when it stores the running sum
+//      into an fp16 C, and the identity for fp32 C. fp32 addition is commutative, so P + S == S + P
+//      bitwise; the association (the order of the chain) is what is preserved. A CTA publishes at
+//      most one partial (its first segment, the only one that can start mid-column), so the slot
+//      index is the CTA index.
+//
+//   3. Output Hadamard in the finalizing CTA. The head (or a CTA owning a whole column tile) stages
+//      the final sums in shared memory and applies the output transform itself, as the served
+//      exl3_gemm_kernel already does (shmem_out_had). EPI 0 = exl3_gemm_kernel semantics (fp32 sums
+//      -> had_ff / had_fh). EPI 1 = exl3_mgemm_kernel semantics: that kernel rounds the final sum to
+//      the C dtype, writes it, and then runs had_ff / had_hf over C after a group barrier; here the
+//      same rounded values go through the same functions from shared memory.
+//
+// Everything else (tiling, slice partition, pipeline, dequantization, MMA sequence, threadblock
+// reduction over sub_k) is the served code, copied verbatim. The partition depends only on
+// gridDim.x and the tile counts, so a V2 launch with the served (autotuned) grid computes the same
+// partial sums as the served kernel. TILESIZE_M == 32 (EXL3_DENSE_ROWS32) runs rows 17-32 in one
+// pass: each 16-row block sees the same B fragments, k order and reduction as the served kernel's
+// second 16-row chunk.
+
+#include "hadamard_inner.cuh"
+#include "exl3_gemm_inner.cuh"
+
+// Slot layout: rows <= 8 at TILESIZE_M == 16 store only the fragment halves that hold rows 0-7
+// (float2 per fragment); everything else stores whole fragments (float4)
+__host__ __device__ inline int exl3_dense_v2_slot_floats(int tilesize_m, int tilesize_n, int size_m)
+{
+    return (tilesize_m == 16 && size_m <= 8) ? 8 * tilesize_n : tilesize_m * tilesize_n;
+}
+
+template<EXL3_GEMM_T_ARGS, int EPI, typename PreA>
+inline __device__
+void exl3_gemm_kernel_inner_v2
+(
+    const half* __restrict__  A,
+    const uint16_t* __restrict__ B,
+    void* __restrict__ C,
+    const int size_m,
+    const int size_k,
+    const int size_n,
+    int* __restrict__ locks,
+    const half* post_scale,
+    int size_n_stride,              // full width of B and C when computing a column slice (0: = size_n)
+    float* __restrict__ ws_slots,   // this z-group's partial-sum slots, slot b at b * slot_floats
+    PreA pre_a                      // input stage: every thread of the block calls it exactly once
+)
+{
+    const int TILEBLOCKS_M = TILESIZE_M / 16;
+    if (size_n_stride == 0) size_n_stride = size_n;
+    const int blocks_n_full = size_n_stride / 16;
+    const int TILEBLOCKS_K = TILESIZE_K / 16;
+    const int TILEBLOCKS_N = TILESIZE_N / 16;
+    const int FRAGS_N_PER_WARP = 2 * TILEBLOCKS_N / (EXL3_GEMM_BASE_THREADS / 32);
+
+    const int sh_a_stage_size = TILESIZE_M * TILESIZE_K;                         // in halfs
+    const int sh_b_stage_size = TILEBLOCKS_K * TILEBLOCKS_N * 256 / 16 * bits;   // in uint16s
+    const int sh_c_size = MAX  // in floats
+    (
+        4 * EXL3_GEMM_BASE_THREADS * FRAGS_N_PER_WARP * TILEBLOCKS_M,
+        TILESIZE_N * TILESIZE_M
+    );
+
+    const int A_COLS = TILESIZE_K / 8;
+    const int A_SWIZZLE_MASK = A_COLS - 1;
+    const int A_SWIZZLE_SHIFT = (A_COLS <= 2) ? 2 : 1;
+
+    static_assert(EXL3_GEMM_BASE_THREADS == 256);
+    static_assert(TILESIZE_M == 16 || TILESIZE_M == 32, "V2: 16 or 32 rows per tile");
+    static_assert(TILESIZE_K % 16 == 0, "Invalid kernel params");
+    static_assert(TILESIZE_N % 128 == 0, "Invalid kernel params");
+    static_assert(EPI == 0 || EPI == 1, "V2: epilogue 0 (gemm) or 1 (mgemm)");
+    static_assert
+    (
+        SMEM_MAX >= SH_STAGES * (2 * sh_a_stage_size + 2 * sh_b_stage_size) + 4 * sh_c_size,
+        "Invalid kernel params (insufficient shared memory for shape)"
+    );
+
+    extern __shared__ half shared[];
+    half* sh_a = shared;
+    uint16_t* sh_b = (uint16_t*) (sh_a + SH_STAGES * sh_a_stage_size);
+    float* sh_c = (float*) (sh_b + sh_b_stage_size * SH_STAGES);
+
+    int t = threadIdx.x % EXL3_GEMM_BASE_THREADS;
+    int sub_k = threadIdx.x / EXL3_GEMM_BASE_THREADS;
+    int warp_id = t / 32;
+    int lane_id = t % 32;
+
+    int tiles_k = size_k / TILESIZE_K;
+    int tiles_n = size_n / TILESIZE_N;
+    int blocks_n = tiles_n * TILEBLOCKS_N;
+
+    // Slice partition: identical to the served kernel
+    int num_slices = gridDim.x;
+    int slice_beg = tiles_k * tiles_n * blockIdx.x / num_slices;
+    int slice_end = tiles_k * tiles_n * (blockIdx.x + 1) / num_slices;
+    int slice_len = slice_end - slice_beg;
+    if (slice_len < 1)
+    {
+        // An empty CTA still takes part in the input stage's barrier
+        pre_a();
+        return;
+    }
+
+    // First tile of CTA b (the served partition, in 64 bits)
+    const int64_t total_tiles = (int64_t) tiles_k * tiles_n;
+    auto tile_beg = [&] (int b) -> int
+    {
+        return (int) (total_tiles * b / num_slices);
+    };
+    // Largest CTA whose slice starts at or before tile i: the CTA holding tile i (always non-empty)
+    auto owner = [&] (int i) -> int
+    {
+        return (int) ((((int64_t) i + 1) * num_slices - 1) / total_tiles);
+    };
+
+    auto index_k = [&] (int slice_i) { return (slice_i % tiles_k); };
+    auto index_n = [&] (int slice_i) { return (slice_i / tiles_k); };
+
+    const int slice_m = 0;
+
+    int slice0_k = index_k(slice_beg);
+    int slice0_n = index_n(slice_beg);
+    int slice0_iters = slice_len;
+
+    int gl_a_stride_m = TILESIZE_M * size_k;
+    const int gl_a_stride_k = TILESIZE_K;
+    const int sh0_a_stride_m = TILESIZE_M * TILESIZE_K;
+    const half* gl_a_ptr = A + slice_m * gl_a_stride_m + slice0_k * gl_a_stride_k;
+    half* sh0_a_ptr = sh_a + (slice0_iters % SH_STAGES) * sh_a_stage_size;
+
+    const int load_a_iters = CEIL_DIVIDE(sh0_a_stride_m / 8, EXL3_GEMM_BASE_THREADS);
+    bool pred_a_gl[load_a_iters];
+    int load_a_gl[load_a_iters];
+    int load_a_sh[load_a_iters];
+    for (int i = 0; i < load_a_iters; ++i)
+    {
+        int k = (i * EXL3_GEMM_BASE_THREADS + t) % (gl_a_stride_k / 8);
+        int m = (i * EXL3_GEMM_BASE_THREADS + t) / (gl_a_stride_k / 8);
+        load_a_gl[i] = m * size_k / 8 + k;
+        load_a_sh[i] = m * A_COLS + (k ^ ((m >> A_SWIZZLE_SHIFT) & A_SWIZZLE_MASK));
+        pred_a_gl[i] = m < size_m;
+    }
+
+    int gl_b_stride_k = blocks_n_full * TILEBLOCKS_K * 256 / 16 * bits;
+    const int gl_b_stride_n = TILEBLOCKS_N * 256 / 16 * bits;
+    const int sh0_b_stride_k = TILEBLOCKS_K * TILEBLOCKS_N * 256 / 16 * bits;
+    const uint16_t* gl_b_ptr = B + slice0_k * gl_b_stride_k + slice0_n * gl_b_stride_n;
+    uint16_t* sh0_b_ptr = sh_b + (slice0_iters % SH_STAGES) * sh_b_stage_size;
+
+    const int load_b_iters = CEIL_DIVIDE(sh0_b_stride_k / 8, EXL3_GEMM_BASE_THREADS);
+    bool pred_b_gl[load_b_iters];
+    int load_b_gl[load_b_iters];
+    for (int i = 0; i < load_b_iters; ++i)
+    {
+        int n = (i * EXL3_GEMM_BASE_THREADS + t) % (gl_b_stride_n / 8);
+        int k = (i * EXL3_GEMM_BASE_THREADS + t) / (gl_b_stride_n / 8);
+        load_b_gl[i] = k * (blocks_n_full * 256 / 16 * bits / 8) + n;
+        pred_b_gl[i] = i * EXL3_GEMM_BASE_THREADS + t < sh0_b_stride_k / 8;
+    }
+
+    auto advance0 = [&] ()
+    {
+        slice0_k++;
+        slice0_iters--;
+
+        int stage = slice0_iters % SH_STAGES;
+        sh0_a_ptr = sh_a + stage * sh_a_stage_size;
+        sh0_b_ptr = sh_b + stage * sh_b_stage_size;
+
+        if (slice0_k >= tiles_k)
+        {
+            slice0_k = 0;
+            slice0_n++;
+            gl_a_ptr = A + slice_m * gl_a_stride_m + slice0_k * gl_a_stride_k;
+            gl_b_ptr = B + slice0_k * gl_b_stride_k + slice0_n * gl_b_stride_n;
+        }
+        else
+        {
+            gl_a_ptr += gl_a_stride_k;
+            gl_b_ptr += gl_b_stride_k;
+        }
+    };
+
+    int slice1_k = slice0_k;
+    int slice1_n = slice0_n;
+    int slice1_iters = slice0_iters;
+
+    half* sh1_a_ptr = sh_a + (slice1_iters % SH_STAGES) * sh_a_stage_size;
+    uint16_t* sh1_b_ptr = sh_b + (slice1_iters % SH_STAGES) * sh_b_stage_size;
+
+    auto advance1 = [&] ()
+    {
+        slice1_k++;
+        slice1_iters--;
+
+        int stage = slice1_iters % SH_STAGES;
+        sh1_a_ptr = sh_a + stage * sh_a_stage_size;
+        sh1_b_ptr = sh_b + stage * sh_b_stage_size;
+
+        if (slice1_k >= tiles_k)
+        {
+            slice1_k = 0;
+            slice1_n++;
+        }
+    };
+
+    int slice2_k = slice0_k;
+    int slice2_k0 = slice0_k;
+    int slice2_n = slice0_n;
+    int slice2_iters = slice0_iters;
+
+    int gl_c_stride_n = TILESIZE_N;
+    int gl_c_stride_m = TILESIZE_M * size_n_stride;
+
+    half* gl_c_ptr_16 = ((half*) C) + slice_m * gl_c_stride_m + slice2_n * gl_c_stride_n;
+    float* gl_c_ptr_32 = ((float*) C) + slice_m * gl_c_stride_m + slice2_n * gl_c_stride_n;
+
+    register FragA frag_a[TILEBLOCKS_M == 1 ? FRAG_STAGES : TILEBLOCKS_M];
+    register FragB frag_b[FRAG_STAGES][FRAGS_N_PER_WARP];
+    register FragC frag_c[TILEBLOCKS_M][FRAGS_N_PER_WARP];
+    #if EXL3_GEMM_H_ACC
+        register FragC_h frag_c_h[TILEBLOCKS_M][FRAGS_N_PER_WARP];
+    #endif
+
+    auto advance2 = [&] ()
+    {
+        slice2_k++;
+        slice2_iters--;
+
+        if (slice2_k >= tiles_k)
+        {
+            slice2_k = 0;
+            slice2_k0 = 0;
+            slice2_n++;
+            if constexpr (c_fp32)
+                gl_c_ptr_32 += gl_c_stride_n;
+            else
+                gl_c_ptr_16 += gl_c_stride_n;
+        }
+    };
+
+    // The two halves of the served async_load_gl: A tile, B tile (sub_k == 0 threads only)
+    auto load_a_stage = [&] ()
+    {
+        const int4* gl = (const int4*) gl_a_ptr;
+        int4* sh = (int4*) sh0_a_ptr;
+        #pragma unroll
+        for (int i = 0; i < load_a_iters; ++i)
+        {
+            if (pred_a_gl[i]) cp_async(sh + load_a_sh[i], gl + load_a_gl[i]);
+        }
+    };
+
+    auto load_b_stage = [&] ()
+    {
+        const int4* gl = (const int4*) gl_b_ptr;
+        int4* sh = (int4*) sh0_b_ptr;
+        #pragma unroll
+        for (int i = 0; i < load_b_iters; ++i)
+        {
+            if (pred_b_gl[i]) cp_async(sh + EXL3_GEMM_BASE_THREADS * i + t, gl + load_b_gl[i]);
+        }
+    };
+
+    auto async_load_gl = [&] ()
+    {
+        if (sub_k)
+        {
+            cp_async_fence();
+            return;
+        }
+
+        if (slice0_iters)
+        {
+            load_a_stage();
+            load_b_stage();
+            advance0();
+        }
+
+        cp_async_fence();
+    };
+
+    auto load_frags = [&] (int buf)
+    {
+        if (!slice1_iters) return;
+
+        {
+            int r = (lane_id % 8) + 8 * ((lane_id / 8) % 2);
+            int base_c = lane_id / 16 + sub_k * 2;
+            #pragma unroll
+            for (int m = 0; m < TILEBLOCKS_M; ++m)
+            {
+                int R = r + m * 16;
+                int c_swizzled = base_c ^ ((R >> A_SWIZZLE_SHIFT) & A_SWIZZLE_MASK);
+                ldsm4(frag_a[TILEBLOCKS_M == 1 ? buf : m], (int4*) sh1_a_ptr + R * A_COLS + c_swizzled);
+            }
+        }
+
+        #pragma unroll
+        for (int n2 = 0; n2 < FRAGS_N_PER_WARP; n2 += 2)
+        {
+            int sub_n2 = warp_id * FRAGS_N_PER_WARP / 2 + n2 / 2;
+            const uint32_t* shb = (const uint32_t*) (sh1_b_ptr + (sub_k * TILEBLOCKS_N + sub_n2) * 256 / 16 * bits);
+
+            dq_dispatch<bits, cb>(shb, lane_id << 3, frag_b[buf][n2], frag_b[buf][n2 + 1]);
+        }
+
+        __syncthreads();
+        advance1();
+    };
+
+    auto clear_frag_c = [&] ()
+    {
+        #pragma unroll
+        for (int m = 0; m < TILEBLOCKS_M; ++m)
+            #pragma unroll
+            for (int n = 0; n < FRAGS_N_PER_WARP; ++n)
+                frag_c[m][n] = {};
+        #if EXL3_GEMM_H_ACC
+            #pragma unroll
+            for (int m = 0; m < TILEBLOCKS_M; ++m)
+                #pragma unroll
+                for (int n = 0; n < FRAGS_N_PER_WARP; ++n)
+                    frag_c_h[m][n] = {};
+        #endif
+    };
+
+    // Threadblock reduction over sub_k: served code
+    auto threadblock_reduce = [&] ()
+    {
+        auto store = [&] (int i)
+        {
+            if (sub_k == i)
+            {
+                if constexpr (TILEBLOCKS_M == 1)
+                {
+                    float* sh_red = sh_c + (FRAGS_N_PER_WARP * 4) * t;
+                    #pragma unroll
+                    for (int n = 0; n < FRAGS_N_PER_WARP; ++n)
+                    {
+                        #pragma unroll
+                        for (int j = 0; j < 4; ++j) *sh_red++ = frag_c[0][n][j];
+                    }
+                }
+                else
+                {
+                    float* sh_red = sh_c + (FRAGS_N_PER_WARP * 4 * TILEBLOCKS_M) * t;
+                    #pragma unroll
+                    for (int m = 0; m < TILEBLOCKS_M; ++m)
+                        #pragma unroll
+                        for (int n = 0; n < FRAGS_N_PER_WARP; ++n)
+                        {
+                            #pragma unroll
+                            for (int j = 0; j < 4; ++j) *sh_red++ = frag_c[m][n][j];
+                        }
+                }
+            }
+            __syncthreads();
+        };
+
+        auto add = [&] (int i)
+        {
+            if (sub_k == i)
+            {
+                if constexpr (TILEBLOCKS_M == 1)
+                {
+                    float* sh_red = sh_c + (FRAGS_N_PER_WARP * 4) * t;
+                    #pragma unroll
+                    for (int n = 0; n < FRAGS_N_PER_WARP; ++n)
