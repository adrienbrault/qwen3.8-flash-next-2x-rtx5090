+        exl3_gemm_kernel_inner_v2
+        <bits, c_fp32, cb, TILESIZE_M, TILESIZE_K, TILESIZE_N, SH_STAGES, FRAG_STAGES, 1>
+        (A_, B, C_, size_m, size_k, n_j, locks + lock_offs, svh_list[mat_index], n_stride_j, ws_z, pre_a);
+    }
+}
+
