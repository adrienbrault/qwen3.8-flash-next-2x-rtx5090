+// latchain r1 (EXL3_LC_GDN_RR=1): cuda_recurrent_gated_delta_rule_kernel_128 (per-head decay, no
+// CHANNELWISE) with the same thread layout, the same per-token arithmetic and the same stores,
+// minus two memory round trips per token:
+//   * the recurrent state is carried in registers from one token to the next. The served kernel
+//     re-reads it twice per token (the kv_mem dot, then the update) from the slot/history buffer it
+//     wrote at the previous token; each thread reads and writes only its own 32 state elements, so
+//     the value it reads back is exactly the value it stored, rounded by store_state. The register
+//     copy is rounded the same way (lc_state_reload), so every read sees the same bits;
+//   * token s + 1's q/k/v/g/beta are loaded (as raw bf16/fp32) while token s computes, and the
+//     token's v/g/beta are no longer loaded behind the dot-1 barrier.
+// Every expression that produces a stored or output value is textually the served one (same
+// operand order, same fp contraction opportunities), and the stores (history slots, final state,
+// output) are the served ones in the served order per thread. Graph parameters: identical
+// signature, so the state (3) and slots (12) patch sites are unchanged.
+__device__ __forceinline__ float lc_state_reload(const float*, float x)
+{
+    return x;
+}
+
+__device__ __forceinline__ float lc_state_reload(const bfloat16*, float x)
+{
+    return __bfloat162float(__float2bfloat16_rn(x));
+}
+
+template <bool save_history, int V_SPLIT, typename state_t = float>
+__global__ __launch_bounds__(128 * SUBK)
+void cuda_recurrent_gated_delta_rule_kernel_128_rr
+(
+                                                // k_head_dim = v_head_dim = 128
+    const bfloat16* __restrict__ mixed_qkv,     // [bsz, seqlen, (k_dim + k_dim + v_dim)]
+    const float* __restrict__ g,                // [bsz, seqlen, (group * num_k_heads)]
+    const bfloat16* __restrict__ beta,          // [bsz, seqlen, (group * num_k_heads)]
+    state_t* __restrict__ recurrent_state,      // [num_slots, max_history + 1, (group * num_k_heads), 128, 128]
+    bfloat16* __restrict__ core_attn_out,       // [bsz, seqlen, num_v_heads, 128]
+    const int bsz,
+    const int seqlen,
+    const int num_k_heads,
+    const int num_v_heads,
+    const int k_head_dim,
+    const int v_head_dim,
+    const float scale,
+    const int* __restrict__ slots,              // [bsz]
+    const int history_stride,                   // max_history + 1
+    const float* __restrict__ D                 // unused, matches the generic kernel signature
+)
+{
+    constexpr int HEAD_DIM = 128;
+    constexpr int V_CHUNK_DIM = HEAD_DIM / V_SPLIT;
+    constexpr int BTS = HEAD_DIM / SUBK;
+
+    int group = num_v_heads / num_k_heads;
+    constexpr size_t HEAD_STATE_SIZE = HEAD_DIM * HEAD_DIM;
+    const size_t state_size = group * num_k_heads * HEAD_STATE_SIZE;
+    const size_t slot_size = (size_t) history_stride * state_size;
+
+    int bi = blockIdx.x;
+    mixed_qkv +=        bi * seqlen * (3 * HEAD_DIM * num_k_heads + HEAD_DIM * (num_v_heads - num_k_heads));
+    g +=                (size_t) bi * seqlen * (group * num_k_heads);
+    beta +=             bi * seqlen * (group * num_k_heads);
+    int state_slot = slots ? slots[bi] : bi;
+    state_t* slot_state = recurrent_state + (size_t) state_slot * slot_size;
+    state_t* final_state = slot_state;
+    core_attn_out +=    bi * seqlen * num_v_heads * HEAD_DIM;
+
+    int t = threadIdx.x;
+    int bt = threadIdx.y;
+    int lane = t % 32;
+    int warp = t / 32;
+    int head = blockIdx.y;
+    int k_head = head / group;
+    int v_chunk = blockIdx.z;
+    int v_start = v_chunk * V_CHUNK_DIM;
+    const bool active = t < V_CHUNK_DIM;
+    const int qkv_stride = 2 * HEAD_DIM * num_k_heads + HEAD_DIM * num_v_heads;
+    const int q_off = k_head * HEAD_DIM + t;
+    const int k_off = (num_k_heads + k_head) * HEAD_DIM + t;
+    const int v_off = (2 * num_k_heads * HEAD_DIM) + head * HEAD_DIM + v_start + t;
+
+    __shared__ float sh_red[2][HEAD_DIM / 32];
+    __shared__ float sh_k[HEAD_DIM];
+    __shared__ float sh_q[HEAD_DIM];
+    // Per-k-slice partials, reduced in a fixed order by the consumer (see the generic kernel)
+    __shared__ float sh_dot1[SUBK][HEAD_DIM];
+    __shared__ float sh_dot2[SUBK][HEAD_DIM];
+
+    // The state token 0 reads: the slot's current state in both modes (history: first == true).
+    // Element e of this thread is row bt * BTS + e, column v_start + t
+    float st[BTS];
+    if (active)
+    {
+        const state_t* rs0 = final_state + head * HEAD_STATE_SIZE + v_start + t + bt * BTS * HEAD_DIM;
+        #pragma unroll
+        for (int e = 0; e < BTS; ++e)
+            st[e] = as_float(rs0[e * HEAD_DIM]);
+    }
+
+    // Token 0 operands, kept raw so the loads are only waited on at first use
+    bfloat16 nx_q = mixed_qkv[q_off];
+    bfloat16 nx_k = mixed_qkv[k_off];
+    bfloat16 nx_v = active ? mixed_qkv[v_off] : mixed_qkv[q_off];
+    float nx_g = g[head];
+    bfloat16 nx_beta = beta[head];
+
+    for (int s = 0; s < seqlen; ++s)
+    {
+        bfloat16* out = core_attn_out + head * HEAD_DIM + v_start;
+
+        state_t* gl_rs_w;
+        if constexpr (save_history)
+        {
+            bool last = (s == seqlen - 1);
+            state_t* history_w = last  ? final_state : slot_state + (size_t) (s + 1) * state_size;
+            gl_rs_w = history_w + head * HEAD_STATE_SIZE;
+        }
+        else
+        {
+            gl_rs_w = final_state + head * HEAD_STATE_SIZE;
+        }
+
+        const bfloat16 cu_q = nx_q;
+        const bfloat16 cu_k = nx_k;
+        const bfloat16 cu_v = nx_v;
+        const float cu_g = nx_g;
+        const bfloat16 cu_beta = nx_beta;
+
+        // Next token's operands: issued now, consumed one token later
+        if (s + 1 < seqlen)
+        {
+            const bfloat16* nq = mixed_qkv + qkv_stride;
+            nx_q = nq[q_off];
+            nx_k = nq[k_off];
+            nx_v = active ? nq[v_off] : nq[q_off];
+            nx_g = g[num_v_heads + head];
+            nx_beta = beta[num_v_heads + head];
+        }
+
+        float q = __bfloat162float(cu_q);
+        float k = __bfloat162float(cu_k);
+
+        float sumq = q * q;
+        float sumk = k * k;
+        #pragma unroll
+        for(int offset = 16; offset > 0; offset /= 2)
+        {
+            sumq += __shfl_xor_sync(0xffffffff, sumq, offset);
+            sumk += __shfl_xor_sync(0xffffffff, sumk, offset);
+        }
+        if (lane == 0)
+        {
+            sh_red[0][warp] = sumq;
+            sh_red[1][warp] = sumk;
+        }
+        __syncthreads();
+
+        sumq = lane < HEAD_DIM / 32 ? sh_red[0][lane] : 0.0f;
+        sumk = lane < HEAD_DIM / 32 ? sh_red[1][lane] : 0.0f;
+        #pragma unroll
+        for(int offset = 16; offset > 0; offset /= 2)
+        {
+            sumq += __shfl_xor_sync(0xffffffff, sumq, offset);
+            sumk += __shfl_xor_sync(0xffffffff, sumk, offset);
+        }
+
+        q = q * rsqrtf(sumq + 1e-6f);
+        k = k * rsqrtf(sumk + 1e-6f);
+        sh_k[t] = k;
+        sh_q[t] = q;
+
+        __syncthreads();
+
+        if (t < V_CHUNK_DIM)
+        {
+            float sum = 0.0f;
+            float* sh_k_rd = sh_k + bt * BTS;
+
+            #pragma unroll
+            for (int i = 0; i < HEAD_DIM / 8 / SUBK; ++i)
+            {
+                #pragma unroll
+                for (int j = 0; j < 8; ++j, sh_k_rd++)
+                {
+                    sum = sum + *sh_k_rd * st[i * 8 + j];
+                }
+            }
+            sh_dot1[bt][t] = sum;
+        }
+        __syncthreads();
+
+        if (t < V_CHUNK_DIM)
+        {
+            float g_h = __expf(cu_g);
+            float beta_h = __bfloat162float(cu_beta);
+            float dot1 = 0.0f;
+            #pragma unroll
+            for (int s = 0; s < SUBK; ++s) dot1 += sh_dot1[s][t];
+            float v = __bfloat162float(cu_v) - dot1 * g_h;
+            float v_out = 0.0f;
+            float* sh_k_rd = sh_k + bt * BTS;
+            float* sh_q_rd = sh_q + bt * BTS;
+            state_t* rs_w = gl_rs_w + v_start + t + bt * BTS * HEAD_DIM;
+
+            #pragma unroll
+            for (int i = 0; i < HEAD_DIM / 8 / SUBK; ++i)
+            {
+                #pragma unroll
+                for (int j = 0; j < 8; ++j, rs_w += HEAD_DIM, sh_k_rd++, sh_q_rd++)
+                {
+                    float state = st[i * 8 + j];
+                    state = state * g_h + *sh_k_rd * v * beta_h;
+                    store_state(rs_w, state);
+                    st[i * 8 + j] = lc_state_reload(rs_w, state);
+                    v_out = v_out + *sh_q_rd * state;
+                }
+            }
+            sh_dot2[bt][t] = v_out;
+        }
+        __syncthreads();
+
+        if (t < V_CHUNK_DIM && bt == 0)
+        {
+            float v_out = 0.0f;
+            #pragma unroll
+            for (int s = 0; s < SUBK; ++s) v_out += sh_dot2[s][t];
+            out[t] = __float2bfloat16_rz(v_out * scale);
+        }
+
+        mixed_qkv +=        qkv_stride;
+        g +=                num_v_heads;
+        beta +=             num_v_heads;
+        core_attn_out +=    num_v_heads * HEAD_DIM;
+    }
+}
+
+// EXL3_LC_GDN_RR: read per launch (a captured graph keeps the kernel it was captured with)
+static bool lc_gdn_rr_enabled()
+{
+    const char* e = std::getenv("EXL3_LC_GDN_RR");
+    if (!e || !*e || !std::strcmp(e, "0")) return false;
+    TORCH_CHECK(!std::strcmp(e, "1"), "EXL3_LC_GDN_RR must be 0 or 1");
+    return true;
+}
