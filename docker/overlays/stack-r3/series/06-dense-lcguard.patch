diff -ruN -x __pycache__ -x *.orig a/exllamav3_ext/quant/exl3_dense_v2.cuh b/exllamav3_ext/quant/exl3_dense_v2.cuh
--- a/exllamav3_ext/quant/exl3_dense_v2.cuh
+++ b/exllamav3_ext/quant/exl3_dense_v2.cuh
@@ -27,6 +27,26 @@
 inline bool dense_v2_gemm_on() { int m = dense_v2_mode(); return m == 1 || m == 2; }
 inline bool dense_v2_gemv_on() { int m = dense_v2_mode(); return m == 1 || m == 3; }
 
+// stack-r3 lcguard (latchain EXL3_LC_QSA_FORK x densegemm). latchain captures the QSA indexer chain of each
+// attention layer on a side stream that runs concurrently with the main branch's q/k/v projections; its one dense
+// call, exl3_gemm_gr(index_qk), passes locks = the device's lock base + LC_LOCKS_ALT_OFFSET (libtorch/lc_fork.h).
+// The V2 twins keep per-device scratch (g_ws in exl3_dense_v2.cu): partial-sum slots (gemm / mgemm twins) and
+// output-block arrival counters (gemv twin), one copy each, so a twin on the side branch would share them with a
+// concurrent main-branch twin. A side-branch call therefore gets its own scratch: the gemv twin counts in the upper
+// half of hctr (the main branch uses the lower half; both halves are bounded to DENSE_V2_GEMV_MAX_HBLOCKS / 2
+// output blocks), the gemm twin writes a separate side slot region; a call that does not fit takes the served
+// kernel. Same kernels, same grids, same arithmetic: only the scratch addresses differ, baked into the captured
+// node like every other argument. The branch is read from the call's own locks argument (index 6 of the 10
+// exl3_gemm_kernel arguments), so this compiles with or without latchain: without it, and on every main-branch
+// call, locks is the base pointer and nothing changes. exl3_mgemm_gr never runs on the side branch.
+#define DENSE_V2_LC_GUARD 1
+inline bool dense_v2_on_side_branch(void* const* kernel_args, const int* base_locks)
+{
+    const int* locks = *((const int* const*) kernel_args[6]);
+    return locks != base_locks;
+}
+std::tuple<int64_t, int64_t> dense_v2_lc_side_counts();   // (side-branch twin launches, side calls sent to served), tests
+
 // V2 twin of the autotuned exl3_gemm_kernel launch this call would get (cache hit only). Returns
 // the launched kernel (for graph parameter recording) and sets *out_tag, or nullptr (nothing launched)
