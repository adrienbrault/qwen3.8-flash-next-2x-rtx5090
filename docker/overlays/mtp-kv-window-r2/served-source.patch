+from __future__ import annotations
+import os
+import torch
+from ..constants import PAGE_SIZE
+
+# EXL3_MTP_KV_WINDOW=<tokens> (default unset = off): windowed KV cache for the MTP draft layer.
+#
+# Served layout: the draft cache is a full-size twin of the main cache (same max_num_tokens, same
+# page indices), so the MTP layer pays one attention layer's worth of the page pool. With the flag
+# set, a Cache built for an MTP draft model (caps "mtp_draft") holds only
+#     slots x pages_per_slot pages,  pages_per_slot = tokens / PAGE_SIZE + 1
+# i.e. one sink page (positions 0..255) plus tokens / PAGE_SIZE ring pages per concurrent sequence.
+# Slot s owns physical pages [s * P, (s + 1) * P). A sequence's draft block-table row maps logical
+# page q to s * P for q == 0 and to s * P + 1 + (q - 1) % (P - 1) otherwise: the identity over the
+# first P pages, then every newer page lands on the ring page that held the page P - 1 before it.
+# Positions stay absolute (rope, pooled-key rope, causal bounds and every plane address are what the
+# served kernels compute), so every write and read of the draft layer goes through the same kernels
+# with a different block table; nothing reads outside the slot's own pages.
+#
+# What the draft layer then sees: up to P * PAGE_SIZE tokens (exact below that), beyond it the sink
+# page plus the most recent (P - 1) pages, the page being written included; the graph-captured sparse
+# scan is clamped to one ring cycle (BC_Attention.qsa_scan_cap) so each ring page is scored once.
+# Only the draft layer's attention changes, so only draft proposals (and acceptance) can change:
+# verification runs the target model on the main cache, whose layout and bytes are untouched.
+
+
+def _parse_window(raw: str | None) -> int:
+    if raw is None or raw.strip() == "":
+        return 0
+    try:
+        tokens = int(raw)
+    except ValueError:
+        raise ValueError(f"EXL3_MTP_KV_WINDOW must be an integer token count, got {raw!r}")
+    if tokens < 0:
+        raise ValueError(f"EXL3_MTP_KV_WINDOW must be >= 0, got {tokens}")
+    if tokens % PAGE_SIZE:
+        raise ValueError(f"EXL3_MTP_KV_WINDOW must be a multiple of the page size {PAGE_SIZE}, got {tokens}")
+    if tokens and tokens < 2 * PAGE_SIZE:
+        raise ValueError(f"EXL3_MTP_KV_WINDOW must be 0 (off) or at least {2 * PAGE_SIZE}, got {tokens}")
+    return tokens
+
+
+MTP_KV_WINDOW = _parse_window(os.environ.get("EXL3_MTP_KV_WINDOW"))
+
+
+def window_pages(window_tokens: int) -> int:
+    """Pages per slot: the sink page plus window_tokens / PAGE_SIZE ring pages."""
+    assert window_tokens > 0 and window_tokens % PAGE_SIZE == 0
+    return window_tokens // PAGE_SIZE + 1
+
+
+def window_pool_tokens(window_tokens: int, slots: int) -> int:
+    """max_num_tokens of the windowed draft cache for `slots` concurrent sequences."""
+    return window_pages(window_tokens) * PAGE_SIZE * slots
+
+
+def window_offsets(pages_per_slot: int, width: int) -> torch.Tensor:
+    """(width,) int32 offsets of logical pages 0..width-1 inside a slot's page run."""
+    assert pages_per_slot >= 2
+    q = torch.arange(width, dtype = torch.int32)
+    return torch.where(q == 0, q, 1 + (q - 1) % (pages_per_slot - 1)).to(torch.int32)
+
+
+class MTPWindow:
+    """Geometry of a windowed draft cache (attached to the Cache as cache.mtp_window)."""
+
+    def __init__(self, window_tokens: int, slots: int):
+        assert slots >= 1
+        self.window_tokens = window_tokens
+        self.slots = slots
+        self.pages_per_slot = window_pages(window_tokens)
+        # One ring cycle: the widest logical span that maps every page of a slot exactly once
+        self.scan_tokens = self.pages_per_slot * PAGE_SIZE
+        self.pool_tokens = window_pool_tokens(window_tokens, slots)
+
+    def __repr__(self):
+        return (f"MTPWindow(window_tokens={self.window_tokens}, slots={self.slots}, "
+                f"pages_per_slot={self.pages_per_slot}, pool_tokens={self.pool_tokens})")
+
+
+def ring_page(q: int, pages_per_slot: int) -> int:
+    """Offset of logical page q inside its slot's page run (the scalar form of window_offsets)."""
+    return 0 if q == 0 else 1 + (q - 1) % (pages_per_slot - 1)
+
+
+def release_tags(pages_per_slot: int, kv_position: int, page_hash, next_token) -> list:
+    """
+    What a slot holds when its job leaves the active set with kv_position committed tokens: one tag
+    (logical page, chained page hash, first token of the next page) per ring page that holds a whole
+    committed page, None elsewhere. A draft K/V row at position p depends on the tokens up to p + 1
+    (the MTP input pairs the target state of p with the embedding of p + 1), hence the next token.
+    Left out: the page being written (partial) and the ring page it shares with, and the ring page
+    of the next logical page, which rejected draft steps may have written past the committed end.
+    page_hash(L) / next_token(L) return None when unknown (the tag is then dropped).
+    """
+    P = pages_per_slot
+    tags = [None] * P
+    c = kv_position // PAGE_SIZE
+    for L in range(c):
+        if L and L <= c + 2 - P:
+            continue
+        h = page_hash(L)
+        t = next_token(L)
+        if h is None or t is None:
+            continue
+        tags[ring_page(L, P)] = (L, h, t)
+    return tags
+
+
+class MTPWindowSlots:
+    """
+    Slot leases for active jobs. A job is granted a slot on its first draft-cache access and keeps it
+    until it leaves the active set (completion, requeue, cancel, failure, clear_queue). On release
+    the slot keeps tags of the whole committed pages it still holds (release_tags). A grant takes
+    the free slot with the most tags matching the new job's prompt (a follow-up turn, a requeued job
+    or a prefix revived from the prompt cache / CPU tier / NVMe tier skips the prefill of those pages
+    and has no other source of draft K/V for them), ties to the slot released longest ago, and
+    reports every ring page without a matching tag: the caller clears those pages, so a revived span
+    reads either its own draft K/V or zeros, never another sequence's.
+    """
+
+    def __init__(self, slots: int, pages_per_slot: int):
+        self.slots = slots
+        self.pages_per_slot = pages_per_slot
+        self.free = list(range(slots))                                # release order, oldest first
+        self.leases = {}                                              # job key -> slot
+        self.tags = [[None] * pages_per_slot for _ in range(slots)]  # per free slot, see release_tags
+
+    def lookup(self, key):
+        return self.leases.get(key)
+
+    def grant(self, key, match = None, alive = None) -> tuple[int, list[int]]:
+        """(slot, ring pages to clear). match(tag) -> bool tests a tag against the new job."""
+        slot = self.leases.get(key)
+        if slot is not None:
+            return slot, []
+        if not self.free and alive is not None:
+            # Reclaim leases of jobs that left the active set without an explicit release
+            for stale in [k for k in self.leases if k not in alive]:
+                self.release(stale)
+        if not self.free:
+            raise RuntimeError(
+                f"EXL3_MTP_KV_WINDOW: all {self.slots} draft window slots are leased; the draft cache "
+                f"must be built with at least max_batch_size slots"
+            )
+        def valid(tag):
+            return tag is not None and match is not None and match(tag)
+        best, best_n = 0, -1
+        for i, s in enumerate(self.free):
+            n = sum(1 for tag in self.tags[s] if valid(tag))
+            if n > best_n:
+                best, best_n = i, n
+        slot = self.free.pop(best)
+        stale = [r for r, tag in enumerate(self.tags[slot]) if not valid(tag)]
+        self.tags[slot] = [None] * self.pages_per_slot
+        self.leases[key] = slot
+        return slot, stale
+
+    def release(self, key, tags = None) -> None:
+        slot = self.leases.pop(key, None)
+        if slot is None:
+            return
+        assert tags is None or len(tags) == self.pages_per_slot
+        self.tags[slot] = list(tags) if tags is not None else [None] * self.pages_per_slot
+        self.free.append(slot)
