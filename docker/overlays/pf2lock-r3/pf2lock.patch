+    def _publish(self, entry: dict, fn):
+        """pf2lock r3: submit fn(history, entry) and publish entry, or abort. The decision is made
+        exactly once on every path (gate set in finally), so a queued task never waits forever and
+        drain's shutdown(wait = True) cannot hang on it. On abort the entry is unpublished (the
+        append is the last step that can raise), so the issuer is its sole owner: aborted is
+        written before the gate opens, the task (if one was queued, returned future or not) sees it
+        and skips, and the issuer releases its set (flag off; a deferred entry never acquired). An
+        abort after the append (only an asynchronous exception can land there) withdraws the entry
+        first; if a retire already claimed it, that claimant releases the set (_abandon, the
+        future being set by then)."""
