--- a/cache/checkpoint_policy.py
+++ b/cache/checkpoint_policy.py
@@ -0,0 +1,26 @@
+"""R823b opt-in tail density; one policy shared by Job, LS windows, and trace."""
+import os
+
+
+def read_tail(max_chunk_size):
+    value = os.environ.get("EXL3_RECURRENT_CHECKPOINT_TAIL_PP")
+    if value is None:
+        return 0
+    try:
+        tail = int(value)
+    except ValueError as exc:
+        raise ValueError("EXL3_RECURRENT_CHECKPOINT_TAIL_PP must be an integer") from exc
+    if tail <= 0 or tail % max_chunk_size or tail % 256:
+        raise ValueError("EXL3_RECURRENT_CHECKPOINT_TAIL_PP must be a positive chunk/page multiple")
+    if os.environ.get("EXL3_RECURRENT_CHECKPOINT_INTERVAL_PP") is None:
+        raise ValueError("tail density requires EXL3_RECURRENT_CHECKPOINT_INTERVAL_PP")
+    return tail
+
+
+def interval(generator, position, prompt_end):
+    if position >= prompt_end - generator.max_chunk_size * 2:
+        return generator.recurrent_checkpoint_interval
+    tail = getattr(generator, "recurrent_checkpoint_tail_pp", 0)
+    if tail and position < prompt_end - tail:
+        return 32768
+    return generator.recurrent_checkpoint_interval_pp
