+# EXL3_QSA_RAWK_RING=1 (default off): keep a ring of raw indexer keys per page instead of all
+# PAGE_SIZE rows. A raw key is only read by the pool-update kernels, for the blocks an append
+# touches, so a page only has to hold its most recent rows: the partial block before the next
+# append position and, in the graph-captured path (append first, then pool from the plane), every
+# row of one call. rawk_ring_rows() sizes the ring for the largest graph call, MAX_QLEN = 16
+# (bc_attn.MAX_QLEN, BC_Attention::MAX_QLEN), plus that partial block, in whole blocks: 20 rows
+# at compress ratio 4. Position t of physical page p lives in row p * rows + t % rows. The same
+# size covers speculative rewinds: a verify window of L tokens is followed by a start at most L
+# positions back, and L + 2 < rows (QSAIndexer.update_planes guards eager windows)
+_BC_MAX_QLEN = 16
+_rawk_ring = os.environ.get("EXL3_QSA_RAWK_RING", "0") == "1"
 
+
+def rawk_ring_rows(compress_ratio: int) -> int:
+    """Ring rows per page for a compress ratio: one graph call plus the partial block before it."""
+    return -(-(_BC_MAX_QLEN + compress_ratio - 1) // compress_ratio) * compress_ratio
+
