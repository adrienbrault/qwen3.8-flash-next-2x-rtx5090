+# ---- raw-key ring (EXL3_QSA_RAWK_RING, cache/qsa.py) ------------------------------------------
+# The raw plane holds RING rows per page; position t of physical page p lives in row
+# p * RING + t % RING. The two pool kernels below repeat _qsa_pool_update_kernel's arithmetic line
+# for line (same loads, same accumulation order, same fp16 rounding points), so the pooled plane
+# is bit-identical to the full-plane path whenever the ring holds the rows a block reads.
+
+@triton.jit(do_not_specialize = ["num_pages_per_seq", "append_len"])
+def _qsa_raw_ring_append_kernel(
+    rows_new,            # (bsz, len, D)
+    plane_cache,         # (pages, RING, D)
+    block_table,
+    cache_seqlens,
+    num_pages_per_seq,
+    append_len,
+    page_size: tl.constexpr,
+    D: tl.constexpr,
+    RING: tl.constexpr,
+):
+    """Ring form of _mla_plane_update_kernel (same runtime arguments, so the BC graph launches
+    and patches it unchanged). Only the last RING rows of each sequence's append are stored:
+    they occupy distinct ring rows, and the earlier rows of a longer (prefill) append are never
+    read again, since the pooled keys of their blocks were built from the staged rows."""
+    row = tl.program_id(0)
+    batch = row // append_len
+    pos = row - batch * append_len
+    if pos + RING < append_len:
+        return
+
+    abs_pos = tl.load(cache_seqlens + batch) + pos
+    page = abs_pos // page_size
+    phys = tl.load(block_table + batch * num_pages_per_seq + page)
+    tok = phys * RING + abs_pos % RING
+
+    offs = tl.arange(0, D)
+    tl.store(plane_cache + tok * D + offs, tl.load(rows_new + row * D + offs))
+
+
+@triton.jit(do_not_specialize = ["num_pages_per_row", "append_len"])
+def _qsa_pool_update_ring_bc_kernel(
+    raw_plane,           # flat (pages * RING, D) fp16 raw-key ring
+    pool_plane,          # flat (pages * page_size // P, D) fp16 pooled keys
+    k_norm_w,            # (D,) fp16
+    inv_freq,            # (ROPE_R // 2,) fp32
+    block_table,         # (bsz, num_pages_per_row) i32
+    cache_seqlens,       # (bsz,) i32, pre-append counts
+    num_pages_per_row,
+    append_len,
+    page_size: tl.constexpr,
+    P: tl.constexpr,
+    D: tl.constexpr,
+    ROPE_R: tl.constexpr,
+    attn_factor: tl.constexpr,
+    eps: tl.constexpr,
+    MAXPOOLS: tl.constexpr,
+    RING: tl.constexpr,
+):
+    """_qsa_pool_update_kernel over the raw-key ring, for the BC graph (same runtime arguments;
+    the graph appends this call's rows to the ring first, so every row a block reads is in
+    the ring: the call's rows plus the partial block before it span at most MAX_QLEN + P - 1
+    <= RING positions)."""
+    b = tl.program_id(0)
+    pi = tl.program_id(1)
+    pos0 = tl.load(cache_seqlens + b)
+    t_end = pos0 + append_len
+    pool = pos0 // P + pi
+    if pool * P >= t_end:
+        return
+
+    HALF: tl.constexpr = ROPE_R // 2
+    PASS: tl.constexpr = D - ROPE_R
+    offs_h = tl.arange(0, HALF)
+    bt = block_table + b * num_pages_per_row
+
+    acc_lo = tl.zeros((HALF,), tl.float32)
+    acc_hi = tl.zeros((HALF,), tl.float32)
+    if PASS > 0:
+        acc_ps = tl.zeros((PASS,), tl.float32)
+        offs_p = ROPE_R + tl.arange(0, PASS)
+    cnt = 0.0
+    for j in range(P):
+        tok = pool * P + j
+        if tok < t_end:
+            phys = tl.load(bt + tok // page_size)
+            row = raw_plane + (phys * RING + tok % RING) * D
+            acc_lo += tl.load(row + offs_h).to(tl.float32)
+            acc_hi += tl.load(row + HALF + offs_h).to(tl.float32)
+            if PASS > 0:
+                acc_ps += tl.load(row + offs_p).to(tl.float32)
+            cnt += 1.0
+
+    # fp32 mean -> fp16 (the norm reads the rounded values, like the eager path)
+    m_lo = (acc_lo / cnt).to(tl.float16).to(tl.float32)
+    m_hi = (acc_hi / cnt).to(tl.float16).to(tl.float32)
+    ssq = tl.sum(m_lo * m_lo, axis = 0) + tl.sum(m_hi * m_hi, axis = 0)
+    if PASS > 0:
+        m_ps = (acc_ps / cnt).to(tl.float16).to(tl.float32)
+        ssq += tl.sum(m_ps * m_ps, axis = 0)
+    rstd = tl.rsqrt(ssq / D + eps)
+    y_lo = (m_lo * rstd * (tl.load(k_norm_w + offs_h).to(tl.float32) + 1.0)).to(tl.float16)
+    y_hi = (m_hi * rstd * (tl.load(k_norm_w + HALF + offs_h).to(tl.float32) + 1.0)).to(tl.float16)
+
+    # Partial NEOX rope at the block start: pair (d, d + HALF) shares frequency d
+    pos_f = (pool * P).to(tl.float32)
+    fr = tl.load(inv_freq + offs_h) * pos_f
+    cosv = (tl.cos(fr) * attn_factor).to(tl.float16)
+    sinv = (tl.sin(fr) * attn_factor).to(tl.float16)
+    r_lo = y_lo * cosv - y_hi * sinv
+    r_hi = y_hi * cosv + y_lo * sinv
+
+    phys0 = tl.load(bt + (pool * P) // page_size)
+    prow = pool_plane + (phys0 * (page_size // P) + pool % (page_size // P)) * D
+    tl.store(prow + offs_h, r_lo)
+    tl.store(prow + HALF + offs_h, r_hi)
+    if PASS > 0:
+        y_ps = (m_ps * rstd * (tl.load(k_norm_w + offs_p).to(tl.float32) + 1.0)).to(tl.float16)
+        tl.store(prow + offs_p, y_ps)
+
+
+@triton.jit(do_not_specialize = ["num_pages_per_row", "append_len"])
+def _qsa_pool_update_ring_kernel(
+    raw_plane,           # flat (pages * RING, D) fp16 raw-key ring
+    rows_new,            # (bsz * append_len, D) fp16 raw keys of this append (staged)
+    pool_plane,          # flat (pages * page_size // P, D) fp16 pooled keys
+    k_norm_w,            # (D,) fp16
+    inv_freq,            # (ROPE_R // 2,) fp32
+    block_table,         # (bsz, num_pages_per_row) i32
+    cache_seqlens,       # (bsz,) i32, pre-append counts
+    num_pages_per_row,
+    append_len,
+    page_size: tl.constexpr,
+    P: tl.constexpr,
+    D: tl.constexpr,
+    ROPE_R: tl.constexpr,
+    attn_factor: tl.constexpr,
+    eps: tl.constexpr,
+    MAXPOOLS: tl.constexpr,
+    RING: tl.constexpr,
+):
+    """Eager form of _qsa_pool_update_ring_bc_kernel, for appends of any length: rows at or
+    after pos0 are read from the staged new rows, the partial block before pos0 from the ring.
+    Runs BEFORE the ring append of the same call (qsa_ring_plane_update)."""
+    b = tl.program_id(0)
+    pi = tl.program_id(1)
+    pos0 = tl.load(cache_seqlens + b)
+    t_end = pos0 + append_len
+    pool = pos0 // P + pi
+    if pool * P >= t_end:
+        return
+
+    HALF: tl.constexpr = ROPE_R // 2
+    PASS: tl.constexpr = D - ROPE_R
+    offs_h = tl.arange(0, HALF)
+    bt = block_table + b * num_pages_per_row
+
+    acc_lo = tl.zeros((HALF,), tl.float32)
+    acc_hi = tl.zeros((HALF,), tl.float32)
+    if PASS > 0:
+        acc_ps = tl.zeros((PASS,), tl.float32)
+        offs_p = ROPE_R + tl.arange(0, PASS)
+    cnt = 0.0
+    for j in range(P):
+        tok = pool * P + j
+        if tok < t_end:
+            if tok >= pos0:
+                row = rows_new + (b * append_len + (tok - pos0)) * D
+            else:
+                phys = tl.load(bt + tok // page_size)
+                row = raw_plane + (phys * RING + tok % RING) * D
+            acc_lo += tl.load(row + offs_h).to(tl.float32)
+            acc_hi += tl.load(row + HALF + offs_h).to(tl.float32)
+            if PASS > 0:
+                acc_ps += tl.load(row + offs_p).to(tl.float32)
+            cnt += 1.0
+
+    # fp32 mean -> fp16 (the norm reads the rounded values, like the eager path)
+    m_lo = (acc_lo / cnt).to(tl.float16).to(tl.float32)
+    m_hi = (acc_hi / cnt).to(tl.float16).to(tl.float32)
+    ssq = tl.sum(m_lo * m_lo, axis = 0) + tl.sum(m_hi * m_hi, axis = 0)
+    if PASS > 0:
+        m_ps = (acc_ps / cnt).to(tl.float16).to(tl.float32)
+        ssq += tl.sum(m_ps * m_ps, axis = 0)
+    rstd = tl.rsqrt(ssq / D + eps)
+    y_lo = (m_lo * rstd * (tl.load(k_norm_w + offs_h).to(tl.float32) + 1.0)).to(tl.float16)
+    y_hi = (m_hi * rstd * (tl.load(k_norm_w + HALF + offs_h).to(tl.float32) + 1.0)).to(tl.float16)
+
+    # Partial NEOX rope at the block start: pair (d, d + HALF) shares frequency d
+    pos_f = (pool * P).to(tl.float32)
+    fr = tl.load(inv_freq + offs_h) * pos_f
+    cosv = (tl.cos(fr) * attn_factor).to(tl.float16)
+    sinv = (tl.sin(fr) * attn_factor).to(tl.float16)
+    r_lo = y_lo * cosv - y_hi * sinv
+    r_hi = y_hi * cosv + y_lo * sinv
+
+    phys0 = tl.load(bt + (pool * P) // page_size)
+    prow = pool_plane + (phys0 * (page_size // P) + pool % (page_size // P)) * D
+    tl.store(prow + offs_h, r_lo)
+    tl.store(prow + HALF + offs_h, r_hi)
+    if PASS > 0:
+        y_ps = (m_ps * rstd * (tl.load(k_norm_w + offs_p).to(tl.float32) + 1.0)).to(tl.float16)
+        tl.store(prow + offs_p, y_ps)
+
+
+def qsa_ring_plane_update(
+    kraw,                # (bsz, seqlen, D) fp16 staged raw keys of this append, contiguous
+    raw_ring,            # (pages, RING, D) fp16
+    pooled,              # (pages, page_size // P, D) fp16
+    k_norm_w,            # (D,) fp16
+    inv_freq,            # (ROPE_R // 2,) fp32
+    attn_factor: float,
+    eps: float,
+    block_table,         # (bsz, pages_per_row) i32, contiguous
+    cache_seqlens,       # (bsz,) i32 device, pre-append counts
+    P: int,
+):
+    """Eager plane upkeep with the raw-key ring: pool update first (it reads the partial block
+    before each sequence's pos0 from the ring and everything after from kraw), then the ring
+    append. The caller sets the current device."""
+    bsz, seqlen, dk = kraw.shape
+    ring = raw_ring.shape[1]
+    page_size = pooled.shape[1] * P
+    npr = block_table.shape[1]
+    _qsa_pool_update_ring_kernel[(bsz, seqlen // P + 1)](
+        raw_ring.view(-1, dk), kraw, pooled.view(-1, dk), k_norm_w,
+        inv_freq, block_table, cache_seqlens, npr, seqlen,
+        page_size = page_size, P = P, D = dk, ROPE_R = 2 * inv_freq.numel(),
+        attn_factor = float(attn_factor), eps = float(eps), MAXPOOLS = 1, RING = ring,
+    )
+    _qsa_raw_ring_append_kernel[(bsz * seqlen,)](
+        kraw, raw_ring, block_table, cache_seqlens, npr, seqlen,
+        page_size = page_size, D = dk, RING = ring,
+    )
+
