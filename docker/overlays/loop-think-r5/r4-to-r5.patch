+def _finish_with_tool_calls(generation: dict, calls: list, label: str):
+    """
+    finish_reason once tool-call text was generated. The base always reported
+    "tool_calls", so a max_tokens stop inside a tool call reached the client
+    as "tool_calls" with no call (flan R791): that case keeps "length". Every
+    other end keeps the base's "tool_calls", with or without a parsed call (a
+    reasoning-only "stop" is what Hermes shows as the reply, R781).
+    """
+
+    if not calls:
+        cap_hit = generation.get("eos_reason") == "max_new_tokens"
+        xlogger.warning(
+            f"{label}: tool call text did not parse into a tool call; "
+            f"finish_reason {'length' if cap_hit else 'tool_calls'}",
+            {"eos_reason": generation.get("eos_reason")},
+        )
+        if cap_hit:
+            generation["finish_reason"] = "length"
+            return
+    generation["finish_reason"] = "tool_calls"
+
