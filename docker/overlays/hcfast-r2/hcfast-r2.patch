 from ..ext import exllamav3_ext as ext
 from ..util.tensor import g_tensor_cache
 
+# hcfast landing marker (EXL3_HC_MIX_V3, hc_mix_v3.cu). Default off. r2 keeps r1's EXL3_HC_MIX_V3=1
+# path unchanged and adds EXL3_HC_MIX_V3=2.
+_HC_MIX_V3_BUILD = "r2"
+
+
+def _hc_mix_v3_level() -> int:
+    # Only the literal values "1" and "2" opt in (anything else, including "true", is off).
+    return {"1": 1, "2": 2}.get(os.environ.get("EXL3_HC_MIX_V3", "0"), 0)
+
+
+def _hc_mix_v3_table(name: str, default: str, allowed: tuple) -> tuple:
+    """A knob is one value ("2") or a per-row-count table ("4:4,32:2": R <= 4 -> 4, R <= 32 -> 2; the
+    last entry covers every larger R). Returns the value for R = 0..32 as a tuple."""
+    spec = os.environ.get(name, default).strip()
+    err = f"{name} must be one of {allowed} or a table like '4:{allowed[-1]},32:{allowed[-1]}'"
+    try:
+        if ":" not in spec:
+            pairs = [(32, int(spec))]
+        else:
+            pairs = [tuple(int(x) for x in item.split(":")) for item in spec.split(",") if item.strip()]
+    except ValueError:
+        raise ValueError(err) from None
+    if not pairs or any(len(p) != 2 or p[1] not in allowed or p[0] < 1 for p in pairs) \
+            or any(pairs[i][0] >= pairs[i + 1][0] for i in range(len(pairs) - 1)):
+        raise ValueError(err)
+    out = []
+    for r in range(33):
+        v = next((val for lim, val in pairs if r <= lim), pairs[-1][1])
+        out.append(v)
+    return tuple(out)
+
+
+def _hc_mix_v3_cap(name: str, default: str = "8") -> tuple:
+    return _hc_mix_v3_table(name, default, (0, 1, 2, 4, 8))
