# hcfast r1: EXL3_HC_MIX_V3=1 routes the decode GatedResidual int8 state-in-up mixer through hc_mix_v3.cu:
# the same two launches (dots, up) with the same grids, bitwise-identical dots/state/post/mixed, and the
# served kernels' measured costs removed (per-row I2F in dots, B LDS per weight word + 5-level butterfly in up,
# late weight/epilogue loads). Unset = the served launches, from an unchanged hc_mix.cu.
#
#   docker build -f Dockerfile.box --build-arg BASE=tabbyapi:slotfix-r1 -t tabbyapi:hcfast-r1 .
#
# Build context = this directory. No heredocs (legacy builder). The CPU flow test runs during the build (fake ext,
# no GPU); the parity test and the P0 bench are copied to /opt/hcfast-r1/ for the GPU runs.
ARG BASE=tabbyapi:slotfix-r1
FROM ${BASE}
ARG BASE
ARG MAX_JOBS=4
COPY hcfast-r1.patch rebuild-native.py install-hcfast.sh test_hcfast_parity.py test_hcfast_flow_cpu.py bench_hcfast_p0.py /opt/hcfast-r1/
RUN MAX_JOBS=${MAX_JOBS} bash /opt/hcfast-r1/install-hcfast.sh && \
    python3 -m py_compile /opt/hcfast-r1/test_hcfast_parity.py /opt/hcfast-r1/bench_hcfast_p0.py && \
    python3 /opt/hcfast-r1/test_hcfast_flow_cpu.py && \
    python3 -c 'import exllamav3.modules.hyperconnections as h; assert h._HC_MIX_V3_BUILD == "r1", h._HC_MIX_V3_BUILD; assert h.GatedResidual.MIX_V3 is False, "must default off"; assert (h.GatedResidual.MIX_V3_DOTS_B, h.GatedResidual.MIX_V3_UP_B) == (8, 8); print("hcfast r1 landed (default off)")' && \
    EXL3_HC_MIX_V3=1 python3 -c 'import exllamav3.modules.hyperconnections as h; assert h.GatedResidual.MIX_V3 is True; print("hcfast r1: EXL3_HC_MIX_V3=1 selects gr_mix_v2_int8_v3")'
LABEL local.hcfast.base="${BASE}"
