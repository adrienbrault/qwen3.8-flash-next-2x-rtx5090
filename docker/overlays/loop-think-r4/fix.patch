+    # Reasoning loop: the backend's loop detector ends the job, which in the
+    # reasoning phase leaves a response with finish_reason "stop" and no
+    # content (clients such as Hermes then show the reasoning as the answer).
+    # Detect the loop here on reasoning tokens with the request's window W and
+    # force the end of the reasoning phase instead, like the budget does. The
+    # backend detector moves to a 2W window as a backstop so this one fires
+    # first, with 4 repetitions so it still only matches periods up to W/2 (a
+    # (2W, 2) detector would newly end 401-800-token loops as reasoning-only
+    # stops). It still ends content-phase loops, after 2W instead of W. Not
+    # armed when 2W exceeds the output chunk: the engine rebuilds its detector
+    # at every requeue, so a 2W window would never fill (R782 review). A second,
+    # collector-only detector catches periods up to 1.25W once 3 copies fill
+    # its window (R783: a ~710-token block repeated 6x escaped every detector);
+    # 3 copies, so one restated block (a draft rewritten verbatim) never fires.
+    loop_detectors = []
+    loop_injection = None
+    stop_on_loop = params.get_stop_on_loop()
+    if (
+        stop_on_loop is not None
+        and LoopDetector is not None
+        and forcing is None
+        and use_think
+        and start_in_reasoning_mode
+        and not (params.json_schema or params.regex_pattern or params.grammar_string)
+    ):
+        loop_injection = _reasoning_budget_injection(mc, LOOP_THINK_MESSAGE)
+        window, min_reps = stop_on_loop
+        max_rq = getattr(mc, "max_rq_tokens", None)
+        if loop_injection is not None and (max_rq is None or window * 2 <= max_rq):
+            long_period = window + window // 4
+            loop_detectors = [
+                LoopDetector(window, window // min_reps),
+                LoopDetector(3 * long_period, long_period),
+            ]
+            params._loop_backstop = (window * 2, min_reps * 2)
+            xlogger.debug(
+                f"{label}: reasoning loop watch at window {window}, "
+                f"engine backstop {params._loop_backstop}"
+            )
+
