+def _qsa_ring_graph_kernels(dev, head_dim: int, cr: int, rotate_dims: int, attn_factor: float,
+                            eps: float, q_len: int, ring: int):
+    """AOT-compiled raw-key ring kernels for one BC slot (EXL3_QSA_RAWK_RING): the ring append
+    and the ring pool update, with the runtime signatures of _mla_plane_update_kernel and
+    _qsa_pool_update_kernel. The graph appends before pooling, so one call's rows plus the
+    partial block before them must fit the ring without two positions sharing a row."""
+    from .qsa_triton import _qsa_raw_ring_append_kernel, _qsa_pool_update_ring_bc_kernel
+    assert q_len + cr - 1 <= ring, f"QSA raw-key ring of {ring} rows cannot hold a q_len {q_len} graph call"
