+
+    def draft_window_slot(self, job) -> int:
+        """Window slot of an active job, granted on first use. Ring pages the slot does not hold for
+        this job's prompt (see MTPWindowSlots) are cleared before the job's first draft write."""
+        slots = self.draft_window_slots
+        key = id(job)
+        slot = slots.lookup(key)
+        if slot is None:
+            slot, stale = slots.grant(key, self._draft_window_matcher(job), alive = {id(j) for j in self.active_jobs})
+            if stale:
+                self._draft_window_clear(slot, stale)
+        return slot
+
+    def _draft_window_matcher(self, job):
+        """match(tag) for MTPWindowSlots.grant: the tagged page is this job's prompt page L (same
+        chained hash) followed by the same token."""
+        seq = job.sequences[0]
+        hashes = seq.page_hashes or ()
+        ids = seq.sequence_ids.torch()
+        def match(tag):
+            L, h, nt = tag
+            p = (L + 1) * PAGE_SIZE
+            return L < len(hashes) and hashes[L] == h and p < ids.shape[-1] and int(ids[0, p]) == nt
+        return match
+
+    def _draft_window_clear(self, slot: int, ring_pages: list):
+        """Zero the given ring pages of a slot in every draft-cache tensor (K/V, scales, QSA planes)."""
+        pps = self.draft_window.pages_per_slot
+        index = torch.tensor([slot * pps + r for r in ring_pages], dtype = torch.long)
+        for t in self.draft_cache.get_all_tensors():
+            t.index_fill_(0, index.to(t.device), 0)
+
+    def release_draft_window_slot(self, job, keep: bool = False) -> None:
+        """Return a job's window slot. keep: the job left in a consistent state (completed, requeued,
+        cancelled between iterations), so its whole committed pages stay reusable by a later job
+        with the same prompt prefix; otherwise the slot keeps nothing."""
+        if self.draft_window_slots is None:
+            return
+        tags = None
+        if keep and self.draft_window_slots.lookup(id(job)) is not None:
+            seq = job.sequences[0]
+            hashes = list(seq.page_hashes or ())
+            ids = seq.sequence_ids.torch()
+            n_full = seq.kv_position // PAGE_SIZE
+            # Chain the page hashes past the prompt over the committed generated tokens
+            while len(hashes) < n_full:
+                L = len(hashes)
+                prev = hashes[-1] if hashes else None
+                hashes.append(tensor_hash_checksum(ids[:, L * PAGE_SIZE:(L + 1) * PAGE_SIZE], prev))
+            def next_token(L):
+                p = (L + 1) * PAGE_SIZE
+                return int(ids[0, p]) if p < ids.shape[-1] else None
+            tags = release_tags(
+                self.draft_window.pages_per_slot, seq.kv_position,
+                lambda L: hashes[L] if L < len(hashes) else None, next_token,
+            )
+        self.draft_window_slots.release(id(job), tags)
+
+    def draft_window_rows(self, jobs: list, width: int, staging: str | None = None) -> torch.Tensor | None:
+        """
+        Draft block-table rows over the windowed draft cache for a compact batch: one row per entry of
+        `jobs` (one entry per batch row, in batch order). The width is padded to 16 pages like the
+        served tables; the padding columns hold valid slot pages and are never dereferenced beyond the
+        cache lengths. `staging` names a reusable pinned buffer, used where the served table is one.
+        None when the draft cache is not windowed.
+        """
+        if self.draft_window is None:
+            return None
+        width = (width + 15) // 16 * 16
+        offsets = self._draft_window_offsets
+        if offsets is None or offsets.shape[0] < width:
+            offsets = self._draft_window_offsets = window_offsets(self.draft_window.pages_per_slot, width)
+        slots = [self.draft_window_slot(job) for job in jobs]
+        pps = self.draft_window.pages_per_slot
+        if staging is None:
+            rows = torch.empty((len(jobs), width), dtype = torch.int32)
+        else:
+            # A named staging buffer keeps its rows between rounds: refill only when the slots, the
+            # width or the buffer itself changed (the decode loop calls this twice per step)
+            rows = self._staging(staging, len(jobs), width)
+            memo = (width, tuple(slots), rows.data_ptr())
+            if self._draft_window_memo.get(staging) == memo:
+                return rows
+            self._draft_window_memo[staging] = memo
+        for r, slot in enumerate(slots):
+            torch.add(offsets[:width], slot * pps, out = rows[r])
+        return rows
+
+    def draft_window_row(self, job, width: int) -> torch.Tensor | None:
+        """(1, width) draft block-table row of one sequence (prefill), or None when not windowed."""
+        return self.draft_window_rows([job], width)
+
