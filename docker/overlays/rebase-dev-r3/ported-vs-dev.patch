+    def _get_draft_depth(self, batch_size: int) -> int:
+        # All rows in this round share one window; pending and still-prefilling jobs do not count
+        if self.num_draft_tokens_by_batch is not None:
+            for limit, depth in self.num_draft_tokens_by_batch:
+                if batch_size <= limit:
+                    return depth
+        return self.num_draft_tokens
+
+
+    def _draft_tables(self, name: str, batch_size: int, max_pages_batch: int):
+        """Allocate draft metadata, optionally in reusable pinned staging.
+
+        Each drafter owns a distinct block-table buffer because target work may
+        still be queued when drafting starts. The served pageable allocation is
+        retained verbatim when the round-4 flag is off.
+        """
+        if not _DRAFT_PINNED_STAGING:
+            return (
+                torch.zeros((batch_size, max_pages_batch), dtype = torch.int32),
+                torch.zeros((batch_size,), dtype = torch.int32),
+            )
+        max_pages_batch = (max_pages_batch + 15) // 16 * 16
+        block_index = self._staging(f"{name}_block_index", batch_size, max_pages_batch)
+        block_index.zero_()
+        cache_seqlens = self._staging(f"{name}_cache_seqlens", batch_size)
+        return block_index, cache_seqlens
+
+
+    def _draft_step_seqlens(self, name: str, source: torch.Tensor, step: int):
+        """Give every in-flight async metadata upload immutable pinned storage."""
+        if not _DRAFT_PINNED_STAGING:
+            return source
+        staged = self._staging(f"{name}_cache_seqlens_step_{step}", source.shape[0])
+        staged.copy_(source)
+        return staged
+
