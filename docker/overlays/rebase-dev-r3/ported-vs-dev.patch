+#pragma once
+
+#include <ATen/Tensor.h>
+
+// hcfast r1/r2 (EXL3_HC_MIX_V3=1/2): decode GatedResidual mixer, int8 V2 weights, state-in-up.
+// Same two launches, same grids at the default tile caps, bitwise-identical dots/state/post/mixed
+// to gr_mix_v2_int8_statein (hc_mix.cu). See hc_mix_v3.cu for the per-output argument.
+//
+// mode bit 0: dots launch runs the V3 kernel (else a verbatim copy of the served kernel)
+// mode bit 1: up launch runs the V3 kernel (else a verbatim copy of the served kernel)
+// dots_bmax / up_bmax: cap on the rows per CTA (1, 2, 4 or 8; 8 = the served tiling), or 0 = auto: the
+//   smallest rows-per-CTA (<= the served one) whose whole grid fits one wave on this device. A smaller
+//   tile only changes which rows a CTA owns; every per-row reduction chain is unchanged, and the CTA
+//   count is >= the served one.
+// mode bit 2 (hcfast r2): dots runs the r2 kernel (hcv4) with dots_j fn rows per CTA (4 or 8) and
+//   dots_pf stream iterations prefetched (0, 1 or 2; clamped to the instantiated set, see
+//   resolve_dots_v4); cap 0 runs the served tile.
+// mode bit 3 (hcfast r2): up runs the r2 kernel with up_qn column quads per CTA (2 or 4); half output only.
+// mode bit 4: the r2 launches use programmatic dependent launch (griddepcontrol.wait before any read of
+//   earlier stream work; nothing is written before it).
+// Returns the mask of launches that actually ran: 1 dots V3, 2 up V3, 4 dots r2, 8 up r2, 16 PDL on at
+// least one launch (mode bit 3 at up B = 8, Q = 2 runs r1's V3 up without PDL and reports 2)
+// (a shape outside D = 2560 / LR = 320, or a misaligned workspace, falls back to the copied served
+// kernel for that launch).
+int64_t gr_mix_v2_int8_v3
+(
+    const at::Tensor& streams,
+    const at::Tensor& fn_q,
+    const at::Tensor& fn_s,
+    const at::Tensor& up_q,
+    const at::Tensor& up_s,
+    const at::Tensor& w,
+    double rms_eps,
+    at::Tensor dots,
+    at::Tensor state,
+    c10::optional<at::Tensor> post,
+    at::Tensor mixed,
+    int64_t mode,
+    int64_t dots_bmax,
+    int64_t up_bmax,
+    int64_t dots_j,
+    int64_t dots_pf,
+    int64_t up_qn
+);
