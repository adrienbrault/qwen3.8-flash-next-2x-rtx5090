diff --git a/exllamav3/exllamav3_ext/libtorch/lc_fork.h b/exllamav3/exllamav3_ext/libtorch/lc_fork.h
new file mode 100644
index 0000000..0b54b2e
--- /dev/null
+++ b/exllamav3/exllamav3_ext/libtorch/lc_fork.h
@@ -0,0 +1,85 @@
+#pragma once
+
+// latchain r1: fork/join of an independent kernel chain onto a side stream while a BC graph is
+// being CAPTURED, so the captured graph gets two parallel branches instead of one serial chain.
+// The kernels, their arguments and the host call order are unchanged (Graph::capture_end matches
+// recorded sites to nodes in creation order, which is still the host call order), so the graph
+// computes the same values; only the node dependencies change. Eager runs (graph == nullptr)
+// never fork.
+//
+// One side stream and one event pair per device: BC graphs on a device are captured one at a
+// time and replayed in stream order, so branches of different graphs never overlap. Create the
+// objects (lc_fork_prepare) OUTSIDE stream capture; lc_fork_get only returns them.
+
+#include <cuda_runtime.h>
+#include <c10/cuda/CUDAException.h>
+#include <c10/cuda/CUDAGuard.h>
+#include <c10/util/Exception.h>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+#include "../quant/exl3_devctx.cuh"
+
+// Tile-lock offset for an EXL3 GEMM launched on a side branch: exl3_gemm_kernel uses only
+// locks[0, tiles) of the per-device lock buffer (barrier counters are an mgemm feature), and
+// every GEMM of a decode graph has far fewer than MAX_TILES_C / 2 tiles, so the upper half of the
+// tile region is free for a concurrent branch GEMM (zero extra VRAM; the region is zeroed at
+// allocation and each GEMM leaves its locks at zero)
+#define LC_LOCKS_ALT_OFFSET (MAX_TILES_C / 2)
+
+static inline bool lc_env_flag(const char* name)
+{
+    const char* e = std::getenv(name);
+    if (!e || !*e || !std::strcmp(e, "0")) return false;
+    TORCH_CHECK(!std::strcmp(e, "1"), name, " must be 0 or 1");
+    return true;
+}
+
+struct LcFork
+{
+    cudaStream_t side = nullptr;
+    cudaEvent_t ev_fork = nullptr;
+    cudaEvent_t ev_join = nullptr;
+
+    // Record on main, make side wait: everything launched on side after this depends on the
+    // work already issued to main (and nothing else)
+    void fork(cudaStream_t main)
+    {
+        C10_CUDA_CHECK(cudaEventRecord(ev_fork, main));
+        C10_CUDA_CHECK(cudaStreamWaitEvent(side, ev_fork, 0));
+    }
+
+    // Record on side, make main wait: work issued to main after this depends on the branch
+    void join(cudaStream_t main)
+    {
+        C10_CUDA_CHECK(cudaEventRecord(ev_join, side));
+        C10_CUDA_CHECK(cudaStreamWaitEvent(main, ev_join, 0));
+    }
+};
+
+inline LcFork* lc_fork_slot(int device)
+{
+    static LcFork forks[MAX_DEVICES];
+    TORCH_CHECK(device >= 0 && device < MAX_DEVICES, "lc_fork: bad device ", device);
+    return &forks[device];
+}
+
+// Outside capture only (stream/event creation)
+inline void lc_fork_prepare(int device)
+{
+    static std::mutex mtx;
+    std::lock_guard<std::mutex> lock(mtx);
+    LcFork* f = lc_fork_slot(device);
+    if (f->side) return;
+    c10::cuda::CUDAGuard guard((c10::DeviceIndex) device);
+    C10_CUDA_CHECK(cudaStreamCreateWithFlags(&f->side, cudaStreamNonBlocking));
+    C10_CUDA_CHECK(cudaEventCreateWithFlags(&f->ev_fork, cudaEventDisableTiming));
+    C10_CUDA_CHECK(cudaEventCreateWithFlags(&f->ev_join, cudaEventDisableTiming));
+}
+
+inline LcFork* lc_fork_get(int device)
+{
+    LcFork* f = lc_fork_slot(device);
+    TORCH_CHECK(f->side, "lc_fork: side stream not prepared for device ", device, " (call lc_fork_prepare before capture)");
+    return f;
+}
