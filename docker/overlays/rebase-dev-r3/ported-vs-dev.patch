+        {"rows_new": "*fp16", "plane_cache": "*fp16", "block_table": "*i32",
+         "cache_seqlens": "*i32", "num_pages_per_seq": "i32", "append_len": "i32"}
+        | {n: "constexpr" for n in ("page_size", "D", "RING")},
+        dict(page_size = PAGE_SIZE, D = head_dim, RING = ring), 2, 2)
