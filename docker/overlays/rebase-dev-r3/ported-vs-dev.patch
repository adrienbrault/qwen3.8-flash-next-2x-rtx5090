+                const float* had_in = sh_c + row * TILESIZE_N + col * 128;
+                half* had_out = gl_c_ptr_16 + row * size_n_stride + col * 128;
+                had_fh_r_128_inner<false, true>(had_in, had_out, post_scale_c, 0.088388347648f);
+            }
+            else
+            {
+                const half* had_in = ((const half*) sh_c) + row * TILESIZE_N + col * 128;
+                half* had_out = gl_c_ptr_16 + row * size_n_stride + col * 128;
+                had_hf_r_128_inner<false, true>(had_in, had_out, post_scale_c, 0.088388347648f);
+            }
+        }
+    };
+
+    // Partial-sum slots (dv2_store_slot / dv2_fold): whole fragments as float4 at
+    // [(m * F + n) * 256 + t]; at 16-row tiles with size_m <= 8, only elements [0], [1] (rows 0-7)
+    // as float2 at [n * 256 + t]
+    const int slot_floats = exl3_dense_v2_slot_floats(TILESIZE_M, TILESIZE_N, size_m);
+    const bool compact = (TILEBLOCKS_M == 1) && (size_m <= 8);
+
+    // Final sums of the current column tile (in frag_c, sub_k == 0 threads) -> output transform -> C.
+    // The caller has separated the threadblock reduction's last reads of sh_c from these writes
+    auto epilogue = [&] () DGV2_AI
+    {
+        if constexpr (EPI == 1 && !c_fp32)
+        {
+            if (!sub_k) write_sum_tile_sh_h();
+        }
+        else
+        {
+            if (!sub_k) write_sum_tile_sh();
+        }
+        __syncthreads();
+        if (!sub_k) output_had_sh_gl();
+        __syncthreads();    // sh_c is reused by the next segment's threadblock reduction
+    };
+
+    // Head of a column that continues in later CTAs: always this CTA's last segment (the segment
+    // ends before the top k tile, so it ends the slice). Its fold runs after the main loop
+    bool deferred = false;
+
+    // Output reduction at the end of a segment (in the unrolled main loop: kept to the served size)
+    auto reduce = [&] () DGV2_AI
+    {
+        #if EXL3_GEMM_H_ACC
+            #pragma unroll
+            for (int m = 0; m < TILEBLOCKS_M; ++m)
+                #pragma unroll
+                for (int n = 0; n < FRAGS_N_PER_WARP; ++n)
+                {
+                    float2 f0 = __half22float2(frag_c_h[m][n][0]);
+                    float2 f1 = __half22float2(frag_c_h[m][n][1]);
+                    frag_c[m][n][0] += f0.x; frag_c[m][n][1] += f0.y;
+                    frag_c[m][n][2] += f1.x; frag_c[m][n][3] += f1.y;
+                }
+        #endif
+
+        threadblock_reduce();
+
+        // This segment covers k tiles slice2_k0 .. slice2_k of column tile slice2_n
+        const bool is_head = slice2_k0 == 0;
+        const bool is_top = slice2_k == tiles_k - 1;
+
+        if (!is_head)
+        {
+            // Publish and move on. Only a CTA's first segment can start mid-column, so the slot
+            // is this CTA's. barrier_release: __syncthreads, then fence.acq_rel.gpu + red.add
+            if (!sub_k) dv2_store_slot<TILEBLOCKS_M, FRAGS_N_PER_WARP>(frag_c, ws_slots + (size_t) blockIdx.x * slot_floats, compact, t);
+            barrier_release(&locks[slice_m * blocks_n + slice2_n], 1, false);
+            clear_frag_c();
+        }
+        else if (is_top)
+        {
+            // Whole column in this CTA. The served kernel reaches its epilogue through
+            // barrier_acquire, whose __syncthreads separates the threadblock reduction's last
+            // reads of sh_c from the epilogue's writes into it
+            __syncthreads();
+            epilogue();
+            clear_frag_c();
+        }
+        else
+        {
+            // Keep frag_c; slice2_n and the C pointers do not move (advance2 stays in this column)
+            deferred = true;
+        }
+    };
+
+    auto wait_stage = [&] () DGV2_AI
+    {
+        cp_async_wait<SH_STAGES - 2>();
+        __syncthreads();
+    };
+
+    auto matmul = [&] (int buf) DGV2_AI
+    {
+        if constexpr (TILEBLOCKS_M == 1)
+        {
+            #pragma unroll
+            for (int n = 0; n < FRAGS_N_PER_WARP; ++n)
+            {
+                #if EXL3_GEMM_H_ACC
+                    ptx_mma_m16n8k16(frag_a[buf], frag_b[buf][n], frag_c_h[0][n]);
+                #else
+                    ptx_mma_m16n8k16(frag_a[buf], frag_b[buf][n], frag_c[0][n]);
+                #endif
+            }
+        }
+        else
+        {
+            #pragma unroll
+            for (int m = 0; m < TILEBLOCKS_M; ++m)
+                #pragma unroll
+                for (int n = 0; n < FRAGS_N_PER_WARP; ++n)
+                {
+                    #if EXL3_GEMM_H_ACC
+                        ptx_mma_m16n8k16(frag_a[m], frag_b[buf][n], frag_c_h[m][n]);
+                    #else
+                        ptx_mma_m16n8k16(frag_a[m], frag_b[buf][n], frag_c[m][n]);
+                    #endif
+                }
+        }
+    };
+
+    #if DGV2_BPRO
+    // Prologue: B tiles of the first SH_STAGES - 1 stages (one commit group), then the caller's input
+    // stage, then the A tile of each stage (one commit group per stage), then the served wait_stage:
+    // wait_group<SH_STAGES - 2> completes the B group and A stage 0 and leaves the other A stages in
+    // flight. The pipeline state (slice0_*, sh0_*, pending groups) ends where the served prologue
+    // leaves it, one extra group ahead, which the main loop's wait_group<SH_STAGES - 2> absorbs
+    {
+        const half* s_gl_a_ptr = gl_a_ptr;
+        const uint16_t* s_gl_b_ptr = gl_b_ptr;
+        const int s_slice0_k = slice0_k;
+        const int s_slice0_n = slice0_n;
+        const int s_slice0_iters = slice0_iters;
+        half* s_sh0_a_ptr = sh0_a_ptr;
+        uint16_t* s_sh0_b_ptr = sh0_b_ptr;
+
+        if (!sub_k)
+        {
+            #pragma unroll
+            for (int i = 0; i < SH_STAGES - 1; ++i)
+            {
+                if (slice0_iters)
+                {
+                    load_b_stage();
+                    advance0();
+                }
+            }
+        }
+        cp_async_fence();
+
+        gl_a_ptr = s_gl_a_ptr;
+        gl_b_ptr = s_gl_b_ptr;
+        slice0_k = s_slice0_k;
+        slice0_n = s_slice0_n;
+        slice0_iters = s_slice0_iters;
+        sh0_a_ptr = s_sh0_a_ptr;
+        sh0_b_ptr = s_sh0_b_ptr;
+
+        pre_a();
+
+        #pragma unroll
+        for (int i = 0; i < SH_STAGES - 1; ++i)
+        {
+            if (!sub_k && slice0_iters)
+            {
+                load_a_stage();
+                advance0();
+            }
+            cp_async_fence();
+        }
+        wait_stage();
+    }
+    #else
+    // Served order: input stage (Hadamard + barrier), then the served pipeline prologue
+    pre_a();
+    #pragma unroll
+    for (int i = 0; i < SH_STAGES - 1; ++i)
+        async_load_gl();
+    wait_stage();
+    #endif
+
+    clear_frag_c();
+    if constexpr (FRAG_STAGES > 1)
+        load_frags(0);
+
+    #define FSTAGE_OLD_V2(_load, _mul) \
+        async_load_gl(); \
+        wait_stage(); \
+        load_frags(_load); \
+        matmul(_mul); \
+        if (slice2_k == tiles_k - 1 || slice2_iters == 1) { reduce(); slice2_k0 = slice2_k + 1; } \
+        advance2(); \
+        if (!slice2_iters) break; \
+
+    #define FSTAGE_V2(_load, _mul) \
+        async_load_gl(); \
+        wait_stage(); \
+        matmul(_mul); \
+        if (slice2_k == tiles_k - 1 || slice2_iters == 1) { reduce(); slice2_k0 = slice2_k + 1; } \
+        advance2(); \
+        if (!slice2_iters) break; \
+        load_frags(_load); \
+
+    if constexpr (FRAG_STAGES == 1)
+    {
+        while (true)
+        {
+            FSTAGE_OLD_V2(0, 0);
+        }
+    }
+
+    if constexpr (FRAG_STAGES == 2)
+    {
+        while (true)
+        {
+            FSTAGE_V2(1, 0);
+            FSTAGE_V2(0, 1);
+        }
+    }
+
+    if constexpr (FRAG_STAGES == 3)
+    {
+        while (true)
+        {
+            FSTAGE_V2(1, 0);
+            FSTAGE_V2(2, 1);
+            FSTAGE_V2(0, 2);
+        }
+    }
+
+    if constexpr (FRAG_STAGES == 4)
+    {
+        while (true)
+        {
+            FSTAGE_V2(1, 0);
+            FSTAGE_V2(2, 1);
+            FSTAGE_V2(3, 2);
+            FSTAGE_V2(0, 3);
+        }
+    }
+
+    if constexpr (FRAG_STAGES == 5)
+    {
+        while (true)
+        {
+            FSTAGE_V2(1, 0);
+            FSTAGE_V2(2, 1);
+            FSTAGE_V2(3, 2);
+            FSTAGE_V2(4, 3);
+            FSTAGE_V2(0, 4);
+        }
+    }
+
+    #undef FSTAGE_OLD_V2
+    #undef FSTAGE_V2
+
+    // Deferred head (see reduce): wait for every producer of this column, fold their partials in
+    // chain order into frag_c, reset the lock, transform and store. One call site, outside the
+    // unrolled loop, with frag_a / frag_b dead
+    if (deferred)
+    {
+        const int b_top = (((slice2_n + 1) * tiles_k) * num_slices - 1) / tiles_kn;   // owner of the top k tile
+        int nprod = 0;
+        for (int b = blockIdx.x + 1; b <= b_top; ++b)
+            nprod += dv2_tile_beg(tiles_kn, num_slices, b + 1) > dv2_tile_beg(tiles_kn, num_slices, b) ? 1 : 0;
+        int* lock = &locks[slice_m * blocks_n + slice2_n];
+        barrier_acquire(lock, nprod);   // thread 0 spins (ld.acquire.gpu), then __syncthreads
+        if (!sub_k)
+            dv2_fold<TILEBLOCKS_M, FRAGS_N_PER_WARP, c_fp32>
+                (frag_c, ws_slots, slot_floats, compact, b_top, blockIdx.x, tiles_kn, num_slices, t);
+        if (threadIdx.x == 0) *lock = 0;   // every producer of this column has arrived
+        epilogue();
+    }
+}
