+// latchain r1 (EXL3_LC_GDN_RR=1): cuda_recurrent_gated_delta_rule_kernel_128 (per-head decay, no
+// CHANNELWISE) with the same thread layout, the same per-token arithmetic and the same stores,
+// minus two memory round trips per token:
+//   * the recurrent state is carried in registers from one token to the next. The served kernel
+//     re-reads it twice per token (the kv_mem dot, then the update) from the slot/history buffer it
+//     wrote at the previous token; each thread reads and writes only its own 32 state elements, so
+//     the value it reads back is exactly the value it stored, rounded by store_state. The register
+//     copy is rounded the same way (lc_state_reload), so every read sees the same bits;
+//   * token s + 1's q/k/v/g/beta are loaded (as raw bf16/fp32) while token s computes, and the
+//     token's v/g/beta are no longer loaded behind the dot-1 barrier.
+// Every expression that produces a stored or output value is textually the served one (same
+// operand order, same fp contraction opportunities), and the stores (history slots, final state,
+// output) are the served ones in the served order per thread. Graph parameters: identical
+// signature, so the state (3) and slots (12) patch sites are unchanged.
+__device__ __forceinline__ float lc_state_reload(const float*, float x)
+{
+    return x;
+}
+
+__device__ __forceinline__ float lc_state_reload(const bfloat16*, float x)
+{
+    return __bfloat162float(__float2bfloat16_rn(x));
