+    moe_coop_smem_optin(ka.kernel, ka.smem);
+    moe_coop_smem_optin(kb.kernel, kb.smem);
+    const int grid_a = moe_coop_v2_grid(ka, slots * nproj * (p.I / (wide_a ? 128 : MOE_COOP_COLS)), slots, device);
+    const int grid_b = moe_coop_v2_grid(kb, slots * (p.Ho / 128), slots, device);
+    void* args[] = { (void*) &p, (void*) &a2 };
+    const unsigned int head_ns = moe_coop_r3_head_ns();
+    if (head_ns) exl3_moe_coop_r2_head_kernel<<<1, 32, 0, stream>>>(head_ns);
+    cuda_check(cudaLaunchKernel(ka.kernel, dim3(grid_a), dim3(MOE_COOP_THREADS), args, ka.smem, stream));
+    if (wait_before_b) cuda_check(cudaStreamWaitEvent(stream, wait_before_b, 0));
+    cuda_check(cudaLaunchKernel(kb.kernel, dim3(grid_b), dim3(MOE_COOP_THREADS), args, kb.smem, stream));
+    cuda_check(cudaPeekAtLastError());
+    return true;
+}
