+    def _maybe_log(self):
+        if self.log_secs <= 0:
+            return
+        now = time.monotonic()
+        if now - self._last_log < self.log_secs:
+            return
+        self._last_log = now
+        m = self.metrics
+        snap = (m["page_writes"], m["checkpoint_writes"], m["restored_pages"], m["restored_checkpoints"],
