+++ b/exllamav3/exllamav3_ext/quant/exl3_gemm_v2_kernel.cuh
@@ -0,0 +1,194 @@
+#pragma once
+
+// densegemm r1: twins of exl3_gemm_kernel / exl3_mgemm_kernel (exl3_gemm_kernel.cuh) built on
+// exl3_gemm_kernel_inner_v2 (see the header of exl3_gemm_inner_v2.cuh for what changes and why the
+// output is bitwise identical). Same arguments as the served kernels plus one trailing pointer
+// (the partial-sum workspace), so graph parameter indices are unchanged. Launched only for:
+//   exl3_gemm_v2_kernel:  size_m <= TILESIZE_M, suh / svh / A_had present (dense EXL3 linears)
+//   exl3_mgemm_v2_kernel: dense mode only (no indices, weights or range filter, num_tokens 1),
+//                         size_m <= TILESIZE_M
+// with the grid the served kernel would get (autotuned config), which fixes the k partition.
+//
+// Barriers vs the served kernels:
+//   gemm:  input Hadamard + grid.sync (unchanged); the trailing grid.sync after the last 16-row
+//          chunk (a leftover of a commented-out epilogue) is gone.
+//   mgemm: sliced mode keeps the input Hadamard + grid.sync but drops the group barrier that
+//          followed it; per-matrix mode keeps its per-matrix Hadamard + group barrier. The
+//          per-chunk group barrier and the separate output-Hadamard pass are gone (the finalizing
+//          CTA transforms its own tile); a group barrier separates consecutive matrices of one
+//          z-group only when there is a next matrix (lock and slot reuse).
+
+#include "exl3_kernel_map.cuh"
+#include "hadamard_inner.cuh"
+#include "exl3_gemm_inner_v2.cuh"
+#include "exl3_devctx.cuh"
+
+template<EXL3_GEMM_T_ARGS>
+__global__ __launch_bounds__(EXL3_GEMM_BASE_THREADS * TILESIZE_K / 16)
+void exl3_gemm_v2_kernel(EXL3_GEMM_ARGS, float* __restrict__ ws)
+{
+    static_assert(!half_k, "densegemm V2 twins: integer bitrates only (rebase-dev-r2)");
+    auto grid = cg::this_grid();
+
+    auto pre_a = [&] () DGV2_AI
+    {
+        int total_warps = size_m * size_k / 128;
+        int warps_grid = gridDim.x * blockDim.x / 32;
+        int this_warp = threadIdx.x / 32 + blockDim.x / 32 * blockIdx.x;
+
+        for(; this_warp < total_warps; this_warp += warps_grid)
+            had_hf_r_128_inner<true, false>
+            (
+                A + this_warp * 128,
+                A_had + this_warp * 128,
+                suh + (this_warp * 128) % size_k,
+                0.088388347648f  // 1/sqrt(128)
+            );
+
+        grid.sync();
+    };
+
+    exl3_gemm_kernel_inner_v2
+    <bits, half_k, c_fp32, cb, TILESIZE_M, TILESIZE_K, TILESIZE_N, SH_STAGES, FRAG_STAGES, 0>
+    (A_had, B, C, size_m, size_k, size_n, locks, svh, 0, ws, pre_a);
+}
+
+template<EXL3_GEMM_T_ARGS>
+__global__ __launch_bounds__(EXL3_GEMM_BASE_THREADS * TILESIZE_K / 16)
+void exl3_mgemm_v2_kernel(EXL3_MGEMM_ARGS, float* __restrict__ ws)
+{
+    static_assert(!half_k, "densegemm V2 twins: integer bitrates only (rebase-dev-r2)");
+    int bszm = MAX(bszm_in, bszm_out);
+    auto grid = cg::this_grid();
+
+    #if defined(__CUDA_ARCH__) && (__CUDA_ARCH__ > 890)
+        int* barrier_counters_sense = locks + BARRIER_LOCKS_OFFSET;
+    #endif
+
+    auto group_sync = [&] () DGV2_AI
+    {
+        #if defined(__CUDA_ARCH__) && (__CUDA_ARCH__ > 890)
+            group_barrier(blockIdx.z, gridDim.x, barrier_counters_sense);
+        #else
+            grid.sync();
+        #endif
+    };
+
+    const int slot_floats = exl3_dense_v2_slot_floats(TILESIZE_M, TILESIZE_N, size_m);
+    float* ws_z = ws + (size_t) blockIdx.z * gridDim.x * slot_floats;
+
+    for (int i = 0; i < bszm; i += gridDim.z)
+    {
+        const bool first_iter = i == 0;
+        int j = i + blockIdx.z;
+        int mat_index = -1;
+        const uint16_t* B = nullptr;
+        if (j >= bszm) j = -1;
+        else
+        {
+            mat_index = j;
+            B = B_list[mat_index];
+        }
+
+        // Input stage of this matrix (called once by every thread, from inside the inner loop's
+        // prologue when there is a matrix, directly otherwise)
+        auto pre_a = [&] () DGV2_AI
+        {
+            if (had_src_list)
+            {
+                if (first_iter)
+                {
+                    // Sliced mode: one input transform per source, every block cooperating (served code)
+                    int total_warps = size_m * size_k / 128;
+                    int warps_grid = gridDim.x * gridDim.z * blockDim.x / 32;
+                    int this_warp = threadIdx.x / 32 + blockDim.x / 32 * (blockIdx.x + gridDim.x * blockIdx.z);
+                    for (; this_warp < num_had_src * total_warps; this_warp += warps_grid)
+                    {
+                        int src = this_warp / total_warps;
+                        int w = this_warp - src * total_warps;
+                        had_hf_r_128_inner<true, false>
+                        (
+                            A + w * 128,
+                            A_had + src * size_m * size_k + w * 128,
+                            suh_list[src] + (w * 128) % size_k,
+                            0.088388347648f  // 1/sqrt(128)
+                        );
+                    }
+                    grid.sync();
+                }
+                else
+                {
+                    // Previous matrix of this z-group done everywhere (lock and slot reuse)
+                    group_sync();
+                }
+            }
+            else
+            {
+                if (B)
+                {
+                    int total_warps = size_m * size_k / 128;
+                    int warps_grid = gridDim.x * blockDim.x / 32;
+                    int this_warp = threadIdx.x / 32 + blockDim.x / 32 * blockIdx.x;
+
+                    const half* suh = suh_list[mat_index];
+                    const half* A_ = bszm_in == 1 ? A : A + j * size_m * size_k;
+                    half* A_had_ = A_had + j * size_m * size_k;
+
+                    for(; this_warp < total_warps; this_warp += warps_grid)
+                        had_hf_r_128_inner<true, false>
+                        (
+                            A_ + this_warp * 128,
+                            A_had_ + this_warp * 128,
+                            suh + (this_warp * 128) % size_k,
+                            0.088388347648f  // 1/sqrt(128)
+                        );
+                }
+                group_sync();
+            }
+        };
+
+        if (!B)
+        {
+            pre_a();
+            continue;
+        }
+
+        int n_j = size_n_list ? size_n_list[mat_index] : size_n;
+        int n_stride_j = n_stride_list ? n_stride_list[mat_index] : n_j;
+        const half* A_ = A_had + (had_src_list ? had_src_list[mat_index] : j) * size_m * size_k;
+        void* C_;
+        if (C_list) C_ = C_list[mat_index];
+        else if constexpr (c_fp32) C_ = (void*) (((float*) C) + j * size_m * size_n);
+        else                       C_ = (void*) (((half*) C) + j * size_m * size_n);
+
+        int lock_offs = blockIdx.z * size_n / 128;
+
+        exl3_gemm_kernel_inner_v2
+        <bits, half_k, c_fp32, cb, TILESIZE_M, TILESIZE_K, TILESIZE_N, SH_STAGES, FRAG_STAGES, 1>
+        (A_, B, C_, size_m, size_k, n_j, locks + lock_offs, svh_list[mat_index], n_stride_j, ws_z, pre_a);
+    }
+}
+
+// Shapes: the served ones (exl3_kernel_map.cuh) and the 32-row variants of shapes 2 and 3
+#define EXL3_GEMM_V2_SHAPE_2_M32     32,     32,    128,     4,     3
+#define EXL3_GEMM_V2_SHAPE_3_M32     32,     32,    256,     4,     3
+
+// Instance table per (kernel, c_fp32): index = shape_idx (1..4) for 16 rows, 5 / 6 = shapes 2 / 3 at 32 rows.
+// rebase-dev-r2: EXL3_GEMM_T_ARGS gained half_k after bits (upstream 07b8a2e); the twins are integer-K only
+#define EXL3_GEMM_V2_INSTANCES(_bits, _c_fp32, _cb) \
+    nullptr, \
+    (void*) exl3_gemm_v2_kernel<_bits, false, _c_fp32, _cb, EXL3_GEMM_SHAPE_1>, \
+    (void*) exl3_gemm_v2_kernel<_bits, false, _c_fp32, _cb, EXL3_GEMM_SHAPE_2>, \
+    (void*) exl3_gemm_v2_kernel<_bits, false, _c_fp32, _cb, EXL3_GEMM_SHAPE_3>, \
+    (void*) exl3_gemm_v2_kernel<_bits, false, _c_fp32, _cb, EXL3_GEMM_SHAPE_4>, \
+    (void*) exl3_gemm_v2_kernel<_bits, false, _c_fp32, _cb, EXL3_GEMM_V2_SHAPE_2_M32>, \
+    (void*) exl3_gemm_v2_kernel<_bits, false, _c_fp32, _cb, EXL3_GEMM_V2_SHAPE_3_M32>
+
+#define EXL3_MGEMM_V2_INSTANCES(_bits, _c_fp32, _cb) \
+    nullptr, \
+    (void*) exl3_mgemm_v2_kernel<_bits, false, _c_fp32, _cb, EXL3_GEMM_SHAPE_1>, \
+    (void*) exl3_mgemm_v2_kernel<_bits, false, _c_fp32, _cb, EXL3_GEMM_SHAPE_2>, \
+    (void*) exl3_mgemm_v2_kernel<_bits, false, _c_fp32, _cb, EXL3_GEMM_SHAPE_3>, \
+    (void*) exl3_mgemm_v2_kernel<_bits, false, _c_fp32, _cb, EXL3_GEMM_SHAPE_4>, \
+    (void*) exl3_mgemm_v2_kernel<_bits, false, _c_fp32, _cb, EXL3_GEMM_V2_SHAPE_2_M32>, \
+    (void*) exl3_mgemm_v2_kernel<_bits, false, _c_fp32, _cb, EXL3_GEMM_V2_SHAPE_3_M32>
