diff --git a/exllamav3/exllamav3_ext/quant/exl3_dense_v2.cu b/exllamav3/exllamav3_ext/quant/exl3_dense_v2.cu
new file mode 100644
index 0000000..02a8e28
--- /dev/null
+++ b/exllamav3/exllamav3_ext/quant/exl3_dense_v2.cu
@@ -0,0 +1,366 @@
+#include <cuda_fp16.h>
+#include <c10/cuda/CUDAGuard.h>
+#include <ATen/cuda/CUDAContext.h>
+#include "../util.h"
+#include "../util.cuh"
+#include "exl3_dense_v2.cuh"
+#include "exl3_kernel_map.cuh"
+#include "exl3_devctx.cuh"
+#include "coop_autotune.cuh"
+#include "exl3_gemm_inner_v2.cuh"   // SMEM_MAX, exl3_dense_v2_slot_floats
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <map>
+#include <mutex>
+#include <set>
+
+// densegemm r1 host side, see exl3_dense_v2.cuh
+
+// Instance tables (comp_units/exl3_dense_v2_inst_*.cu). gemm / mgemm: [c_fp32][idx], idx 1..4 =
+// served shape index at 16 rows, 5 / 6 = shapes 2 / 3 at 32 rows. gemv: [c_fp32 * 4 + mmode * 2 + cfg]
+extern void* exl3_gemm_v2_tab_k4_cb2[2][7];
+extern void* exl3_mgemm_v2_tab_k4_cb2[2][7];
+extern void* exl3_gemv_v2_tab_k4_cb2[8];
+
+static const int v2_tilesize_k[] = {EXL3_GEMM_TILESIZE_K};
+static const int v2_tilesize_n[] = {EXL3_GEMM_TILESIZE_N};
+
+// Partial-sum slots per device (+ the gemv arrival counters behind them). 4 MiB covers every served
+// dense K4 shape at 4 and 16 rows (the largest is the GDN in_proj: 160 CTAs x 16 KiB); 8 MiB when
+// EXL3_DENSE_ROWS32 is on (32-row slots). Allocated at the first dense gemm / mgemm call of any shape
+// once a flag is on (in practice the first prefill chunk, which is always eager), so that graphs
+// captured later find it; never during graph capture, never when both flags are off
+#define DENSE_V2_WS_BYTES        ((size_t) 4 << 20)
+#define DENSE_V2_WS_BYTES_ROWS32 ((size_t) 8 << 20)
+// stack-r3 lcguard: side-branch slot region, allocated behind the main slots only when a gemm / mgemm twin can run
+// (EXL3_DENSE_V2 = 1 | 2 or EXL3_DENSE_ROWS32) AND latchain's QSA fork is requested (EXL3_LC_QSA_FORK=1, read as a
+// plain env string: no latchain symbol). Mode 3 (gemv twin only) or no fork: 0 bytes, the r1/r2 layout unchanged
+// rows32 r4: 4 MiB when EXL3_DENSE_ROWS32 is on. The side call is index_qk (k 2560, n 640: tag 2, TILESIZE_N 128);
+// at 17-32 rows its twin uses 32-row slots, 32 x 128 x 4 B = 16 KiB per CTA, so 2 MiB holds only 128 CTAs and the
+// autotuner may pick up to 170 (min(tiles 400, SMs 170)): 2.7 MiB. 4 MiB holds 256. Without rows32: 2 MiB, unchanged
+#define DENSE_V2_WS_SIDE_BYTES   (dense_v2_rows32() ? ((size_t) 4 << 20) : ((size_t) 2 << 20))
+
+// --------------------------------------------------------------------------------------------- modes
+
+static std::atomic<int> g_mode{-1};
+static std::atomic<int> g_rows32{-1};
+static std::atomic<int64_t> g_count_gemm{0};
+static std::atomic<int64_t> g_count_gemv{0};
+static std::atomic<int64_t> g_count_side_twin{0};
+static std::atomic<int64_t> g_count_side_served{0};
+
+static int parse_flag(const char* name, int max_value)
+{
+    const char* e = std::getenv(name);
+    if (!e || !e[0]) return 0;
+    TORCH_CHECK(std::strlen(e) == 1 && e[0] >= '0' && e[0] <= '0' + max_value,
+                name, " must be one of 0..", max_value, " (got '", e, "')");
+    return e[0] - '0';
+}
+
+int dense_v2_mode()
+{
+    int m = g_mode.load(std::memory_order_relaxed);
+    if (m < 0)
+    {
+        m = parse_flag("EXL3_DENSE_V2", 3);
+        g_mode.store(m, std::memory_order_relaxed);
+    }
+    return m;
+}
+
+bool dense_v2_rows32()
+{
+    int r = g_rows32.load(std::memory_order_relaxed);
+    if (r < 0)
+    {
+        r = parse_flag("EXL3_DENSE_ROWS32", 1);
+        g_rows32.store(r, std::memory_order_relaxed);
+    }
+    return r == 1;
+}
+
+void dense_v2_set_mode(int mode, int rows32)
+{
+    TORCH_CHECK(mode >= -1 && mode <= 3, "dense_v2_set_mode: mode must be -1..3");
+    TORCH_CHECK(rows32 >= -1 && rows32 <= 1, "dense_v2_set_mode: rows32 must be -1..1");
+    if (mode >= 0) g_mode.store(mode, std::memory_order_relaxed);
+    if (rows32 >= 0) g_rows32.store(rows32, std::memory_order_relaxed);
+}
+
+std::tuple<int, int> dense_v2_modes()
+{
+    return std::make_tuple(dense_v2_mode(), dense_v2_rows32() ? 1 : 0);
+}
+
+std::tuple<int64_t, int64_t> dense_v2_launch_counts()
+{
+    return std::make_tuple(g_count_gemm.load(), g_count_gemv.load());
+}
+
+void dense_v2_reset_counts()
+{
+    g_count_gemm.store(0);
+    g_count_gemv.store(0);
+    g_count_side_twin.store(0);
+    g_count_side_served.store(0);
+}
+
+std::tuple<int64_t, int64_t> dense_v2_lc_side_counts()
+{
+    return std::make_tuple(g_count_side_twin.load(), g_count_side_served.load());
+}
+
+// stack-r3 lcguard (exl3_dense_v2.cuh): true = this call runs on latchain's QSA side branch and must use the side
+// scratch. Logged once per device, so a served container log shows that the side path was taken.
+static bool lc_side_branch(void** kernel_args, int device)
+{
+    if (!dense_v2_on_side_branch(kernel_args, DevCtx::instance().get_locks(device))) return false;
+    static std::atomic<bool> logged[MAX_DEVICES];
+    if (!logged[device].exchange(true))
+        fprintf(stderr, "densegemm lcguard: device %d: dense calls on the QSA side branch use the side scratch (hctr upper half, side slots)\n", device);
+    return true;
+}
+
+static bool lc_fork_requested()
+{
+    const char* e = std::getenv("EXL3_LC_QSA_FORK");
+    return e && !std::strcmp(e, "1");
+}
+
+// --------------------------------------------------------------------------------------------- workspace
+
+struct DenseV2Ws
+{
+    float* slots = nullptr;
+    size_t slot_bytes = 0;
+    float* side_slots = nullptr;    // stack-r3 lcguard: latchain side-branch gemm twins (0 bytes unless requested)
+    size_t side_bytes = 0;
+    int* hctr = nullptr;
+    bool tried = false;
+};
+
+static DenseV2Ws g_ws[MAX_DEVICES];
+static std::mutex g_ws_mtx;
+
+static bool ws_ready(int device, cudaStream_t stream)
+{
+    DenseV2Ws& w = g_ws[device];
+    if (w.slots) return true;
+    std::lock_guard<std::mutex> lock(g_ws_mtx);
+    if (w.slots) return true;
+    if (w.tried) return false;
+
+    // Never allocate while this stream is being captured: the next eager call will
+    cudaStreamCaptureStatus status = cudaStreamCaptureStatusNone;
+    if (cudaStreamIsCapturing(stream, &status) != cudaSuccess || status != cudaStreamCaptureStatusNone)
+    {
+        (void) cudaGetLastError();
+        return false;
+    }
+    w.tried = true;
+
+    size_t slot_bytes = dense_v2_rows32() ? DENSE_V2_WS_BYTES_ROWS32 : DENSE_V2_WS_BYTES;
+    size_t side_bytes = ((dense_v2_gemm_on() || dense_v2_rows32()) && lc_fork_requested()) ? DENSE_V2_WS_SIDE_BYTES : 0;
+    size_t hctr_bytes = (size_t) DENSE_V2_GEMV_MAX_HBLOCKS * sizeof(int);
+
+    // Relaxed capture mode around the allocation, in case another stream of this thread is capturing
+    cudaStreamCaptureMode mode = cudaStreamCaptureModeRelaxed;
+    cudaThreadExchangeStreamCaptureMode(&mode);
+    void* p = nullptr;
+    cudaError_t e = cudaMalloc(&p, slot_bytes + side_bytes + hctr_bytes);
+    // Zeroed and complete before any stream can use it (the first caller may be a side stream)
+    if (e == cudaSuccess) e = cudaMemsetAsync((char*) p + slot_bytes + side_bytes, 0, hctr_bytes, stream);
+    if (e == cudaSuccess) e = cudaStreamSynchronize(stream);
+    cudaThreadExchangeStreamCaptureMode(&mode);
+
+    if (e != cudaSuccess)
+    {
+        (void) cudaGetLastError();
+        if (p) cudaFree(p);
+        TORCH_WARN("densegemm r1: workspace allocation failed on device ", device, " (", cudaGetErrorString(e),
+                   "); the served dense kernels run instead");
+        return false;
+    }
+    w.slots = (float*) p;
+    w.slot_bytes = slot_bytes;
+    w.side_slots = side_bytes ? (float*) ((char*) p + slot_bytes) : nullptr;
+    w.side_bytes = side_bytes;
+    w.hctr = (int*) ((char*) p + slot_bytes + side_bytes);
+    return true;
+}
+
+static std::set<std::pair<int, void*>> g_attr_set;
+static std::mutex g_attr_mtx;
+
+static void ensure_smem_attr(void* kernel, int device)
+{
+    std::lock_guard<std::mutex> lock(g_attr_mtx);
+    auto key = std::make_pair(device, kernel);
+    if (g_attr_set.find(key) != g_attr_set.end()) return;
+    cuda_check(cudaFuncSetAttribute(kernel, cudaFuncAttributeMaxDynamicSharedMemorySize, SMEM_MAX));
+    g_attr_set.insert(key);
+}
+
+static std::map<std::pair<int, void*>, int> g_occ_cache;
+
+static int occupancy(void* kernel, int block_dim, int device)
+{
+    std::lock_guard<std::mutex> lock(g_attr_mtx);
+    auto key = std::make_pair(device, kernel);
+    auto it = g_occ_cache.find(key);
+    if (it != g_occ_cache.end()) return it->second;
+    int blocks_per_sm = 0;
+    cuda_check(cudaOccupancyMaxActiveBlocksPerMultiprocessor(&blocks_per_sm, kernel, block_dim, 0));
+    g_occ_cache[key] = blocks_per_sm;
+    return blocks_per_sm;
+}
+
+// --------------------------------------------------------------------------------------------- launches
+
+// Resolve the served launch config of an autotuned gemm / mgemm call and the V2 twin for it
+static void* resolve_v2
+(
+    void* const tab[2][7],
+    uint64_t autotune_key,
+    int size_m, int size_k, int size_n, int K, int cb, bool c_fp32,
+    CoopAutotuneLaunch* cfg, int* tm, int* tn
+)
+{
+    if (K != 4 || cb != 2) return nullptr;
+    if (size_m < 1 || size_m > 32) return nullptr;
+    bool rows32 = size_m > 16;
+    if (rows32 ? !dense_v2_rows32() : !dense_v2_gemm_on()) return nullptr;
+
+    if (!CoopKernelAutotuner::peek(autotune_key, cfg)) return nullptr;   // first call of a shape: served path tunes
+    int tag = cfg->tag;
+    if (tag < 1 || tag > EXL3_GEMM_NUM_SHAPES) return nullptr;
+    int idx = tag;
+    if (rows32)
+    {
+        if (tag == 2) idx = 5;
+        else if (tag == 3) idx = 6;
+        else return nullptr;
+    }
+    *tm = rows32 ? 32 : 16;
+    *tn = v2_tilesize_n[tag];
+    if (size_k % v2_tilesize_k[tag] || size_n % v2_tilesize_n[tag]) return nullptr;
+    if (cfg->num_sms < 1 || cfg->concurrency < 1) return nullptr;
+    // The kernel's partition arithmetic (tiles * blockIdx / grid) must not overflow 32 bits, so that the
+    // V2 owner / tile_beg helpers (64-bit) agree with it
+    int64_t tiles = (int64_t) (size_k / v2_tilesize_k[tag]) * (size_n / v2_tilesize_n[tag]);
+    if (tiles * (cfg->num_sms + 1) >= ((int64_t) 1 << 31)) return nullptr;
+    return tab[c_fp32 ? 1 : 0][idx];
+}
+
+void* dense_v2_launch_gemm
+(
+    void** kernel_args,
+    uint64_t autotune_key,
+    int size_m, int size_k, int size_n, int K, int cb, bool c_fp32,
+    int device, cudaStream_t stream, int* out_tag
+)
+{
+    bool side = lc_side_branch(kernel_args, device);    // stack-r3 lcguard
+    (void) ws_ready(device, stream);    // any shape, so the workspace exists before decode graphs are captured
+    CoopAutotuneLaunch cfg;
+    int tm, tn;
+    void* kernel = resolve_v2(exl3_gemm_v2_tab_k4_cb2, autotune_key, size_m, size_k, size_n, K, cb, c_fp32, &cfg, &tm, &tn);
+    if (!kernel || cfg.concurrency != 1) return nullptr;
+    int tiles = size_k / v2_tilesize_k[cfg.tag] * size_n / tn;
+    if (cfg.num_sms > tiles) return nullptr;
+
+    size_t need = (size_t) cfg.num_sms * exl3_dense_v2_slot_floats(tm, tn, size_m) * sizeof(float);
+    if (!ws_ready(device, stream)) return nullptr;
+    if (side && need > g_ws[device].side_bytes)
+    {
+        g_count_side_served.fetch_add(1, std::memory_order_relaxed);
+        // rows32 r4: say so once per device (the gates read container / harness logs, not the counters)
+        static std::atomic<bool> logged_served[MAX_DEVICES];
+        if (!logged_served[device].exchange(true))
+            fprintf(stderr, "densegemm lcguard: device %d: side call m %d k %d n %d needs %zu B of side slots (%d CTAs), "
+                    "region %zu B: served kernel\n", device, size_m, size_k, size_n, need, cfg.num_sms,
+                    g_ws[device].side_bytes);
+        return nullptr;                 // no side region (or too small): the served kernel, as without densegemm
+    }
+    if (!side && need > g_ws[device].slot_bytes) return nullptr;
+    float* ws = side ? g_ws[device].side_slots : g_ws[device].slots;
+
+    void* args[11];
+    for (int i = 0; i < 10; ++i) args[i] = kernel_args[i];
+    args[10] = (void*) &ws;
+
+    ensure_smem_attr(kernel, device);
+    cuda_check(cudaLaunchCooperativeKernel(kernel, dim3(cfg.num_sms, 1, 1), cfg.block_dim, args, SMEM_MAX, stream));
+    g_count_gemm.fetch_add(1, std::memory_order_relaxed);
+    if (side) g_count_side_twin.fetch_add(1, std::memory_order_relaxed);
+    *out_tag = cfg.tag;
+    return kernel;
+}
+
+void* dense_v2_launch_mgemm
+(
+    void** kernel_args,
+    uint64_t autotune_key,
+    int size_m, int size_k, int size_n, int K, int cb, bool c_fp32,
+    int device, cudaStream_t stream, int* out_tag
+)
+{
+    (void) ws_ready(device, stream);    // any shape, so the workspace exists before decode graphs are captured
+    CoopAutotuneLaunch cfg;
+    int tm, tn;
+    void* kernel = resolve_v2(exl3_mgemm_v2_tab_k4_cb2, autotune_key, size_m, size_k, size_n, K, cb, c_fp32, &cfg, &tm, &tn);
+    if (!kernel) return nullptr;
+
+    size_t need = (size_t) cfg.num_sms * cfg.concurrency * exl3_dense_v2_slot_floats(tm, tn, size_m) * sizeof(float);
+    if (!ws_ready(device, stream) || need > g_ws[device].slot_bytes) return nullptr;
+    float* ws = g_ws[device].slots;
+
+    void* args[23];
+    for (int i = 0; i < 22; ++i) args[i] = kernel_args[i];
+    args[22] = (void*) &ws;
+
+    ensure_smem_attr(kernel, device);
+    cuda_check(cudaLaunchCooperativeKernel(kernel, dim3(cfg.num_sms, 1, cfg.concurrency), cfg.block_dim, args, SMEM_MAX, stream));
+    g_count_gemm.fetch_add(1, std::memory_order_relaxed);
+    *out_tag = cfg.tag;
+    return kernel;
+}
+
+void* dense_v2_launch_gemv
+(
+    void** kernel_args,
+    int size_m, int size_k, int size_n, int K, int cb, bool c_fp32, int mmode, int cfg,
+    int block_dim, int cols, int device, cudaStream_t stream
+)
+{
+    bool side = lc_side_branch(kernel_args, device);    // stack-r3 lcguard
+    if (!dense_v2_gemv_on() || K != 4 || cb != 2) return nullptr;
+    if (mmode < 0 || mmode > 1 || cfg < 0 || cfg > 1) return nullptr;
+    // stack-r3 lcguard: each branch owns half of the counters (main [0, H/2), side [H/2, H)); the largest served
+    // dense K4 gemv call needs 20 blocks (size_n 2560)
+    if (size_n % 128 || size_n / 128 > DENSE_V2_GEMV_MAX_HBLOCKS / 2) return nullptr;
+    const uint16_t* B_ptr = *((const uint16_t* const*) kernel_args[1]);
+    if (((uintptr_t) B_ptr) & 15) return nullptr;   // 16-byte cp.async of the weight rows
+
+    void* kernel = exl3_gemv_v2_tab_k4_cb2[(c_fp32 ? 4 : 0) + mmode * 2 + cfg];
+    if (!kernel) return nullptr;
+    if (!ws_ready(device, stream)) return nullptr;
+
+    int num_sms = DevCtx::instance().get_num_sms(device);
+    int max_blocks = occupancy(kernel, block_dim, device) * num_sms;
+    int grid = MIN(size_n / cols, max_blocks);
+    if (grid < 1) return nullptr;
+
+    int* hctr = g_ws[device].hctr + (side ? DENSE_V2_GEMV_MAX_HBLOCKS / 2 : 0);
+    void* args[11];
+    for (int i = 0; i < 10; ++i) args[i] = kernel_args[i];
+    args[10] = (void*) &hctr;
+
+    cuda_check(cudaLaunchCooperativeKernel(kernel, dim3(grid), dim3(block_dim), args, 0, stream));
+    g_count_gemv.fetch_add(1, std::memory_order_relaxed);
+    if (side) g_count_side_twin.fetch_add(1, std::memory_order_relaxed);
+    return kernel;
+}
