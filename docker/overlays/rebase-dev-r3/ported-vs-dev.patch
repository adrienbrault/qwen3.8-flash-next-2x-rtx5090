+// R2 exact-order SIMT mixer. Three launches trade one small state kernel for
+// eliminating r1's per-rank-tile RMS, virtual warps and stream-staging barriers.
+constexpr int GR_V2_H = 4;
+constexpr int GR_V2_WARP = 32;
