+        if self._scan_thread is not None:
+            self._scan_thread.join(timeout = 30)
+        for d, ev in self._idle_inflight:
+            ev.synchronize()
+        self._idle_inflight.clear()
+        if self._open_batch is not None:
+            self._open_batch.finish()
