+        const int smem = smem_v3<K>(); \
+        if (wide) switch (cb) \
+        { \
+            case 0: return { (void*) exl3_moe_coop_v3_a_kernel<K, 0, true>, smem }; \
+            case 1: return { (void*) exl3_moe_coop_v3_a_kernel<K, 1, true>, smem }; \
+            default: return { (void*) exl3_moe_coop_v3_a_kernel<K, 2, true>, smem }; \
+        } \
+        switch (cb) \
+        { \
+            case 0: return { (void*) exl3_moe_coop_v3_a_kernel<K, 0, false>, smem }; \
+            case 1: return { (void*) exl3_moe_coop_v3_a_kernel<K, 1, false>, smem }; \
+            default: return { (void*) exl3_moe_coop_v3_a_kernel<K, 2, false>, smem }; \
+        } \
+    } \
+    MoeCoopKernel exl3_moe_coop_v3_b_k##K(int cb, bool wide, bool merge) \
+    { \
+        using namespace exl3_moe_coop_v3_ns; \
+        const int smem = smem_v3<K>(); \
+        if (wide) switch (cb) \
+        { \
+            case 0: return { (void*) exl3_moe_coop_v3_b_kernel<K, 0, true, false>, smem }; \
+            case 1: return { (void*) exl3_moe_coop_v3_b_kernel<K, 1, true, false>, smem }; \
+            default: return { (void*) exl3_moe_coop_v3_b_kernel<K, 2, true, false>, smem }; \
+        } \
+        if (merge) switch (cb) \
+        { \
+            case 0: return { (void*) exl3_moe_coop_v3_b_kernel<K, 0, false, true>, smem }; \
+            case 1: return { (void*) exl3_moe_coop_v3_b_kernel<K, 1, false, true>, smem }; \
+            default: return { (void*) exl3_moe_coop_v3_b_kernel<K, 2, false, true>, smem }; \
+        } \
+        switch (cb) \
+        { \
+            case 0: return { (void*) exl3_moe_coop_v3_b_kernel<K, 0, false, false>, smem }; \
+            case 1: return { (void*) exl3_moe_coop_v3_b_kernel<K, 1, false, false>, smem }; \
+            default: return { (void*) exl3_moe_coop_v3_b_kernel<K, 2, false, false>, smem }; \
+        } \
+    }
+
+// moefast r2 (EXL3_MOE_COOP_V3=3, exl3_moe_coop_r2_kernel.cuh): K = 2, 3, 4, instantiated next to V3.
+// smem is left 0: the launcher sizes kernel A's staging (Hi) and kernel B's (I) per launch shape.
+#include "../exl3_moe_coop_r2_kernel.cuh"
+
+#define EXL3_MOE_COOP_R2_INST_DECL(K) \
+    MoeCoopKernel exl3_moe_coop_r2_a_k##K(int cb, bool wide); \
+    MoeCoopKernel exl3_moe_coop_r2_b_k##K(int cb, bool wide);
+EXL3_MOE_COOP_R2_INST_DECL(2)
+EXL3_MOE_COOP_R2_INST_DECL(3)
+EXL3_MOE_COOP_R2_INST_DECL(4)
+
+#define EXL3_MOE_COOP_R2_INST_DEF(K) \
+    MoeCoopKernel exl3_moe_coop_r2_a_k##K(int cb, bool wide) \
+    { \
+        using namespace exl3_moe_coop_r2_ns; \
+        if (wide) switch (cb) \
+        { \
+            case 0: return { (void*) exl3_moe_coop_r2_a_kernel<K, 0, true>, 0 }; \
+            case 1: return { (void*) exl3_moe_coop_r2_a_kernel<K, 1, true>, 0 }; \
+            default: return { (void*) exl3_moe_coop_r2_a_kernel<K, 2, true>, 0 }; \
+        } \
+        switch (cb) \
+        { \
+            case 0: return { (void*) exl3_moe_coop_r2_a_kernel<K, 0, false>, 0 }; \
+            case 1: return { (void*) exl3_moe_coop_r2_a_kernel<K, 1, false>, 0 }; \
+            default: return { (void*) exl3_moe_coop_r2_a_kernel<K, 2, false>, 0 }; \
+        } \
+    } \
+    MoeCoopKernel exl3_moe_coop_r2_b_k##K(int cb, bool wide) \
+    { \
+        using namespace exl3_moe_coop_r2_ns; \
+        if (wide) switch (cb) \
+        { \
+            case 0: return { (void*) exl3_moe_coop_r2_b_kernel<K, 0, true>, 0 }; \
+            case 1: return { (void*) exl3_moe_coop_r2_b_kernel<K, 1, true>, 0 }; \
+            default: return { (void*) exl3_moe_coop_r2_b_kernel<K, 2, true>, 0 }; \
+        } \
+        switch (cb) \
+        { \
+            case 0: return { (void*) exl3_moe_coop_r2_b_kernel<K, 0, false>, 0 }; \
+            case 1: return { (void*) exl3_moe_coop_r2_b_kernel<K, 1, false>, 0 }; \
+            default: return { (void*) exl3_moe_coop_r2_b_kernel<K, 2, false>, 0 }; \
+        } \
     }
