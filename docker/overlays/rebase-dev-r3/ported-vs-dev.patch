+// moefast r3 diagnostic (EXL3_MOE_COOP_V3_HEAD=<ns>, read per launch, mode 3 only): one 32-thread block on the
+// current stream right before r2's kernel A that exits after <ns> nanoseconds of %globaltimer (1 = no spin, just a
+// launch). It stands in for r1's rotation kernel, whose ~3.6 us before kernel A was the window in which the
+// side-stream shared expert's cooperative GEMM got SMs (R703b nsys). No data is touched; unset/0 = not launched.
+namespace exl3_moe_coop_r2_ns {
+__global__ void exl3_moe_coop_r2_head_kernel(unsigned int ns)
+{
+    if (ns <= 1) return;
+    unsigned long long t0, t;
+    asm volatile("mov.u64 %0, %%globaltimer;" : "=l"(t0));
+    do { asm volatile("mov.u64 %0, %%globaltimer;" : "=l"(t)); } while (t - t0 < ns);
+}
