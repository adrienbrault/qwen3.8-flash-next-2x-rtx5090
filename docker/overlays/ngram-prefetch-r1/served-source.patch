+    def prefetch_ids(self, ids: torch.Tensor, params: dict):
+        """EXL3_NGRAM_PREFETCH2: stage the rows for the verify forward whose input ids the
+        generator has already assembled (batch_ids: (bsz, 1 + window) — the verify forward's
+        exact ids). The carried id context comes from the same recurrent state slots the
+        forward will read, so the history staged here is the one forward() will build; a set
+        that still does not match (state advanced between the call and the forward) is simply
+        not used. Timing only."""
+        from .ngram_embedding import PREFETCH2     # module constant, not an attribute (R559 try 3)
+        if not PREFETCH2:
+            return
+        ctx = self.ple_embedding.context_len
+        rsg = params.get("recurrent_states")
+        ids = self._prepare_ids(ids)
+        if rsg:
+            # Same lookup as _state_history, but from the slot handles the generator put in
+            # params (params["recurrent_slots"] is only created inside prepare_inputs, which
+            # has not run yet at this point). layer_instance defaults to 0 exactly as the
+            # forward's default path does; a layer_map with repeated PLE instances would read
+            # instance 0's carried context here — a mismatch only ever discards the set.
+            layer_instance = (self.layer_idx, params.get("layer_instance", 0))
+            rsl = rsg[0].cache.get_recurrent_layer(layer_instance)
+            _, id_state = rsl.get_state_tensors()
+            slots = [r.slot for r in rsg]
+            assert len(slots) == ids.shape[0]
+            prev_ids = torch.stack([id_state[s, :ctx] for s in slots])
+            history = torch.cat((prev_ids, ids), dim = 1)
+        else:
+            assert params.get("position", 0) == 0, \
+                "PLELayer requires recurrent states for forwards past position 0"
+            history = self._history(ids)
+        self.ple_embedding.prefetch_ids(history)
