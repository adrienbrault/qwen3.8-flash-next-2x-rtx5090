+            n = len(ts)
+            return {
+                "calls": n,
+                "mean_ms": 1000.0 * sum(ts) / n,
+                "p50_ms": 1000.0 * ts[n // 2],
+                "p90_ms": 1000.0 * ts[min(n - 1, (n * 9) // 10)],
+                "max_ms": 1000.0 * ts[-1],
+                "total_ms": 1000.0 * sum(ts),
